+					deadlineTimer = time.NewTimer(monotime.Until(deadline))
+					defer deadlineTimer.Stop()
+				} else {
+					deadlineTimer.Reset(monotime.Until(deadline))
+				}
+			}
+			if s.dataForWriting == nil || s.shutdownErr != nil || s.resetErr != nil {
+				break
+			}
+		}
