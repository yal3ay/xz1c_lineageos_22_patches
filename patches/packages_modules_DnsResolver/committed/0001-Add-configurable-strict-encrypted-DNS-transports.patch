+
+type Writer struct {
+	t *FileSeq
+}
+
+func (w *Writer) Close() error {
+	w.t.removeProducer()
+	return nil
+}
+
+func (w *Writer) RecordEvent(ev Event) {
+	w.t.record(time.Now(), ev)
+}
