+// A ReceiveStream is a unidirectional Receive Stream.
+type ReceiveStream struct {
+	mutex sync.Mutex
+
+	streamID protocol.StreamID
+
+	sender streamSender
+
+	frameQueue               *frameSorter
+	finalOffset              protocol.ByteCount
