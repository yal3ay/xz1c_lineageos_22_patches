--- /dev/null
+++ b/xz1c-engine/api.h
@@ -0,0 +1,11 @@
+// Copyright 2026 XZ1C contributors. Licensed under Apache-2.0.
+#pragma once
+#include <stdint.h>
+extern "C" {
+uint64_t xz1c_dns_new(const char* protocol, const char* host, const char* endpoint, const char* ips,
+                     const char* cert_dir, uint32_t mark, uintptr_t socket_tagger);
+void xz1c_dns_delete(uint64_t handle);
+int xz1c_dns_query(uint64_t handle, const uint8_t* query, int query_size,
+                   uint8_t* answer, int answer_size, int timeout_ms,
+                   char* error_text, int error_size);
+}
diff --git a/xz1c-engine/bridge.go b/xz1c-engine/bridge.go
new file mode 100644
index 00000000..f0de99dd
--- /dev/null
+++ b/xz1c-engine/bridge.go
@@ -0,0 +1,124 @@
+// Copyright 2026 XZ1C contributors. Licensed under Apache-2.0.
+package main
+
+/*
+#include <stdint.h>
+static inline void tag_dns_socket(uintptr_t callback, int fd) {
+ if (callback) ((void (*)(int))callback)(fd);
+}
+*/
+import "C"
+
+import (
+	"context"
+	"errors"
+	"net"
+	"net/url"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"syscall"
+	"time"
+	"unsafe"
+)
+
+var engines sync.Map
+var nextHandle atomic.Uint64
+
+//export xz1c_dns_new
+func xz1c_dns_new(protocol, hostname, endpoint, addresses, certDirectory *C.char, mark C.uint32_t, tag C.uintptr_t) C.uint64_t {
+	host, mode := C.GoString(hostname), C.GoString(protocol)
+	u, err := canonicalEndpoint(mode, C.GoString(endpoint))
+	if err != nil || !strings.EqualFold(u.Hostname(), host) {
+		return 0
+	}
+	var ips []net.IP
+	for _, address := range strings.Split(C.GoString(addresses), ",") {
+		ip := net.ParseIP(address)
+		if ip == nil {
+			return 0
+		}
+		ips = append(ips, ip)
+	}
+	roots, err := loadRoots(C.GoString(certDirectory))
+	if err != nil {
+		return 0
+	}
+	control := func(_, _ string, raw syscall.RawConn) error {
+		var socketErr error
+		err := raw.Control(func(fd uintptr) {
+			socketErr = syscall.SetsockoptInt(int(fd), syscall.SOL_SOCKET, syscall.SO_MARK, int(mark))
+			if socketErr == nil {
+				C.tag_dns_socket(tag, C.int(fd))
+			}
+		})
+		if err != nil {
+			return err
+		}
+		return socketErr
+	}
+	port := 443
+	if mode == "doq" || mode == "dot" {
+		port = 853
+	}
+	if u.Port() != "" {
+		port, err = strconv.Atoi(u.Port())
+		if err != nil || port < 1 || port > 65535 {
+			return 0
+		}
+	}
+	e, err := newEngine(mode, host, ips, port, roots, control)
+	if err != nil {
+		return 0
+	}
+	e.endpoint = u.String()
+	handle := nextHandle.Add(1)
+	engines.Store(handle, e)
+	return C.uint64_t(handle)
+}
+
+//export xz1c_dns_delete
+func xz1c_dns_delete(handle C.uint64_t) {
+	if value, ok := engines.LoadAndDelete(uint64(handle)); ok {
+		value.(*engine).close()
+	}
+}
+
+//export xz1c_dns_query
+func xz1c_dns_query(handle C.uint64_t, query *C.uchar, queryLen C.int, answer *C.uchar, answerLen C.int,
+	timeoutMs C.int, errorText *C.char, errorLen C.int) C.int {
+	if queryLen < 12 || queryLen > maxDNSMessage || answerLen < 12 || timeoutMs < 1 {
+		return -1
+	}
+	value, ok := engines.Load(uint64(handle))
+	if !ok {
+		return -1
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Duration(timeoutMs)*time.Millisecond)
+	defer cancel()
+	result, err := value.(*engine).query(ctx, C.GoBytes(unsafe.Pointer(query), queryLen))
+	if err != nil {
+		if errorText != nil && errorLen > 0 {
+			dst := unsafe.Slice((*byte)(unsafe.Pointer(errorText)), int(errorLen))
+			// HTTP errors include the request URL, which may contain a private token.
+			var requestError *url.Error
+			if errors.As(err, &requestError) {
+				err = requestError.Err
+			}
+			n := copy(dst[:len(dst)-1], err.Error())
+			dst[n] = 0
+		}
+		if ctx.Err() == context.DeadlineExceeded {
+			return -255
+		}
+		return -1
+	}
+	if len(result) > int(answerLen) {
+		return -1
+	}
+	copy(unsafe.Slice((*byte)(unsafe.Pointer(answer)), int(answerLen)), result)
+	return C.int(len(result))
+}
+
+func main() {}
diff --git a/xz1c-engine/build-android.sh b/xz1c-engine/build-android.sh
new file mode 100755
index 00000000..d9e85918
--- /dev/null
+++ b/xz1c-engine/build-android.sh
@@ -0,0 +1,35 @@
+#!/bin/bash
+# Rebuild checked-in Android libraries from the pinned, vendored source.
+set -euo pipefail
+ENGINE_DIR=$(cd "$(dirname "$0")" && pwd)
+XZ1C_ANDROID_TREE=${XZ1C_ANDROID_TREE:-$(cd "$ENGINE_DIR/../../../.." && pwd)}
+XZ1C_GO=${XZ1C_GO:-$XZ1C_ANDROID_TREE/prebuilts/go/linux-x86/bin/go}
+export GOTOOLCHAIN=go1.26.0
+export XZ1C_TOOL_CC="$XZ1C_ANDROID_TREE/prebuilts/clang/host/linux-x86/clang-r536225/bin/clang"
+export XZ1C_TOOL_SYSROOT="$XZ1C_ANDROID_TREE/out/soong/ndk/sysroot"
+TASK_TMP=$(mktemp -d)
+trap 'rm -rf "$TASK_TMP"' EXIT
+cat > "$TASK_TMP/clang" <<'EOF'
+#!/bin/sh
+exec "$XZ1C_TOOL_CC" -Wno-unused-command-line-argument --target="$XZ1C_TOOL_TRIPLE" \
+ --sysroot="$XZ1C_TOOL_SYSROOT" -isystem "$XZ1C_TOOL_SYSROOT/usr/include/$XZ1C_TOOL_LIBARCH" \
+ -L"$XZ1C_TOOL_SYSROOT/usr/lib/$XZ1C_TOOL_LIBARCH/30" \
+ -B"$XZ1C_TOOL_SYSROOT/usr/lib/$XZ1C_TOOL_LIBARCH/29" -fuse-ld=lld "$@"
+EOF
+chmod +x "$TASK_TMP/clang"
+cd "$ENGINE_DIR"
+for architecture in arm64 arm; do
+ if [ "$architecture" = arm64 ]; then
+  export XZ1C_TOOL_TRIPLE=aarch64-linux-android30 XZ1C_TOOL_LIBARCH=aarch64-linux-android
+ else
+  export XZ1C_TOOL_TRIPLE=armv7a-linux-androideabi30 XZ1C_TOOL_LIBARCH=arm-linux-androideabi
+ fi
+ mkdir -p "prebuilt/$architecture"
+ CGO_ENABLED=1 GOOS=android GOARCH="$architecture" GOARM=7 CC="$TASK_TMP/clang" \
+  "$XZ1C_GO" build -mod=vendor -buildmode=c-shared -trimpath \
+  -ldflags='-s -w -extldflags=-Wl,-soname,libxz1c_dns_engine.so,-z,max-page-size=16384' \
+  -o "prebuilt/$architecture/libxz1c_dns_engine.so" .
+ # The stable C interface is api.h; the generated Go-specific header is unnecessary.
+ rm -f "prebuilt/$architecture/libxz1c_dns_engine.h"
+done
+sha256sum prebuilt/*/*.so > prebuilt/SHA256SUMS
diff --git a/xz1c-engine/engine.go b/xz1c-engine/engine.go
new file mode 100644
index 00000000..3b4af306
--- /dev/null
+++ b/xz1c-engine/engine.go
@@ -0,0 +1,354 @@
+// Copyright 2026 XZ1C contributors. Licensed under Apache-2.0.
+package main
+
+import (
+ "bytes"
+ "context"
+ "crypto/tls"
+ "crypto/x509"
+ "encoding/binary"
+ "errors"
+ "fmt"
+ "io"
+ "mime"
+ "net"
+ "net/http"
+ "net/url"
+ "os"
+ "path/filepath"
+ "strings"
+ "sync"
+ "syscall"
+ "time"
+
+ quic "github.com/quic-go/quic-go"
+ "github.com/quic-go/quic-go/http3"
+ "golang.org/x/net/dns/dnsmessage"
+ "golang.org/x/net/http2"
+)
+
+const maxDNSMessage = 65535
+
+type engine struct {
+ protocol, hostname, path, endpoint string
+ ips []net.IP
+ port int
+ tlsConfig *tls.Config
+ control func(string, string, syscall.RawConn) error
+ client *http.Client
+ ctx context.Context
+ cancel context.CancelFunc
+ mu sync.Mutex
+ transports map[string]*quic.Transport
+ connections map[string]*quic.Conn
+ tlsMu sync.Mutex
+ tlsConn net.Conn
+ closeOnce sync.Once
+}
+
+func loadRoots(directory string) (*x509.CertPool, error) {
+ roots := x509.NewCertPool()
+ entries, err := os.ReadDir(directory)
+ if err != nil { return nil, err }
+ loaded := false
+ for _, entry := range entries {
+  if entry.IsDir() { continue }
+  data, err := os.ReadFile(filepath.Join(directory, entry.Name()))
+  if err == nil && roots.AppendCertsFromPEM(data) { loaded = true }
+ }
+ if !loaded { return nil, errors.New("no trusted CA certificates") }
+ return roots, nil
+}
+
+func newEngine(protocol, host string, ips []net.IP, port int, roots *x509.CertPool,
+ control func(string, string, syscall.RawConn) error) (*engine, error) {
+ if protocol != "dot" && protocol != "doh" && protocol != "doh3" && protocol != "doq" {
+  return nil, errors.New("unsupported encrypted DNS protocol")
+ }
+ if len(ips) == 0 || roots == nil { return nil, errors.New("missing addresses or trust roots") }
+ ctx, cancel := context.WithCancel(context.Background())
+ e := &engine{protocol: protocol, hostname: host, path: "/dns-query", ips: ips, port: port,
+  endpoint: "https://"+host+"/dns-query",
+  ctx: ctx, cancel: cancel, control: control,
+  transports: make(map[string]*quic.Transport), connections: make(map[string]*quic.Conn),
+  tlsConfig: &tls.Config{ServerName: host, RootCAs: roots, MinVersion: tls.VersionTLS12,
+   ClientSessionCache: tls.NewLRUClientSessionCache(8)}}
+ switch protocol {
+ case "doh":
+  tr := &http2.Transport{TLSClientConfig: e.tlsConfig, ReadIdleTimeout: 30*time.Second,
+   PingTimeout: 5*time.Second,
+   DialTLSContext: func(ctx context.Context, _, _ string, cfg *tls.Config) (net.Conn, error) {
+    cfg = cfg.Clone()
+    cfg.NextProtos = []string{"h2"}
+    var last error
+    for _, ip := range e.ips {
+     attempt, cancel := context.WithTimeout(ctx, 3*time.Second)
+     raw, err := (&net.Dialer{Control: e.control}).DialContext(attempt, "tcp", e.address(ip))
+     if err == nil {
+      conn := tls.Client(raw, cfg)
+      err = conn.HandshakeContext(attempt)
+      if err == nil && conn.ConnectionState().NegotiatedProtocol != "h2" {
+       err = errors.New("server did not negotiate HTTP/2")
+      }
+      if err == nil { cancel(); return conn, nil }
+      raw.Close()
+     }
+     cancel(); last = err
+     if ctx.Err() != nil { break }
+    }
+    return nil, last
+   }}
+  e.client = &http.Client{Transport: tr, CheckRedirect: rejectRedirect}
+ case "doh3":
+  tr := &http3.Transport{TLSClientConfig: e.tlsConfig,
+   QUICConfig: e.quicConfig(),
+   Dial: func(ctx context.Context, _ string, cfg *tls.Config, qc *quic.Config) (*quic.Conn, error) {
+    var last error
+    for _, ip := range e.ips {
+     attempt, cancel := context.WithTimeout(ctx, 3*time.Second)
+     qt, addr, err := e.transport(ip)
+     if err == nil {
+      var conn *quic.Conn
+      conn, err = qt.Dial(attempt, addr, cfg, qc)
+      if err == nil { cancel(); return conn, nil }
+     }
+     cancel(); last = err
+     if ctx.Err() != nil { break }
+    }
+    return nil, last
+   }}
+  e.client = &http.Client{Transport: tr, CheckRedirect: rejectRedirect}
+ }
+ return e, nil
+}
+
+func rejectRedirect(*http.Request, []*http.Request) error {
+ return errors.New("DNS redirects are disabled")
+}
+
+func (e *engine) quicConfig() *quic.Config {
+ return &quic.Config{HandshakeIdleTimeout: 3*time.Second, MaxIdleTimeout: 30*time.Second,
+  MaxIncomingStreams: -1, MaxIncomingUniStreams: 16}
+}
+
+func (e *engine) address(ip net.IP) string { return net.JoinHostPort(ip.String(), fmt.Sprint(e.port)) }
+
+func (e *engine) transport(ip net.IP) (*quic.Transport, *net.UDPAddr, error) {
+ e.mu.Lock()
+ defer e.mu.Unlock()
+ if e.ctx.Err() != nil { return nil, nil, e.ctx.Err() }
+ address := e.address(ip)
+ addr := &net.UDPAddr{IP: ip, Port: e.port}
+ if tr := e.transports[address]; tr != nil { return tr, addr, nil }
+ network, bind := "udp4", "0.0.0.0:0"
+ if ip.To4() == nil { network, bind = "udp6", "[::]:0" }
+ socket, err := (&net.ListenConfig{Control: e.control}).ListenPacket(e.ctx, network, bind)
+ if err != nil { return nil, nil, err }
+ tr := &quic.Transport{Conn: socket}
+ e.transports[address] = tr
+ return tr, addr, nil
+}
+
+func (e *engine) close() {
+ e.closeOnce.Do(func() {
+  e.cancel()
+  e.tlsMu.Lock()
+  if e.tlsConn != nil { e.tlsConn.Close(); e.tlsConn = nil }
+  e.tlsMu.Unlock()
+  if e.client != nil {
+   switch tr := e.client.Transport.(type) {
+   case *http2.Transport: tr.CloseIdleConnections()
+   case *http3.Transport: tr.Close()
+   }
+  }
+  e.mu.Lock()
+  defer e.mu.Unlock()
+  for _, conn := range e.connections { conn.CloseWithError(0, "configuration removed") }
+  for _, tr := range e.transports { tr.Close(); tr.Conn.Close() }
+ })
+}
+
+func validateAnswer(query, answer []byte) error {
+ if len(query) < 12 || len(answer) < 12 || len(answer) > maxDNSMessage {
+  return errors.New("invalid DNS message size")
+ }
+ var q, a dnsmessage.Parser
+ qh, err := q.Start(query)
+ if err != nil { return err }
+ ah, err := a.Start(answer)
+ if err != nil { return err }
+ if !ah.Response || ah.ID != qh.ID || ah.OpCode != qh.OpCode {
+  return errors.New("DNS response header does not match query")
+ }
+ qs, err := q.AllQuestions()
+ if err != nil { return err }
+ as, err := a.AllQuestions()
+ if err != nil { return err }
+ if len(qs) != len(as) { return errors.New("DNS response question count mismatch") }
+ for i := range qs {
+  if !strings.EqualFold(qs[i].Name.String(), as[i].Name.String()) ||
+   qs[i].Type != as[i].Type || qs[i].Class != as[i].Class {
+   return errors.New("DNS response question mismatch")
+  }
+ }
+ // Fully parse records to reject truncated/malformed packets before validation succeeds.
+ if _, err = a.AllAnswers(); err != nil { return err }
+ if _, err = a.AllAuthorities(); err != nil { return err }
+ if _, err = a.AllAdditionals(); err != nil { return err }
+ return nil
+}
+
+func (e *engine) query(ctx context.Context, query []byte) ([]byte, error) {
+ if len(query) < 12 || len(query) > maxDNSMessage { return nil, errors.New("invalid query size") }
+ ctx, cancel := context.WithCancel(ctx)
+ defer cancel()
+ stop := context.AfterFunc(e.ctx, cancel)
+ defer stop()
+ if e.ctx.Err() != nil { return nil, e.ctx.Err() }
+ if e.protocol == "dot" { return e.queryTLS(ctx, query) }
+ if e.protocol == "doq" { return e.queryQUIC(ctx, query) }
+ req, err := http.NewRequestWithContext(ctx, "POST", e.endpoint, bytes.NewReader(query))
+ if err != nil { return nil, err }
+ req.Header.Set("Content-Type", "application/dns-message")
+ req.Header.Set("Accept", "application/dns-message")
+ resp, err := e.client.Do(req)
+ if err != nil { return nil, err }
+ defer resp.Body.Close()
+ if resp.StatusCode != http.StatusOK { return nil, fmt.Errorf("DNS HTTP status %d", resp.StatusCode) }
+ wantMajor := 2
+ if e.protocol == "doh3" { wantMajor = 3 }
+ if resp.ProtoMajor != wantMajor { return nil, errors.New("unexpected HTTP protocol") }
+ contentType, _, err := mime.ParseMediaType(resp.Header.Get("Content-Type"))
+ if err != nil || contentType != "application/dns-message" { return nil, errors.New("invalid DNS content type") }
+ answer, err := io.ReadAll(io.LimitReader(resp.Body, maxDNSMessage+1))
+ if err != nil { return nil, err }
+ if err = validateAnswer(query, answer); err != nil { return nil, err }
+ return answer, nil
+}
+
+// canonicalEndpoint accepts a full HTTPS URL for DoH, or a hostname/port for DoT and DoQ.
+// Bootstrap always resolves the real hostname through Android's network-specific machinery.
+func canonicalEndpoint(protocol, endpoint string) (*url.URL, error) {
+ scheme, port := "https", "443"
+ if protocol=="dot" {scheme,port="tls","853"}
+ if protocol=="doq" {scheme,port="quic","853"}
+ if !strings.Contains(endpoint, "://") { endpoint=scheme+"://"+endpoint }
+ u,err:=url.Parse(endpoint)
+ if err!=nil || u.Hostname()=="" || u.User!=nil || u.Fragment!="" || u.Scheme!=scheme {
+  return nil,errors.New("invalid encrypted DNS endpoint")
+ }
+ if u.Port()!="" {port=u.Port()}
+ if _,err=net.LookupPort("tcp",port);err!=nil {return nil,err}
+ if protocol=="doh" || protocol=="doh3" {
+  if u.Path=="" {u.Path="/dns-query"}
+ } else if (u.Path!="" && u.Path!="/") || u.RawQuery!="" {
+  return nil,errors.New("DoT and DoQ endpoints cannot have a path or query")
+ }
+ return u,nil
+}
+
+func (e *engine) queryTLS(ctx context.Context, query []byte) ([]byte,error) {
+ e.tlsMu.Lock()
+ defer e.tlsMu.Unlock()
+ if ctx.Err()!=nil || e.ctx.Err()!=nil {return nil,context.Canceled}
+ if e.tlsConn==nil {
+  var last error
+  for _,ip:=range e.ips {
+   attempt,cancel:=context.WithTimeout(ctx,3*time.Second)
+   conn,err:=(&tls.Dialer{NetDialer:&net.Dialer{Control:e.control},Config:e.tlsConfig}).
+    DialContext(attempt,"tcp",e.address(ip))
+   cancel()
+   if err==nil {e.tlsConn=conn;break}
+   last=err;if ctx.Err()!=nil {break}
+  }
+  if e.tlsConn==nil {return nil,last}
+ }
+ conn:=e.tlsConn
+ if deadline,ok:=ctx.Deadline();ok {conn.SetDeadline(deadline)}
+ // Keep a canceled request from poisoning a later request on this pooled connection.
+ stopped:=make(chan struct{})
+ stop:=context.AfterFunc(ctx,func(){conn.Close();close(stopped)})
+ defer func(){if !stop(){<-stopped}}()
+ packet:=make([]byte,len(query)+2);binary.BigEndian.PutUint16(packet,uint16(len(query)));copy(packet[2:],query)
+ var answer []byte
+ _,err:=io.Copy(conn,bytes.NewReader(packet))
+ if err==nil {
+  var size [2]byte
+  _,err=io.ReadFull(conn,size[:])
+  if err==nil {
+   answer=make([]byte,int(binary.BigEndian.Uint16(size[:])))
+   _,err=io.ReadFull(conn,answer)
+   if err==nil {err=validateAnswer(query,answer)}
+  }
+ }
+ if err!=nil || ctx.Err()!=nil {conn.Close();e.tlsConn=nil;if err==nil {err=ctx.Err()};return nil,err}
+ return answer,nil
+}
+
+func (e *engine) doqConnection(ctx context.Context, ip net.IP) (*quic.Conn, error) {
+ address := e.address(ip)
+ e.mu.Lock()
+ existing := e.connections[address]
+ e.mu.Unlock()
+ if existing != nil && existing.Context().Err() == nil { return existing, nil }
+ tr, addr, err := e.transport(ip)
+ if err != nil { return nil, err }
+ cfg := e.tlsConfig.Clone()
+ cfg.MinVersion = tls.VersionTLS13
+ cfg.NextProtos = []string{"doq"}
+ conn, err := tr.Dial(ctx, addr, cfg, e.quicConfig())
+ if err != nil { return nil, err }
+ e.mu.Lock()
+ defer e.mu.Unlock()
+ if e.ctx.Err() != nil { conn.CloseWithError(0, "closed"); return nil, e.ctx.Err() }
+ if existing = e.connections[address]; existing != nil && existing.Context().Err() == nil {
+  conn.CloseWithError(0, "duplicate connection")
+  return existing, nil
+ }
+ e.connections[address] = conn
+ return conn, nil
+}
+
+func (e *engine) queryQUIC(ctx context.Context, query []byte) ([]byte, error) {
+ var last error
+ for _, ip := range e.ips {
+  attempt, cancel := context.WithTimeout(ctx, 4*time.Second)
+  conn, err := e.doqConnection(attempt, ip)
+  if err == nil { var answer []byte; answer, err = exchangeQUIC(attempt, conn, query)
+   if err == nil { cancel(); return answer, nil }
+  }
+  cancel(); last = err
+  if ctx.Err() != nil { break }
+ }
+ return nil, last
+}
+
+func exchangeQUIC(ctx context.Context, conn *quic.Conn, query []byte) ([]byte, error) {
+ stream, err := conn.OpenStreamSync(ctx)
+ if err != nil { return nil, err }
+ defer stream.CancelRead(3)
+ defer stream.CancelWrite(3)
+ if deadline, ok := ctx.Deadline(); ok { stream.SetDeadline(deadline) }
+ stop := context.AfterFunc(ctx, func(){ stream.CancelRead(3); stream.CancelWrite(3) })
+ defer stop()
+ packet := make([]byte, len(query)+2)
+ binary.BigEndian.PutUint16(packet, uint16(len(query)))
+ copy(packet[2:], query)
+ // RFC 9250: the stream identifies the transaction; the DNS message ID must be zero.
+ packet[2], packet[3] = 0, 0
+ if _, err = io.Copy(stream, bytes.NewReader(packet)); err != nil { return nil, err }
+ if err = stream.Close(); err != nil { return nil, err }
+ var size [2]byte
+ if _, err = io.ReadFull(stream, size[:]); err != nil { return nil, err }
+ answer := make([]byte, int(binary.BigEndian.Uint16(size[:])))
+ if len(answer) < 12 { return nil, errors.New("short DoQ response") }
+ if _, err = io.ReadFull(stream, answer); err != nil { return nil, err }
+ var extra [1]byte
+ if n, err := stream.Read(extra[:]); n != 0 || err != io.EOF {
+  return nil, errors.New("DoQ response has trailing bytes or no FIN")
+ }
+ if answer[0] != 0 || answer[1] != 0 { return nil, errors.New("nonzero DoQ message ID") }
+ answer[0], answer[1] = query[0], query[1]
+ if err = validateAnswer(query, answer); err != nil { return nil, err }
+ return answer, nil
+}
diff --git a/xz1c-engine/engine_test.go b/xz1c-engine/engine_test.go
new file mode 100644
index 00000000..326ab80a
--- /dev/null
+++ b/xz1c-engine/engine_test.go
@@ -0,0 +1,181 @@
+// Copyright 2026 XZ1C contributors. Licensed under Apache-2.0.
+package main
+
+import (
+ "context"
+ "crypto/tls"
+ "crypto/x509"
+ "encoding/binary"
+ "io"
+ "net"
+ "net/http"
+ "net/http/httptest"
+ "os"
+ "testing"
+ "time"
+
+ quic "github.com/quic-go/quic-go"
+ "github.com/quic-go/quic-go/http3"
+ "golang.org/x/net/dns/dnsmessage"
+)
+
+func testQuery(t *testing.T) []byte {
+ t.Helper()
+ name, err := dnsmessage.NewName("alidns.com.")
+ if err != nil { t.Fatal(err) }
+ msg := dnsmessage.Message{Header: dnsmessage.Header{ID: 123, RecursionDesired: true},
+  Questions: []dnsmessage.Question{{Name: name, Type: dnsmessage.TypeA, Class: dnsmessage.ClassINET}}}
+ data, err := msg.Pack()
+ if err != nil { t.Fatal(err) }
+ return data
+}
+
+func echoAnswer(query []byte) []byte {
+ answer := append([]byte(nil), query...)
+ answer[2] |= 0x80
+ return answer
+}
+
+func testCertificate(t *testing.T) (tls.Certificate, *x509.CertPool) {
+ t.Helper()
+ temporary := httptest.NewTLSServer(http.NotFoundHandler())
+ defer temporary.Close()
+ cert := temporary.TLS.Certificates[0]
+ leaf, err := x509.ParseCertificate(cert.Certificate[0])
+ if err != nil { t.Fatal(err) }
+ roots := x509.NewCertPool(); roots.AddCert(leaf)
+ return cert, roots
+}
+
+func TestEncryptedProtocols(t *testing.T) {
+ query := testQuery(t)
+ cert, roots := testCertificate(t)
+ handler := http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+  if r.Method != "POST" || r.URL.Path != "/dns-query" { t.Error("unexpected HTTP request") }
+  q, err := io.ReadAll(r.Body); if err != nil { t.Error(err); return }
+  w.Header().Set("Content-Type", "application/dns-message")
+  w.Write(echoAnswer(q))
+ })
+ for _, protocol := range []string{"dot", "doh", "doh3", "doq"} {
+  t.Run(protocol, func(t *testing.T) {
+   var port int
+   switch protocol {
+   case "dot":
+    listener,err:=tls.Listen("tcp","127.0.0.1:0",&tls.Config{Certificates:[]tls.Certificate{cert}})
+    if err!=nil {t.Fatal(err)};defer listener.Close()
+    port=listener.Addr().(*net.TCPAddr).Port
+    go func(){for {conn,err:=listener.Accept();if err!=nil {return};go func(){defer conn.Close();for {
+     var size [2]byte;if _,err:=io.ReadFull(conn,size[:]);err!=nil{return}
+     q:=make([]byte,int(binary.BigEndian.Uint16(size[:])));if _,err:=io.ReadFull(conn,q);err!=nil{return}
+     conn.Write(append(size[:],echoAnswer(q)...))
+    }}()}}()
+   case "doh":
+    server := httptest.NewUnstartedServer(handler)
+    server.EnableHTTP2 = true
+    server.TLS = &tls.Config{Certificates: []tls.Certificate{cert}}
+    server.StartTLS(); defer server.Close()
+    port = server.Listener.Addr().(*net.TCPAddr).Port
+   case "doh3":
+    socket, err := net.ListenPacket("udp4", "127.0.0.1:0"); if err != nil { t.Fatal(err) }
+    server := &http3.Server{Handler: handler, TLSConfig: &tls.Config{Certificates: []tls.Certificate{cert}}}
+    go server.Serve(socket); defer server.Close(); defer socket.Close()
+    port = socket.LocalAddr().(*net.UDPAddr).Port
+   case "doq":
+    listener, err := quic.ListenAddr("127.0.0.1:0",
+     &tls.Config{Certificates: []tls.Certificate{cert}, NextProtos: []string{"doq"}}, nil)
+    if err != nil { t.Fatal(err) }; defer listener.Close()
+    port = listener.Addr().(*net.UDPAddr).Port
+    go func() {
+     for { conn, err := listener.Accept(context.Background()); if err != nil { return }
+      go func() { for { stream, err := conn.AcceptStream(context.Background()); if err != nil { return }
+       go func() {
+        defer stream.Close()
+        packet, err := io.ReadAll(stream); if err != nil || len(packet)<14 { return }
+        if int(binary.BigEndian.Uint16(packet)) != len(packet)-2 { t.Error("incorrect DoQ framing") }
+        if packet[2] != 0 || packet[3] != 0 { t.Error("DoQ must use ID zero") }
+        packet[4] |= 0x80; stream.Write(packet)
+       }()
+      }}()
+     }
+    }()
+   }
+   e, err := newEngine(protocol, "example.com", []net.IP{net.ParseIP("127.0.0.1")}, port, roots, nil)
+   if err != nil { t.Fatal(err) }; defer e.close()
+   for i:=0; i<2; i++ {
+    ctx,cancel := context.WithTimeout(context.Background(), 5*time.Second)
+    answer,err := e.query(ctx,query); cancel()
+    if err != nil { t.Fatal(err) }
+    if binary.BigEndian.Uint16(answer) != 123 { t.Fatal("transaction ID was not restored") }
+   }
+   // Removing a network must invalidate any retained engine reference.
+   e.close()
+   if _,err := e.query(context.Background(),query); err == nil { t.Fatal("closed engine accepted query") }
+  })
+ }
+}
+
+func TestRejectBadResponses(t *testing.T) {
+ query := testQuery(t)
+ for name, mutate := range map[string]func([]byte) []byte{
+  "short": func(a []byte) []byte{return a[:5]},
+  "id": func(a []byte) []byte{a[0]++; return a},
+  "request": func(a []byte) []byte{a[2]&=0x7f; return a},
+  "question": func(a []byte) []byte{a[14]='z'; return a},
+  "truncated-record": func(a []byte) []byte{a[7]=1; return a},
+ } {
+  t.Run(name,func(t *testing.T){if validateAnswer(query,mutate(echoAnswer(query)))==nil {t.Fatal("bad response accepted")}})
+ }
+}
+
+func TestRejectWrongCertificate(t *testing.T) {
+ server := httptest.NewUnstartedServer(http.NotFoundHandler()); server.EnableHTTP2=true
+ server.StartTLS(); defer server.Close()
+ e,err:=newEngine("doh","dns.alidns.com",[]net.IP{net.ParseIP("127.0.0.1")},
+  server.Listener.Addr().(*net.TCPAddr).Port,x509.NewCertPool(),nil)
+ if err!=nil {t.Fatal(err)}; defer e.close()
+ ctx,cancel:=context.WithTimeout(context.Background(),time.Second);defer cancel()
+ if _,err=e.query(ctx,testQuery(t));err==nil {t.Fatal("untrusted certificate accepted")}
+}
+
+func TestAliDNSLive(t *testing.T) {
+ if os.Getenv("XZ1C_DNS_LIVE")!="1" {t.Skip("set XZ1C_DNS_LIVE=1 for external endpoint tests")}
+ roots,err:=x509.SystemCertPool();if err!=nil {t.Fatal(err)}
+ query:=testQuery(t)
+ for _,protocol:=range []string{"dot","doh","doh3","doq"} {
+  t.Run(protocol,func(t *testing.T){
+   ctx,cancel:=context.WithTimeout(context.Background(),15*time.Second);defer cancel()
+   var answer []byte
+   if false {
+    conn,err:=(&tls.Dialer{Config:&tls.Config{ServerName:"dns.alidns.com",RootCAs:roots,MinVersion:tls.VersionTLS12}}).
+     DialContext(ctx,"tcp","223.5.5.5:853")
+    if err!=nil {t.Fatal(err)};defer conn.Close();conn.SetDeadline(time.Now().Add(10*time.Second))
+    packet:=make([]byte,len(query)+2);binary.BigEndian.PutUint16(packet,uint16(len(query)));copy(packet[2:],query)
+    if _,err=conn.Write(packet);err!=nil {t.Fatal(err)}
+    var size [2]byte;if _,err=io.ReadFull(conn,size[:]);err!=nil {t.Fatal(err)}
+    answer=make([]byte,int(binary.BigEndian.Uint16(size[:])));if _,err=io.ReadFull(conn,answer);err!=nil {t.Fatal(err)}
+   } else {
+    port:=443;if protocol=="doq" || protocol=="dot" {port=853}
+    e,err:=newEngine(protocol,"dns.alidns.com",[]net.IP{net.ParseIP("223.5.5.5"),net.ParseIP("223.6.6.6")},port,roots,nil)
+    if err!=nil {t.Fatal(err)};defer e.close()
+    answer,err=e.query(ctx,query);if err!=nil {t.Fatal(err)}
+   }
+   if err=validateAnswer(query,answer);err!=nil {t.Fatal(err)}
+   t.Logf("verified encrypted query, %d response bytes",len(answer))
+  })
+ }
+}
+
+func TestCustomEndpoints(t *testing.T) {
+ for _,item:=range []struct{protocol,input,host string}{
+  {"dot","resolver.example:8853","resolver.example"},
+  {"doq","quic://resolver.example:8854","resolver.example"},
+  {"doh","https://resolver.example:8443/custom/path?profile=abc","resolver.example"},
+  {"doh3","resolver.example","resolver.example"},
+ } {
+  u,err:=canonicalEndpoint(item.protocol,item.input)
+  if err!=nil || u.Hostname()!=item.host {t.Fatalf("%s: %v",item.input,err)}
+ }
+ for _,input:=range []string{"http://resolver.example/dns-query","https://user:password@resolver.example","https://resolver.example/#fragment","https://resolver.example:99999"} {
+  if _,err:=canonicalEndpoint("doh",input);err==nil {t.Fatalf("invalid endpoint accepted: %s",input)}
+ }
+}
