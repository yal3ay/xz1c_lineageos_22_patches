+func (e *engine) dialTLS(ctx context.Context) (net.Conn, error) {
+ var last error
+ for _, ip := range e.ips {
+  attempt, cancel := context.WithTimeout(ctx, 3*time.Second)
+  conn, err := (&tls.Dialer{NetDialer: &net.Dialer{Control: e.control}, Config: e.tlsConfig}).
+   DialContext(attempt, "tcp", e.address(ip))
+  cancel()
+  if err == nil { return conn, nil }
+  last = err
+  if ctx.Err() != nil { break }
+ }
+ return nil, last
+}
+
+func (e *engine) putTLS(conn net.Conn) {
+ conn.SetDeadline(time.Time{})
+ e.tlsMu.Lock()
+ defer e.tlsMu.Unlock()
+ if e.tlsClosed || len(e.tlsIdle) >= maxTLSConns { conn.Close(); return }
+ e.tlsIdle = append(e.tlsIdle, idleTLS{conn, time.Now()})
+}
+
+// exchangeTLS sends one framed query and reads its answer. It closes conn on any failure.
+func exchangeTLS(ctx context.Context, conn net.Conn, query []byte) ([]byte, error) {
