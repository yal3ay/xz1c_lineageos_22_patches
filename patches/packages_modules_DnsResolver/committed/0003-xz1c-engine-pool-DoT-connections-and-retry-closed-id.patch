-   if err==nil {err=validateAnswer(query,answer)}
+  _, err = io.ReadFull(conn, size[:])
+  if err == nil {
+   answer = make([]byte, int(binary.BigEndian.Uint16(size[:])))
+   _, err = io.ReadFull(conn, answer)
+   if err == nil { err = validateAnswer(query, answer) }
   }
  }
- if err!=nil || ctx.Err()!=nil {conn.Close();e.tlsConn=nil;if err==nil {err=ctx.Err()};return nil,err}
