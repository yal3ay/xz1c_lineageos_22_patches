+// startDoT serves framed DNS over TLS. closeAfter > 0 closes each connection after that many
+// answers (a server dropping idle clients); delay holds every answer back.
+func startDoT(t *testing.T, cert tls.Certificate, closeAfter int, delay time.Duration,
+ accepted, open, maxOpen *atomic.Int32) int {
+ t.Helper()
+ listener, err := tls.Listen("tcp", "127.0.0.1:0", &tls.Config{Certificates: []tls.Certificate{cert}})
+ if err != nil { t.Fatal(err) }
+ t.Cleanup(func() { listener.Close() })
+ go func() {
+  for {
+   conn, err := listener.Accept(); if err != nil { return }
+   accepted.Add(1)
+   if n := open.Add(1); n > maxOpen.Load() { maxOpen.Store(n) }
+   go func() {
+    defer open.Add(-1)
+    defer conn.Close()
+    for served := 0; closeAfter == 0 || served < closeAfter; served++ {
+     var size [2]byte
+     if _, err := io.ReadFull(conn, size[:]); err != nil { return }
+     q := make([]byte, int(binary.BigEndian.Uint16(size[:])))
+     if _, err := io.ReadFull(conn, q); err != nil { return }
+     time.Sleep(delay)
+     conn.Write(append(size[:], echoAnswer(q)...))
+    }
+   }()
+  }
+ }()
+ return listener.Addr().(*net.TCPAddr).Port
+}
+
+func TestDoTRetriesClosedIdleConnection(t *testing.T) {
+ query := testQuery(t)
+ cert, roots := testCertificate(t)
+ var accepted, open, maxOpen atomic.Int32
+ port := startDoT(t, cert, 1, 0, &accepted, &open, &maxOpen)
+ e, err := newEngine("dot", "example.com", []net.IP{net.ParseIP("127.0.0.1")}, port, roots, nil)
+ if err != nil { t.Fatal(err) }
+ defer e.close()
+ for i := 0; i < 3; i++ {
+  // Let the server's close reach the pooled connection before it is reused.
+  time.Sleep(50 * time.Millisecond)
+  ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+  _, err := e.query(ctx, query); cancel()
+  if err != nil { t.Fatalf("query %d after server closed idle connection: %v", i, err) }
+ }
+ if accepted.Load() < 3 { t.Fatalf("expected a fresh connection per query, got %d", accepted.Load()) }
+}
+
+func TestDoTParallelQueries(t *testing.T) {
+ query := testQuery(t)
+ cert, roots := testCertificate(t)
+ var accepted, open, maxOpen atomic.Int32
+ const delay = 400 * time.Millisecond
+ port := startDoT(t, cert, 0, delay, &accepted, &open, &maxOpen)
+ e, err := newEngine("dot", "example.com", []net.IP{net.ParseIP("127.0.0.1")}, port, roots, nil)
+ if err != nil { t.Fatal(err) }
+ defer e.close()
+ const queries = 8
+ start := time.Now()
+ var wg sync.WaitGroup
+ errs := make(chan error, queries)
+ for i := 0; i < queries; i++ {
+  wg.Add(1)
+  go func() {
+   defer wg.Done()
+   ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+   defer cancel()
+   if _, err := e.query(ctx, query); err != nil { errs <- err }
+  }()
+ }
+ wg.Wait(); close(errs)
+ for err := range errs { t.Fatal(err) }
+ elapsed := time.Since(start)
+ // Serialised on one connection this takes queries*delay; the pool allows maxTLSConns at once.
+ if elapsed >= queries*delay/2 { t.Fatalf("queries were not parallel: %v", elapsed) }
+ if maxOpen.Load() > maxTLSConns { t.Fatalf("opened %d connections, limit %d", maxOpen.Load(), maxTLSConns) }
+}
