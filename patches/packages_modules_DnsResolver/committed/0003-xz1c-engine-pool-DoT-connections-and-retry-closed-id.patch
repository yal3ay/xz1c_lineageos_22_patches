-func (e *engine) queryTLS(ctx context.Context, query []byte) ([]byte,error) {
+func (e *engine) queryTLS(ctx context.Context, query []byte) ([]byte, error) {
+ select {
+ case e.tlsSlots <- struct{}{}:
+ case <-ctx.Done():
+  return nil, ctx.Err()
+ }
+ defer func() { <-e.tlsSlots }()
+ conn, reused, err := e.takeTLS(ctx)
+ if err != nil { return nil, err }
+ answer, err := exchangeTLS(ctx, conn, query)
+ if err != nil && reused && ctx.Err() == nil && e.ctx.Err() == nil {
+  // The server may have closed a pooled connection while it was idle; DNS
+  // queries are idempotent, so retry once on a fresh connection.
+  if conn, err = e.dialTLS(ctx); err != nil { return nil, err }
+  answer, err = exchangeTLS(ctx, conn, query)
+ }
+ if err != nil { return nil, err }
+ e.putTLS(conn)
+ return answer, nil
+}
