- stop:=context.AfterFunc(ctx,func(){conn.Close();close(stopped)})
- defer func(){if !stop(){<-stopped}}()
- packet:=make([]byte,len(query)+2);binary.BigEndian.PutUint16(packet,uint16(len(query)));copy(packet[2:],query)
+ stopped := make(chan struct{})
+ stop := context.AfterFunc(ctx, func() { conn.Close(); close(stopped) })
+ defer func() { if !stop() { <-stopped } }()
+ packet := make([]byte, len(query)+2); binary.BigEndian.PutUint16(packet, uint16(len(query))); copy(packet[2:], query)
  var answer []byte
- _,err:=io.Copy(conn,bytes.NewReader(packet))
- if err==nil {
+ _, err := io.Copy(conn, bytes.NewReader(packet))
+ if err == nil {
   var size [2]byte
-  _,err=io.ReadFull(conn,size[:])
-  if err==nil {
-   answer=make([]byte,int(binary.BigEndian.Uint16(size[:])))
