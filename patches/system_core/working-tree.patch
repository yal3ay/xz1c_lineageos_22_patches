diff --git a/rootdir/init.rc b/rootdir/init.rc
index 0cc129707..8efc8bd78 100644
--- a/rootdir/init.rc
+++ b/rootdir/init.rc
@@ -147,6 +147,24 @@ on init
     chmod 0664 /dev/stune/top-app/cgroup.procs
     chmod 0664 /dev/stune/rt/cgroup.procs
 
+    # Create cgroup v1 freezer nodes for Smart App Freezing
+    mkdir /dev/freezer 0755 system system
+    mount cgroup none /dev/freezer nodev noexec nosuid freezer
+    mkdir /dev/freezer/frozen 0755 system system
+    write /dev/freezer/frozen/freezer.state FROZEN
+    chown system system /dev/freezer
+    chown system system /dev/freezer/frozen
+    chown system system /dev/freezer/tasks
+    chown system system /dev/freezer/cgroup.procs
+    chown system system /dev/freezer/frozen/tasks
+    chown system system /dev/freezer/frozen/cgroup.procs
+    chown system system /dev/freezer/frozen/freezer.state
+    chmod 0664 /dev/freezer/tasks
+    chmod 0664 /dev/freezer/cgroup.procs
+    chmod 0664 /dev/freezer/frozen/tasks
+    chmod 0664 /dev/freezer/frozen/cgroup.procs
+    chmod 0664 /dev/freezer/frozen/freezer.state
+
     # cpuctl hierarchy for devices using utilclamp
     mkdir /dev/cpuctl/foreground
     mkdir /dev/cpuctl/foreground_window
