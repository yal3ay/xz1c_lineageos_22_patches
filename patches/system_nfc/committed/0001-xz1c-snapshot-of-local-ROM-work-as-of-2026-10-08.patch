diff --git a/src/adaptation/nfc_config.cc b/src/adaptation/nfc_config.cc
index f635fd50..6376b875 100644
--- a/src/adaptation/nfc_config.cc
+++ b/src/adaptation/nfc_config.cc
@@ -65,6 +65,28 @@ std::string findConfigPath() {
 
 }  // namespace
 
+namespace {
+// 【本项目】见 nfc_config.h 的 setOverride。
+std::map<std::string, unsigned>& overrides() {
+  static std::map<std::string, unsigned> sOverrides;
+  return sOverrides;
+}
+}  // namespace
+
+void NfcConfig::setOverride(const std::string& key, unsigned value) {
+  overrides()[key] = value;
+  ConfigValue v(value);
+  getInstance().config_.setConfig(key, v);
+}
+
+void NfcConfig::clearOverride(const std::string& key) {
+  if (overrides().erase(key) > 0) {
+    // 重新加载一遍，让该项回到配置文件 / HAL 给出的原值。
+    getInstance().config_.clear();
+    getInstance().loadConfig();
+  }
+}
+
 void NfcConfig::loadConfig() {
   string config_path = findConfigPath();
   CHECK(config_path != "");
@@ -76,6 +98,10 @@ void NfcConfig::loadConfig() {
   for (auto config : configMap) {
     config_.addConfig(config.first, config.second);
   }
+  for (auto& o : overrides()) {
+    ConfigValue v(o.second);
+    config_.setConfig(o.first, v);
+  }
 }
 
 NfcConfig::NfcConfig() { loadConfig(); }
diff --git a/src/include/nfc_config.h b/src/include/nfc_config.h
index 2ed5c325..e4fad123 100644
--- a/src/include/nfc_config.h
+++ b/src/include/nfc_config.h
@@ -50,6 +50,8 @@
 #define NAME_NFA_POLL_BAIL_OUT_MODE "NFA_POLL_BAIL_OUT_MODE"
 #define NAME_PRESENCE_CHECK_ALGORITHM "PRESENCE_CHECK_ALGORITHM"
 #define NAME_NFA_PROPRIETARY_CFG "NFA_PROPRIETARY_CFG"
+// 【本项目】门禁卡模拟时 NFC-A 监听用的 SAK（LA_SEL_INFO）。只用 setOverride 设置，不放配置文件。
+#define NAME_XZ1C_LA_SEL_INFO "XZ1C_LA_SEL_INFO"
 #define NAME_DEFAULT_OFFHOST_ROUTE "DEFAULT_OFFHOST_ROUTE"
 #define NAME_OFFHOST_ROUTE_ESE "OFFHOST_ROUTE_ESE"
 #define NAME_OFFHOST_ROUTE_UICC "OFFHOST_ROUTE_UICC"
@@ -82,6 +84,11 @@ class NfcConfig {
   static std::vector<uint8_t> getBytes(const std::string& key);
   static void clear();
 
+  // 【本项目】运行时覆盖某个配置项（例如开启系统门禁卡模拟时把 DEFAULT_OFFHOST_ROUTE
+  // 改到主机）。覆盖值在每次 loadConfig 时最后写入，所以 clear()+重新加载后仍然有效。
+  static void setOverride(const std::string& key, unsigned value);
+  static void clearOverride(const std::string& key);
+
  private:
   void loadConfig();
   static NfcConfig& getInstance();
diff --git a/src/nfa/dm/nfa_dm_discover.cc b/src/nfa/dm/nfa_dm_discover.cc
