 #include "nfa_dm_int.h"
 
 #if (NFC_NFCEE_INCLUDED == TRUE)
@@ -367,6 +368,13 @@ static tNFA_STATUS nfa_dm_set_rf_listen_mode_config(
     }
   }
 
+  // 【本项目】系统门禁卡模拟：门禁读卡器按 MIFARE Classic（SAK 0x08）认卡。
+  // 默认的 0x20（ISO-DEP）会让读卡器改走 RATS/ISO-DEP，拿不到数据就断场，
+  // 实测只偶尔开门一次、之后连续刷不开。开启门禁卡时由 NativeNfcManager 覆盖。
+  if (NfcConfig::hasKey(NAME_XZ1C_LA_SEL_INFO)) {
+    sens_info = (uint8_t)NfcConfig::getUnsigned(NAME_XZ1C_LA_SEL_INFO);
+  }
+
   p = params;
 
