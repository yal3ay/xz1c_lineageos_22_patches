+    /**
+     * Binder calls arrive with the caller's UID. Charging control writes through
+     * the system-server "android" context, so retaining a remote app's identity
+     * makes the settings provider reject the package/UID pair. Run mutations as
+     * system_server and always restore the original identity afterwards.
+     */
+    private boolean runAsSystem(BooleanSupplier operation) {
+        final long token = Binder.clearCallingIdentity();
+        try {
+            return operation.getAsBoolean();
+        } finally {
+            Binder.restoreCallingIdentity(token);
+        }
+    }
+
     /* Service */
     private final IBinder mService = new IHealthInterface.Stub() {
         @Override
