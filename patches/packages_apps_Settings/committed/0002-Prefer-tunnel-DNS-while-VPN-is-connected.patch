diff --git a/src/com/android/settings/network/PrivateDnsPreferenceController.java b/src/com/android/settings/network/PrivateDnsPreferenceController.java
index 46c822dbbcc..193476d4629 100644
--- a/src/com/android/settings/network/PrivateDnsPreferenceController.java
+++ b/src/com/android/settings/network/PrivateDnsPreferenceController.java
@@ -32,6 +32,7 @@ import android.net.ConnectivityManager.NetworkCallback;
 import android.net.ConnectivitySettingsManager;
 import android.net.LinkProperties;
 import android.net.Network;
+import android.net.NetworkCapabilities;
 import android.net.Uri;
 import android.os.Handler;
 import android.os.Looper;
@@ -73,6 +74,7 @@ public class PrivateDnsPreferenceController extends BasePreferenceController
     private final ContentObserver mSettingsObserver;
     private final ConnectivityManager mConnectivityManager;
     private LinkProperties mLatestLinkProperties;
+    private NetworkCapabilities mLatestNetworkCapabilities;
     private Preference mPreference;
 
     public PrivateDnsPreferenceController(Context context) {
@@ -112,6 +114,7 @@ public class PrivateDnsPreferenceController extends BasePreferenceController
         final Network defaultNetwork = mConnectivityManager.getActiveNetwork();
         if (defaultNetwork != null) {
             mLatestLinkProperties = mConnectivityManager.getLinkProperties(defaultNetwork);
+            mLatestNetworkCapabilities = mConnectivityManager.getNetworkCapabilities(defaultNetwork);
         }
         mConnectivityManager.registerDefaultNetworkCallback(mNetworkCallback, mHandler);
     }
@@ -128,6 +131,10 @@ public class PrivateDnsPreferenceController extends BasePreferenceController
         final ContentResolver cr = mContext.getContentResolver();
         final int mode = ConnectivitySettingsManager.getPrivateDnsMode(mContext);
         final LinkProperties lp = mLatestLinkProperties;
+        if (mode != PRIVATE_DNS_MODE_OFF && mLatestNetworkCapabilities != null
+                && mLatestNetworkCapabilities.hasTransport(NetworkCapabilities.TRANSPORT_VPN)) {
+            return res.getString(R.string.private_dns_vpn_override);
+        }
         final List<InetAddress> dnses = (lp == null) ? null : lp.getValidatedPrivateDnsServers();
         final boolean dnsesResolved = !ArrayUtils.isEmpty(dnses);
         switch (mode) {
@@ -186,6 +193,11 @@ public class PrivateDnsPreferenceController extends BasePreferenceController
     }
 
     private final NetworkCallback mNetworkCallback = new NetworkCallback() {
+        @Override
+        public void onCapabilitiesChanged(Network network, NetworkCapabilities capabilities) {
+            mLatestNetworkCapabilities = capabilities;
+            if (mPreference != null) updateState(mPreference);
+        }
         @Override
         public void onLinkPropertiesChanged(Network network, LinkProperties lp) {
             mLatestLinkProperties = lp;
@@ -196,6 +208,7 @@ public class PrivateDnsPreferenceController extends BasePreferenceController
         @Override
         public void onLost(Network network) {
             mLatestLinkProperties = null;
+            mLatestNetworkCapabilities = null;
             if (mPreference != null) {
                 updateState(mPreference);
             }
