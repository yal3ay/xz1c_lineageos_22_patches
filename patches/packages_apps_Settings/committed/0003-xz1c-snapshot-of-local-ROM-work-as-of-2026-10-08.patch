+ */
+
+package com.android.settings.nfc;
+
+import android.os.Bundle;
+
+import com.android.settings.SubSettings;
+
+/**
+ * 【本项目】门禁卡管理页的直达入口：SystemUI 的 NFC 磁贴长按打开它。
+ *
+ * 继承 SubSettings 而不是 SettingsActivity：后者只放行 SettingsGateway 白名单里的
+ * fragment，SubSettings 放行所有 fragment。
+ */
+public class AccessCardsActivity extends SubSettings {
+    @Override
+    protected void onCreate(Bundle savedState) {
+        if (getIntent().getStringExtra(EXTRA_SHOW_FRAGMENT) == null) {
+            getIntent().putExtra(EXTRA_SHOW_FRAGMENT, AccessCardsFragment.class.getName());
+        }
+        super.onCreate(savedState);
+    }
+}
