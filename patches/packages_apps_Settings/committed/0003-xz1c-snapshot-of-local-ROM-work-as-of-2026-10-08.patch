@@ -0,0 +1,557 @@
+/*
+ * SPDX-FileCopyrightText: 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.nfc;
+
+import android.app.Activity;
+import android.app.AlertDialog;
+import android.app.settings.SettingsEnums;
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.graphics.Color;
+import android.graphics.Typeface;
+import android.graphics.drawable.GradientDrawable;
+import android.nfc.NfcAdapter;
+import android.nfc.Tag;
+import android.os.Bundle;
+import android.provider.Settings;
+import android.text.InputType;
+import android.util.TypedValue;
+import android.view.Gravity;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.EditText;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import com.android.settings.R;
+import com.android.settings.core.InstrumentedFragment;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.util.ArrayList;
+import java.util.HexFormat;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * 【本项目】系统内置门禁卡 —— 卡片式管理页（仿第三方「NFC 卡模拟」的界面）。
+ *
+ * 模拟本身在 NFC 服务里做（packages/apps/Nfc：NativeNfcManager.doSetEmulatedUid →
+ * 每次 NFC 启动把卡号写进 NCI 参数 0x33 LA_NFCID1，A/B 类默认路由改到主机），
+ * 这里只负责管理卡片：
+ *
+ *   当前卡号 → Settings.Global "nfc_emulated_uid"（NFC 服务读它；为空 = 不模拟）
+ *   卡片列表 → Settings.Secure "nfc_access_cards"，JSON [{name, uid, color}]。
+ *              放系统设置是为了让 SystemUI 的 NFC 磁贴能读（副标题显示卡名、点一下选卡）。
+ *              这是非公开设置项，Android 12+ 的第三方应用读不到。
+ *              （早期版本存在本应用 SharedPreferences，首次读取时自动迁移过来。）
+ *
+ * 改了 nfc_emulated_uid 后，NFC 服务自己监听到变化会重启 NFC 栈，约 2 秒后生效。
+ */
+public class AccessCardsFragment extends InstrumentedFragment {
+
+    static final String SETTING_EMULATED_UID = "nfc_emulated_uid";
+    static final String SETTING_ACCESS_CARDS = "nfc_access_cards";
+    private static final String PREFS = "nfc_access_cards";
+    private static final String KEY_CARDS = "cards";
+
+    private static final int[][] COLORS = {
+            {0xFF7CB518, 0xFFA3E635},   // 绿（与卡模拟器同色）
+            {0xFF2563EB, 0xFF60A5FA},   // 蓝
+            {0xFFEA580C, 0xFFFB923C},   // 橙
+            {0xFF7C3AED, 0xFFA78BFA},   // 紫
+            {0xFFDC2626, 0xFFF87171},   // 红
+            {0xFF0F766E, 0xFF2DD4BF},   // 青
+    };
+
+    static final class Card {
+        String name;
+        String uid;   // 大写十六进制，无分隔符
+        int color;
+    }
+
+    private LinearLayout mList;
+    private final List<Card> mCards = new ArrayList<>();
+    private AlertDialog mReadDialog;
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.NFC_PAYMENT;
+    }
+
+    @Override
+    public View onCreateView(LayoutInflater inflater, ViewGroup container, Bundle saved) {
+        final Context ctx = requireContext();
+        final ScrollView scroll = new ScrollView(ctx);
+        mList = new LinearLayout(ctx);
+        mList.setOrientation(LinearLayout.VERTICAL);
+        final int pad = dp(16);
+        mList.setPadding(pad, dp(8), pad, pad);
+        scroll.addView(mList);
+        return scroll;
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        requireActivity().setTitle(R.string.nfc_access_cards_title);
+        load();
+        render();
+    }
+
+    @Override
+    public void onPause() {
+        super.onPause();
+        stopReading();
+    }
+
+    // ---------------------------------------------------------------- 存取
+
+    // 卡片数据的读写（SystemUI 的 NFC 磁贴按同样的键名直接读 Settings.Global / Secure）。
+
+    private static SharedPreferences prefs(Context ctx) {
+        return ctx.createDeviceProtectedStorageContext()
+                .getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    /** 读卡片列表；当前在用的卡号（例如之前用 adb 设过的）若不在列表里，补成一张卡。 */
+    static List<Card> loadCards(Context ctx) {
+        final List<Card> cards = new ArrayList<>();
+        String json = Settings.Secure.getString(ctx.getContentResolver(), SETTING_ACCESS_CARDS);
+        if (json == null) {
+            // 迁移旧版本存在 SharedPreferences 里的列表
+            json = prefs(ctx).getString(KEY_CARDS, null);
+            if (json != null) {
+                Settings.Secure.putString(ctx.getContentResolver(), SETTING_ACCESS_CARDS, json);
+                prefs(ctx).edit().remove(KEY_CARDS).apply();
+            }
+        }
+        try {
+            final JSONArray arr = new JSONArray(json == null ? "[]" : json);
+            for (int i = 0; i < arr.length(); i++) {
+                final JSONObject o = arr.getJSONObject(i);
+                final Card c = new Card();
+                c.name = o.optString("name");
+                c.uid = normalize(o.optString("uid"));
+                c.color = o.optInt("color", i % COLORS.length);
+                if (c.uid != null) cards.add(c);
+            }
+        } catch (JSONException ignored) {
+        }
+        final String current = currentUid(ctx);
+        if (current != null && indexOf(cards, current) < 0) {
+            final Card c = new Card();
+            c.name = ctx.getString(R.string.nfc_access_card_default_name);
+            c.uid = current;
+            c.color = 0;
+            cards.add(0, c);
+            saveCards(ctx, cards);
+        }
+        return cards;
+    }
+
+    static void saveCards(Context ctx, List<Card> cards) {
+        final JSONArray arr = new JSONArray();
+        for (Card c : cards) {
+            try {
+                arr.put(new JSONObject().put("name", c.name).put("uid", c.uid)
+                        .put("color", c.color));
+            } catch (JSONException ignored) {
+            }
+        }
+        Settings.Secure.putString(ctx.getContentResolver(), SETTING_ACCESS_CARDS, arr.toString());
+    }
+
+    static String currentUid(Context ctx) {
+        return normalize(Settings.Global.getString(ctx.getContentResolver(),
+                SETTING_EMULATED_UID));
+    }
+
+    /** 写当前卡号；NFC 服务监听到后自己重启 NFC 栈，约 2 秒生效。 */
+    static void setCurrentUid(Context ctx, String uid) {
+        Settings.Global.putString(ctx.getContentResolver(), SETTING_EMULATED_UID, uid);
+        Toast.makeText(ctx, uid == null
+                ? R.string.nfc_access_card_disabled_toast
+                : R.string.nfc_access_card_applied_toast, Toast.LENGTH_SHORT).show();
+    }
+
+    static int indexOf(List<Card> cards, String uid) {
+        for (int i = 0; i < cards.size(); i++) {
+            if (cards.get(i).uid.equals(uid)) return i;
+        }
+        return -1;
+    }
+
+    private void load() {
+        mCards.clear();
+        mCards.addAll(loadCards(requireContext()));
+    }
+
+    private void save() {
+        saveCards(requireContext(), mCards);
+    }
+
+    private String currentUid() {
+        return currentUid(requireContext());
+    }
+
+    private void setCurrentUid(String uid) {
+        setCurrentUid(requireContext(), uid);
+    }
+
+    /** 只接受 4 / 7 / 10 字节（8 / 14 / 20 位十六进制），其余返回 null。 */
+    static String normalize(String s) {
+        if (s == null) return null;
+        final String hex = s.replaceAll("[^0-9A-Fa-f]", "").toUpperCase(Locale.ROOT);
+        return (hex.length() == 8 || hex.length() == 14 || hex.length() == 20) ? hex : null;
+    }
+
+    private static String pretty(String uid) {
+        final StringBuilder sb = new StringBuilder();
+        for (int i = 0; i < uid.length(); i += 2) {
+            if (i > 0) sb.append(' ');
+            sb.append(uid, i, i + 2);
+        }
+        return sb.toString();
+    }
+
+    // ---------------------------------------------------------------- 界面
+
+    // ---------------------------------------------------------------- 钱包式叠放
+    //
+    // 所有卡叠成一摞：每张都是完整大小，但依次下移 STRIP_DP，后面的压住前面的，只露出顶部
+    // 一条（名字 + 颜色）。当前卡排在最后 = 最前面，完整可见。点任意一张露出来的卡条 →
+    // 它成为当前卡，带动画滑到最前面，其余卡收回叠着。视图按卡号复用，这样 ChangeBounds
+    // 才有动画可做。
+
+    private static final int CARD_DP = 190;
+    private static final int STRIP_DP = 58;
+
+    private FrameLayout mStack;
+    private TextView mHint;
+    private final java.util.Map<String, View> mCardViews = new java.util.HashMap<>();
+
+    private void render() {
+        mList.removeAllViews();
+        mCardViews.clear();
+        final Context ctx = requireContext();
+
+        mHint = new TextView(ctx);
+        mHint.setTextSize(TypedValue.COMPLEX_UNIT_SP, 14);
+        mHint.setPadding(dp(4), dp(4), dp(4), dp(12));
+        mList.addView(mHint);
+
+        mStack = new FrameLayout(ctx);
+        mStack.setClipChildren(false);
+        mList.addView(mStack, new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        for (Card c : mCards) {
+            final View v = cardView(c);
+            mCardViews.put(c.uid, v);
+            mStack.addView(v);
+        }
+        mList.addView(addButton());
+        layoutStack(false);
+    }
+
+    /** 按当前卡重新排这一摞；animate 为 true 时带滑动动画。 */
+    private void layoutStack(boolean animate) {
+        if (mStack == null) return;
+        final String current = currentUid();
+        mHint.setText(current == null ? R.string.nfc_access_card_hint_off
+                : R.string.nfc_access_card_hint_on);
+        final List<Card> order = new ArrayList<>();
+        Card active = null;
+        for (Card c : mCards) {
+            if (active == null && c.uid.equals(current)) active = c;
+            else order.add(c);
+        }
+        if (active != null) order.add(active);   // 当前卡放最后 = 叠在最前面
+
+        if (animate) {
+            android.transition.TransitionManager.beginDelayedTransition(mStack,
+                    new android.transition.ChangeBounds().setDuration(260));
+        }
+        for (int i = 0; i < order.size(); i++) {
+            final Card c = order.get(i);
+            final View v = mCardViews.get(c.uid);
+            if (v == null) continue;
+            final FrameLayout.LayoutParams lp = (FrameLayout.LayoutParams) v.getLayoutParams();
+            lp.topMargin = dp(i * STRIP_DP);
+            v.setLayoutParams(lp);
+            v.setTranslationZ(dp(i * 2));
+            final boolean isActive = c == active;
+            final View check = v.findViewWithTag("check");
+            if (check != null) check.setVisibility(isActive ? View.VISIBLE : View.INVISIBLE);
+            v.setElevation(dp(isActive ? 6 : 2));
+        }
+        final LinearLayout.LayoutParams slp = (LinearLayout.LayoutParams) mStack.getLayoutParams();
+        slp.height = order.isEmpty() ? 0 : dp((order.size() - 1) * STRIP_DP + CARD_DP);
+        mStack.setLayoutParams(slp);
+    }
+
+    private View cardView(Card c) {
+        final Context ctx = requireContext();
+        final FrameLayout card = new FrameLayout(ctx);
+        card.setLayoutParams(new FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, dp(CARD_DP), Gravity.TOP));
+        final int[] colors = COLORS[Math.floorMod(c.color, COLORS.length)];
+        final GradientDrawable bg = new GradientDrawable(
+                GradientDrawable.Orientation.BL_TR, colors);
+        bg.setCornerRadius(dp(18));
+        card.setBackground(bg);
+
+        final TextView name = new TextView(ctx);
+        name.setText(c.name);
+        name.setTextColor(Color.WHITE);
+        name.setTextSize(TypedValue.COMPLEX_UNIT_SP, 22);
+        name.setTypeface(Typeface.DEFAULT_BOLD);
+        final FrameLayout.LayoutParams nlp = new FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT,
+                Gravity.TOP | Gravity.START);
+        nlp.setMargins(dp(22), dp(16), dp(22), 0);
+        card.addView(name, nlp);
+
+        final TextView uid = new TextView(ctx);
+        uid.setText(pretty(c.uid));
+        uid.setTextColor(0xE6FFFFFF);
+        uid.setTextSize(TypedValue.COMPLEX_UNIT_SP, 16);
+        uid.setTypeface(Typeface.MONOSPACE);
+        final FrameLayout.LayoutParams ulp = new FrameLayout.LayoutParams(
+                ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT,
+                Gravity.BOTTOM | Gravity.START);
+        ulp.setMargins(dp(22), 0, 0, dp(22));
+        card.addView(uid, ulp);
+
+        final TextView check = new TextView(ctx);
+        check.setTag("check");
+        check.setText("✓");
+        check.setGravity(Gravity.CENTER);
+        check.setTextSize(TypedValue.COMPLEX_UNIT_SP, 22);
+        check.setTextColor(colors[0]);
+        final GradientDrawable circle = new GradientDrawable();
+        circle.setShape(GradientDrawable.OVAL);
+        circle.setColor(Color.WHITE);
+        check.setBackground(circle);
+        final FrameLayout.LayoutParams clp = new FrameLayout.LayoutParams(dp(46), dp(46),
+                Gravity.BOTTOM | Gravity.END);
+        clp.setMargins(0, 0, dp(18), dp(18));
+        card.addView(check, clp);
+
+        card.setOnClickListener(v -> {
+            if (c.uid.equals(currentUid())) {
+                new AlertDialog.Builder(ctx)
+                        .setTitle(c.name)
+                        .setMessage(R.string.nfc_access_card_disable_confirm)
+                        .setNegativeButton(android.R.string.cancel, null)
+                        .setPositiveButton(R.string.nfc_access_card_disable, (d, w) -> {
+                            setCurrentUid(null);
+                            layoutStack(true);
+                        })
+                        .show();
+            } else {
+                setCurrentUid(c.uid);
+                layoutStack(true);
+            }
+        });
+        card.setOnLongClickListener(v -> {
+            showCardMenu(c);
+            return true;
+        });
+        return card;
+    }
+
+    private View addButton() {
+        final Context ctx = requireContext();
+        final TextView add = new TextView(ctx);
+        add.setText(R.string.nfc_access_card_add);
+        add.setGravity(Gravity.CENTER);
+        add.setTextSize(TypedValue.COMPLEX_UNIT_SP, 17);
+        final TypedValue tv = new TypedValue();
+        ctx.getTheme().resolveAttribute(android.R.attr.textColorSecondary, tv, true);
+        add.setTextColor(ctx.getColor(tv.resourceId != 0 ? tv.resourceId
+                : android.R.color.darker_gray));
+        final GradientDrawable dash = new GradientDrawable();
+        dash.setCornerRadius(dp(18));
+        dash.setStroke(dp(2), 0x66888888, dp(8), dp(6));
+        add.setBackground(dash);
+        add.setLayoutParams(new LinearLayout.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT, dp(64)));
+        ((LinearLayout.LayoutParams) add.getLayoutParams()).topMargin = dp(14);
+        add.setOnClickListener(v -> showEditDialog(null));
+        return add;
+    }
+
+    private void showCardMenu(Card c) {
+        final CharSequence[] items = {
+                getString(R.string.nfc_access_card_rename_edit),
+                getString(R.string.nfc_access_card_change_color),
+                getString(R.string.nfc_access_card_delete),
+        };
+        new AlertDialog.Builder(requireContext())
+                .setTitle(c.name)
+                .setItems(items, (d, which) -> {
+                    if (which == 0) {
+                        showEditDialog(c);
+                    } else if (which == 1) {
+                        c.color = (c.color + 1) % COLORS.length;
+                        save();
+                        render();
+                    } else {
+                        confirmDelete(c);
+                    }
+                })
+                .show();
+    }
+
+    private void confirmDelete(Card c) {
+        new AlertDialog.Builder(requireContext())
+                .setTitle(c.name)
+                .setMessage(R.string.nfc_access_card_delete_confirm)
+                .setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton(R.string.nfc_access_card_delete, (d, w) -> {
+                    if (c.uid.equals(currentUid())) setCurrentUid(null);
+                    mCards.remove(c);
+                    save();
+                    render();
+                })
+                .show();
+    }
+
+    /** 新增（c == null）或修改一张卡。 */
+    private void showEditDialog(Card c) {
+        final Context ctx = requireContext();
+        final LinearLayout box = new LinearLayout(ctx);
+        box.setOrientation(LinearLayout.VERTICAL);
+        box.setPadding(dp(22), dp(8), dp(22), 0);
+
+        final EditText name = new EditText(ctx);
+        name.setHint(R.string.nfc_access_card_name_hint);
+        name.setSingleLine();
+        final EditText uid = new EditText(ctx);
+        uid.setHint(R.string.nfc_access_card_uid_hint);
+        uid.setSingleLine();
+        uid.setInputType(InputType.TYPE_CLASS_TEXT
+                | InputType.TYPE_TEXT_FLAG_CAP_CHARACTERS
+                | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS);
+        uid.setTypeface(Typeface.MONOSPACE);
+        if (c != null) {
+            name.setText(c.name);
+            uid.setText(pretty(c.uid));
+        }
+        final Button read = new Button(ctx);
+        read.setText(R.string.nfc_access_card_read);
+        read.setOnClickListener(v -> startReading(uid));
+
+        box.addView(name);
+        box.addView(uid);
+        box.addView(read);
+
+        final AlertDialog dlg = new AlertDialog.Builder(ctx)
+                .setTitle(c == null ? R.string.nfc_access_card_add
+                        : R.string.nfc_access_card_rename_edit)
+                .setView(box)
+                .setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton(android.R.string.ok, null)
+                .create();
+        dlg.setOnDismissListener(d -> stopReading());
+        dlg.setOnShowListener(d -> dlg.getButton(AlertDialog.BUTTON_POSITIVE)
+                .setOnClickListener(v -> {
+                    final String hex = normalize(uid.getText().toString());
+                    if (hex == null) {
+                        uid.setError(getString(R.string.nfc_access_card_uid_invalid));
+                        return;
+                    }
+                    String n = name.getText().toString().trim();
+                    if (n.isEmpty()) n = getString(R.string.nfc_access_card_default_name);
+                    final String wasCurrent = currentUid();
+                    if (c == null) {
+                        final Card nc = new Card();
+                        nc.name = n;
+                        nc.uid = hex;
+                        nc.color = mCards.size() % COLORS.length;
+                        mCards.add(nc);
+                        // 第一张卡直接启用，省一步
+                        if (wasCurrent == null) setCurrentUid(hex);
+                    } else {
+                        final boolean active = c.uid.equals(wasCurrent);
+                        c.name = n;
+                        if (!c.uid.equals(hex)) {
+                            c.uid = hex;
+                            if (active) setCurrentUid(hex);
+                        }
+                    }
+                    save();
+                    render();
+                    dlg.dismiss();
+                }));
+        dlg.show();
+    }
+
+    // ---------------------------------------------------------------- 读实体卡
+
+    /** 用读卡模式读实体卡的卡号（NFCID / UID），填进输入框。 */
+    private void startReading(EditText target) {
+        final Activity act = getActivity();
+        final NfcAdapter nfc = NfcAdapter.getDefaultAdapter(act);
+        if (nfc == null || !nfc.isEnabled()) {
+            Toast.makeText(act, R.string.nfc_access_card_nfc_off, Toast.LENGTH_SHORT).show();
+            return;
+        }
+        nfc.enableReaderMode(act, (Tag tag) -> {
+            final byte[] id = tag.getId();
+            act.runOnUiThread(() -> {
+                stopReading();
+                final String hex = id == null ? null : normalize(HexFormat.of().formatHex(id));
+                if (hex == null) {
+                    Toast.makeText(act, R.string.nfc_access_card_read_fail,
+                            Toast.LENGTH_SHORT).show();
+                    return;
+                }
+                target.setText(pretty(hex));
+                target.setError(null);
+                Toast.makeText(act, R.string.nfc_access_card_read_ok, Toast.LENGTH_SHORT).show();
+            });
+        }, NfcAdapter.FLAG_READER_NFC_A | NfcAdapter.FLAG_READER_NFC_B
+                | NfcAdapter.FLAG_READER_NFC_F | NfcAdapter.FLAG_READER_NFC_V
+                | NfcAdapter.FLAG_READER_SKIP_NDEF_CHECK, null);
+        mReadDialog = new AlertDialog.Builder(act)
+                .setMessage(R.string.nfc_access_card_read_prompt)
+                .setNegativeButton(android.R.string.cancel, null)
+                .setOnDismissListener(d -> stopReading())
+                .show();
+    }
+
+    private void stopReading() {
+        final Activity act = getActivity();
+        if (act != null) {
+            final NfcAdapter nfc = NfcAdapter.getDefaultAdapter(act);
+            if (nfc != null) {
+                try {
+                    nfc.disableReaderMode(act);
+                } catch (RuntimeException ignored) {
+                }
+            }
+        }
+        if (mReadDialog != null) {
+            final AlertDialog d = mReadDialog;
+            mReadDialog = null;
+            if (d.isShowing()) d.dismiss();
+        }
+    }
+
+    private int dp(int v) {
+        return (int) TypedValue.applyDimension(TypedValue.COMPLEX_UNIT_DIP, v,
+                getResources().getDisplayMetrics());
+    }
+}
