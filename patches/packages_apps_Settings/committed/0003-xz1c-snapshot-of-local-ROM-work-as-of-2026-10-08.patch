+package com.android.settings.fuelgauge;
+
+import android.accounts.Account;
+import android.accounts.AccountManager;
+import android.accounts.AuthenticatorDescription;
+import android.app.AlertDialog;
+import android.app.settings.SettingsEnums;
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.ResolveInfo;
+import android.os.Bundle;
+import android.provider.Settings;
+import android.util.Log;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+import androidx.preference.SwitchPreferenceCompat;
+
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+import com.android.settingslib.widget.FooterPreference;
+
+
+import java.text.Collator;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+
+/**
+ * 自启动管理 —— 按应用切断「应用自己把自己拉起来」的各条路。
+ *
+ * 【原理】Android 在开机完成后广播 {@link Intent#ACTION_BOOT_COMPLETED}，
+ * 应用通过在清单里注册接收器来接收它，从而实现自启。本页面列出所有注册了该广播
+ * 的应用，关闭开关即把它的全部开机接收器置为
+ * {@link PackageManager#COMPONENT_ENABLED_STATE_DISABLED}，广播便不会投递给它。
+ *
+ * 【为什么不是改 AMS】在 AMS 分发广播时按名单过滤覆盖面更广（还能挡住被其他应用
+ * 通过 Service/Provider 唤起的路径），但要动系统核心调度逻辑。这里先做确定可行的一层：
+ * 禁用组件这条路在本机实测验证过——禁用微信的 BootReceiver 后重启，微信零进程。
+ *
+ * 【拦三种手段】2026-09-26 在应用宝（com.tencent.android.qqdownloader）上实测摸清的：
+ *
+ *   ① 开机广播 BOOT_COMPLETED —— 最常见，禁其接收器 + 写系统名单（AMS 侧过滤）
+ *   ② 假账号认证器 AccountAuthenticator —— 应用注册一个空账号类型，
+ *      system_server 的 AccountManagerService 必须绑定它来枚举账号，
+ *      于是系统自己成了帮凶，把应用钉在 adj=100（不可回收）
+ *   ③ 同步适配器 SyncAdapter —— 同步框架定时唤醒，绕过电池优化（同步算系统行为）
+ *
+ * 实测数据（应用宝，只禁 ②③，①本来就已在名单里）：
+ *   禁用前：3 个进程 502MB，adj=100，强制停止后 60 秒内自己爬回来
+ *   禁用后：重启后 0 个进程 0MB
+ *   （中间还试过连同它的守护服务一起禁，效果反而不如只禁 ②③ —— 所以不去猜
+ *     哪个是「守护服务」，只切系统侧这两个入口，边界清楚、副作用小）
+ *
+ * 【挡不住的】应用被其他应用主动调用（分享、支付回调、SDK 查它的 ContentProvider）
+ * 而启动。那属于正常的应用间调用，堵了会坏事，不在本页面职责内。
+ *
+ * 【范围】只列第三方应用。系统应用不列 —— 实测它们开机时绝大多数不走 BOOT_COMPLETED，
+ * 而是被 system_server 绑定为服务、标记 persistent 直接拉起，或被 ContentProvider 唤起，
+ * 本功能对它们无效；列出来会让人以为关了就有用。
+ */
+public class AutoStartManagerFragment extends SettingsPreferenceFragment {
+
+    private static final String TAG = "AutoStartManager";
+    /** 与 BroadcastController 里的同名常量必须一致 —— 两边读写的是同一个键。 */
+    private static final String SETTING_AUTOSTART_BLOCKED_PACKAGES = "autostart_blocked_packages";
+
+    /** 账号认证器：注册它，system_server 就必须绑定该应用来枚举账号。 */
+    private static final String ACTION_ACCOUNT_AUTHENTICATOR =
+            "android.accounts.AccountAuthenticator";
+    /** 同步适配器：同步框架会定时唤醒它，绕过电池优化。 */
+    private static final String ACTION_SYNC_ADAPTER = "android.content.SyncAdapter";
+
+    /** 即便用户打开「显示系统应用」也绝不允许改动的包 —— 动了会导致设备不可用。 */
+    private static final List<String> PROTECTED_PACKAGES = List.of(
+            "android",
+            "com.android.systemui",
+            "com.android.phone",
+            "com.android.settings",
+            "com.android.providers.settings",
+            "com.android.permissioncontroller",
+            "com.android.nfc",
+            "com.android.bluetooth",
+            "com.android.se");
+
+    private PackageManager mPm;
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.FUELGAUGE_POWER_USAGE_MANAGE_BACKGROUND;
+    }
+
+    @Override
+    public void onCreate(Bundle icicle) {
+        super.onCreate(icicle);
+        mPm = getContext().getPackageManager();
+        addPreferencesFromResource(R.xml.autostart_manager);
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        rebuild();
+    }
+
+    /**
+     * 收集三类「自我拉起」组件，按包名归组。
+     *
+     * MATCH_DISABLED_COMPONENTS 必须带上 —— 否则已经被本页面关掉的应用会从列表里消失，
+     * 用户就再也打不开了。
+     */
+    private Map<String, List<ComponentName>> collectSelfStartComponents() {
+        final Map<String, List<ComponentName>> byPkg = new LinkedHashMap<>();
+        final int flags = PackageManager.MATCH_DISABLED_COMPONENTS
+                | PackageManager.MATCH_DIRECT_BOOT_AWARE
+                | PackageManager.MATCH_DIRECT_BOOT_UNAWARE;
+
+        // ① 开机广播接收器
+        for (ResolveInfo ri : mPm.queryBroadcastReceivers(
+                new Intent(Intent.ACTION_BOOT_COMPLETED), flags)) {
+            addIfEligible(byPkg, ri);
+        }
+        // ②③ 账号认证器 / 同步适配器（都是 Service）
+        for (String action : new String[]{ACTION_ACCOUNT_AUTHENTICATOR, ACTION_SYNC_ADAPTER}) {
+            for (ResolveInfo ri : mPm.queryIntentServices(new Intent(action), flags)) {
+                addIfEligible(byPkg, ri);
+            }
+        }
+        return byPkg;
+    }
+
+    /** 统一的过滤与归组：跳过受保护包和系统应用，其余按包名收进 map。 */
+    private void addIfEligible(Map<String, List<ComponentName>> byPkg, ResolveInfo ri) {
+        final android.content.pm.ComponentInfo ci =
+                ri.activityInfo != null ? ri.activityInfo : ri.serviceInfo;
+        if (ci == null) return;
+        final String pkg = ci.packageName;
+        if (PROTECTED_PACKAGES.contains(pkg)) return;
+        final ApplicationInfo ai = ci.applicationInfo;
+        if (ai == null) return;
+        // 系统应用一律不列。2026-09-23 实测：系统应用开机时绝大多数不是靠
+        // BOOT_COMPLETED 广播启动的，而是被 system_server 当作服务绑定、
+        // 标记 persistent 直接拉起，或被 ContentProvider 唤起。列出来只会误导。
+        if ((ai.flags & ApplicationInfo.FLAG_SYSTEM) != 0) return;
+        final ComponentName cn = new ComponentName(pkg, ci.name);
+        final List<ComponentName> list =
+                byPkg.computeIfAbsent(pkg, k -> new ArrayList<>());
+        if (!list.contains(cn)) list.add(cn);
+    }
+
+    /** 该应用用了哪几种手段，用于在列表里如实标出。 */
+    private String describeMechanisms(String pkg, List<ComponentName> comps) {
+        boolean boot = false, auth = false, sync = false;
+        final int flags = PackageManager.MATCH_DISABLED_COMPONENTS;
+        for (ResolveInfo ri : mPm.queryBroadcastReceivers(
+                new Intent(Intent.ACTION_BOOT_COMPLETED), flags)) {
+            if (ri.activityInfo != null && pkg.equals(ri.activityInfo.packageName)) boot = true;
+        }
+        for (ResolveInfo ri : mPm.queryIntentServices(
+                new Intent(ACTION_ACCOUNT_AUTHENTICATOR), flags)) {
+            if (ri.serviceInfo != null && pkg.equals(ri.serviceInfo.packageName)) auth = true;
+        }
+        for (ResolveInfo ri : mPm.queryIntentServices(
+                new Intent(ACTION_SYNC_ADAPTER), flags)) {
+            if (ri.serviceInfo != null && pkg.equals(ri.serviceInfo.packageName)) sync = true;
+        }
+        final StringBuilder sb = new StringBuilder();
+        if (boot) sb.append(getString(R.string.autostart_mech_boot));
+        if (auth) {
+            if (sb.length() > 0) sb.append(" \u00b7 ");
+            sb.append(getString(R.string.autostart_mech_account));
+        }
+        if (sync) {
+            if (sb.length() > 0) sb.append(" \u00b7 ");
+            sb.append(getString(R.string.autostart_mech_sync));
+        }
+        return sb.toString();
+    }
+
+    /** 读系统侧名单（方案 B）。应用无权改它，这是拦截的主力。 */
+    private Set<String> readBlockedPackages() {
+        final Set<String> set = new TreeSet<>();
+        String raw = null;
+        try {
+            raw = Settings.Global.getString(getContext().getContentResolver(),
+                    SETTING_AUTOSTART_BLOCKED_PACKAGES);
+        } catch (Exception e) {
+            Log.w(TAG, "读取自启名单失败", e);
+        }
+        if (raw != null) {
+            for (String t : raw.split(",")) {
+                final String pkg = t.trim();
+                if (!pkg.isEmpty()) set.add(pkg);
+            }
+        }
+        return set;
+    }
+
+    private void writeBlockedPackages(Set<String> set) {
+        try {
+            Settings.Global.putString(getContext().getContentResolver(),
+                    SETTING_AUTOSTART_BLOCKED_PACKAGES, String.join(",", set));
+        } catch (Exception e) {
+            Log.w(TAG, "写入自启名单失败", e);
+        }
+    }
+
+    /**
+     * 是否允许自启。
+     * 以系统名单为准 —— 它是应用改不了的那一层；组件状态只是双保险，
+     * 应用可能把自己的组件改回启用，不能拿它当判据。
+     */
+    private boolean isAutoStartAllowed(String pkg, Set<String> blocked,
+            List<ComponentName> receivers) {
+        return !blocked.contains(pkg);
+    }
+
+    /** 旧判据，仅用于显示「应用已自行恢复组件」这类提示。 */
+    private boolean anyReceiverEnabled(List<ComponentName> receivers) {
+        for (ComponentName cn : receivers) {
+            final int state = mPm.getComponentEnabledSetting(cn);
+            if (state == PackageManager.COMPONENT_ENABLED_STATE_ENABLED) return true;
+            // DEFAULT 表示沿用清单里的 android:enabled，绝大多数是 true。
+            if (state == PackageManager.COMPONENT_ENABLED_STATE_DEFAULT) return true;
+        }
+        return false;
+    }
+
+    /**
+     * 关闭自启（完整版）：三条路一起断。
+     *   ① 写系统名单 —— AMS 分发开机广播时据此拦截，应用无权修改（主力）
+     *   ② 禁开机接收器 —— 双保险；应用能改回去（实测微信会），但改不了 ①
+     *   ③ 禁账号认证器 + 同步适配器 —— 切断 system_server 被迫绑定它的那条路
+     *
+     * ③ 是 2026-09-26 加的。实测应用宝：只做 ①② 时它仍有 3 个进程 502MB 且 adj=100
+     * （不可回收）；加上 ③ 之后重启为 0 个进程。做过对照 —— 连它的守护服务一起禁
+     * 反而不如只断 ③，所以不去猜「哪个是守护服务」。
+     */
+    private void setAutoStartAllowed(String pkg, List<ComponentName> receivers, boolean allow) {
+        setBootBlocked(pkg, receivers, !allow);
+        setComponentsEnabled(selfStartServicesOf(pkg), allow);
+    }
+
+    /** 只处理开机广播这一条：系统名单 + 开机接收器。保留账号同步。 */
+    private void setBootBlocked(String pkg, List<ComponentName> receivers, boolean blocked) {
+        final Set<String> list = readBlockedPackages();
+        if (blocked) {
+            list.add(pkg);
+        } else {
+            list.remove(pkg);
+        }
+        writeBlockedPackages(list);
+        setComponentsEnabled(receivers, !blocked);
+    }
+
+    /** 该应用注册的账号认证器 / 同步适配器服务。 */
+    private List<ComponentName> selfStartServicesOf(String pkg) {
+        final List<ComponentName> out = new ArrayList<>();
+        final int flags = PackageManager.MATCH_DISABLED_COMPONENTS;
+        for (String action : new String[]{ACTION_ACCOUNT_AUTHENTICATOR, ACTION_SYNC_ADAPTER}) {
+            for (ResolveInfo ri : mPm.queryIntentServices(new Intent(action), flags)) {
+                if (ri.serviceInfo == null) continue;
+                if (!pkg.equals(ri.serviceInfo.packageName)) continue;
+                final ComponentName cn = new ComponentName(pkg, ri.serviceInfo.name);
+                if (!out.contains(cn)) out.add(cn);
+            }
+        }
+        return out;
+    }
+
+    private void setComponentsEnabled(List<ComponentName> comps, boolean enabled) {
+        final int st = enabled
+                ? PackageManager.COMPONENT_ENABLED_STATE_ENABLED
+                : PackageManager.COMPONENT_ENABLED_STATE_DISABLED;
+        for (ComponentName cn : comps) {
+            try {
+                // DONT_KILL_APP：不因为改组件状态而杀掉正在前台使用的应用。
+                mPm.setComponentEnabledSetting(cn, st, PackageManager.DONT_KILL_APP);
+            } catch (Exception e) {
+                Log.w(TAG, "设置组件状态失败: " + cn.flattenToShortString(), e);
+            }
+        }
+    }
+
+    /**
+     * 该应用的账号认证器下，有哪些【看起来是真的】账号。
+     *
+     * 判据不是猜组件名，而是查 AccountManager：先拿该包声明的认证器类型，
+     * 再列该类型下实际存在的账号，最后把 name 等于应用名的过滤掉 ——
+     * 那是保活专用的假账号（2026-09-26 本机实测：应用宝的账号 name="应用宝"，
+     * 抖音的 name="抖音"；而 Gmail 的 name 是 qpengf@gmail.com、
+     * Telegram 是手机号、Twitter 是用户名）。
+     *
+     * 读不到就返回空（当作没有真账号）—— 宁可少弹一次窗，也不要因为读账号失败
+     * 让用户关不掉一个流氓应用。
+     */
+    private List<String> realAccountsOf(String pkg) {
+        final List<String> out = new ArrayList<>();
+        try {
+            final AccountManager am = AccountManager.get(getContext());
+            final String label = String.valueOf(
+                    mPm.getApplicationLabel(mPm.getApplicationInfo(pkg, 0)));
+            for (AuthenticatorDescription d : am.getAuthenticatorTypes()) {
+                if (!pkg.equals(d.packageName)) continue;
+                for (Account a : am.getAccountsByType(d.type)) {
+                    if (a.name == null || a.name.equals(label)) continue;  // 假账号
+                    if (!out.contains(a.name)) out.add(a.name);
+                }
+            }
+        } catch (Exception e) {
+            Log.w(TAG, "读取账号失败: " + pkg, e);
+        }
+        return out;
+    }
+
+    /** 有真账号时先问清楚，给三个选项，别让用户在不知情的情况下弄坏同步。 */
+    private void confirmWithAccounts(String pkg, List<ComponentName> receivers,
+            List<String> accounts, SwitchPreferenceCompat pref) {
+        new AlertDialog.Builder(getContext())
+                .setTitle(mPm.getApplicationLabel(getApplicationInfoQuietly(pkg)))
+                .setMessage(getString(R.string.autostart_has_real_accounts,
+                        String.join("\n", accounts)))
+                .setNeutralButton(R.string.autostart_boot_only, (d, w) -> {
+                    setBootBlocked(pkg, receivers, true);   // 只挡开机广播，保留账号同步
+                    pref.setChecked(false);
+                })
+                .setPositiveButton(R.string.autostart_block_all, (d, w) -> {
+                    setAutoStartAllowed(pkg, receivers, false);
+                    pref.setChecked(false);
+                    rebuild();
+                })
+                .setNegativeButton(android.R.string.cancel, null)
+                .show();
+    }
+
+    private ApplicationInfo getApplicationInfoQuietly(String pkg) {
+        try {
+            return mPm.getApplicationInfo(pkg, 0);
+        } catch (Exception e) {
+            return new ApplicationInfo();
+        }
+    }
+
+    private void rebuild() {
+        final PreferenceScreen screen = getPreferenceScreen();
+        if (screen == null) return;
+        screen.removeAll();
+
+        final Context context = getPrefContext();
+        final Map<String, List<ComponentName>> byPkg = collectSelfStartComponents();
+        final Set<String> blocked = readBlockedPackages();
+
+        final List<Map.Entry<String, List<ComponentName>>> entries = new ArrayList<>(byPkg.entrySet());
+        final Collator collator = Collator.getInstance();
+        Collections.sort(entries, Comparator.comparing(
+                e -> labelOf(e.getKey()), collator::compare));
+
+        int allowed = 0;
+        for (Map.Entry<String, List<ComponentName>> e : entries) {
+            final String pkg = e.getKey();
+            final List<ComponentName> receivers = e.getValue();
+            final boolean on = isAutoStartAllowed(pkg, blocked, receivers);
+            if (on) allowed++;
+
+            final SwitchPreferenceCompat pref = new SwitchPreferenceCompat(context);
+            pref.setKey(pkg);
+            pref.setTitle(labelOf(pkg));
+            // 副标题：如实列出这个应用用了哪几种自我拉起手段。
+            // 只显示包名的话，用户看不出「为什么关了还在后台」——
+            // 应用宝就是靠账号认证器绕开开机广播那一层的。
+            final String mech = describeMechanisms(pkg, receivers);
+            if (!on && anyReceiverEnabled(receivers)) {
+                // 应用把自己的组件改回启用了；系统名单仍在拦，这里如实说明。
+                pref.setSummary(getString(R.string.autostart_blocked_by_system, mech));
+            } else {
+                pref.setSummary(mech.isEmpty() ? pkg : mech);
+            }
+            try {
+                pref.setIcon(mPm.getApplicationIcon(pkg));
+            } catch (PackageManager.NameNotFoundException ignored) {
+            }
+            pref.setChecked(on);
+            pref.setPersistent(false);
+            pref.setOnPreferenceChangeListener((p, newValue) -> {
+                final boolean allow = (Boolean) newValue;
+                if (allow) {
+                    setAutoStartAllowed(pkg, receivers, true);
+                    return true;
+                }
+                // 关闭时：先看它的账号认证器下有没有【真账号】。
+                // 抖音/应用宝那种假账号的 name 就是应用名本身，直接关掉即可；
+                // Gmail 那种 name 是邮箱地址，关掉会中断真实同步，必须先问。
+                final List<String> real = realAccountsOf(pkg);
+                if (real.isEmpty()) {
+                    setAutoStartAllowed(pkg, receivers, false);
+                    return true;
+                }
+                confirmWithAccounts(pkg, receivers, real, (SwitchPreferenceCompat) p);
+                return false;   // 先不改 UI，等用户在对话框里选
+            });
+            screen.addPreference(pref);
+        }
+
+        final FooterPreference footer = new FooterPreference(context);
+        footer.setTitle(getString(R.string.autostart_manager_footer, allowed, entries.size()));
+        footer.setSelectable(false);
+        screen.addPreference(footer);
+    }
+
+    private String labelOf(String pkg) {
+        try {
+            return mPm.getApplicationLabel(mPm.getApplicationInfo(pkg, 0)).toString();
+        } catch (PackageManager.NameNotFoundException e) {
+            return pkg;
+        }
+    }
+}
