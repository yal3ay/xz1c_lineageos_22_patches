+    <string name="dexopt_state_unknown">unknown</string>
+    <string name="dexopt_filter_verify">verify \u2014 not compiled, smallest</string>
+    <string name="dexopt_filter_speed_profile">speed-profile \u2014 compile the hot paths (recommended)</string>
+    <string name="dexopt_filter_speed">speed \u2014 full AOT, much larger and often slower</string>
+    <string name="dexopt_start">Compile</string>
+    <string name="dexopt_running_title">Compiling</string>
+    <string name="dexopt_running_fmt">%1$s \u2192 %2$s\n\n%3$d s elapsed.\n\nART reports no fine-grained progress for a single package, so only the elapsed time is shown. Do not leave this screen.</string>
