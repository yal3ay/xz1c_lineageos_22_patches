+
+package com.android.settings.fuelgauge;
+
+import android.app.AlertDialog;
+import android.app.AppGlobals;
+import android.app.settings.SettingsEnums;
+import android.content.Context;
+import android.content.DialogInterface;
+import android.content.pm.ApplicationInfo;
+import android.content.pm.IPackageManager;
+import android.content.pm.PackageManager;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.RemoteException;
+import android.os.SystemClock;
+import android.text.TextUtils;
+import android.util.Log;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.RadioButton;
+import android.widget.RadioGroup;
+import android.widget.ScrollView;
+
+import androidx.preference.Preference;
+import androidx.preference.PreferenceScreen;
+
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+import com.android.settingslib.widget.FooterPreference;
+
+import java.text.Collator;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Comparator;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicBoolean;
+
+/**
+ * 应用预编译（dexopt）管理 —— 选应用、选编译等级、看进度与结果。
+ *
+ * 【怎么触发编译】走 {@code IPackageManager#performDexOptMode}，就是
+ * {@code cmd package compile} 背后同一条路。它的权限检查是
+ * {@code isSystemOrRootOrShell()}，而设置应用跑在 {@code android.uid.system}，
+ * 所以能直接调，不需要为此新建系统服务。
+ *
+ * 【怎么读状态】编译等级只有 system_server 内部的 ArtManagerLocal 拿得到，
+ * 因此本项目在 {@code IPackageManager} 上补了 {@code getDexOptCompilerFilter}，
+ * 权限检查与上面一致。
+ *
+ * 【关于"进度"】{@code performDexOptMode} 是同步调用，**不提供细粒度进度**
+ * （ART Service 只对批量任务给进度回调）。所以这里显示的是"编译中 + 已用秒数"，
+ * 而不是百分比。做不出来的东西不假装做得出来。
+ *
+ * 【speed-profile 的陷阱】没有 profile 时它会**静默退回 verify**，而且接口照样
+ * 返回成功。这里的做法是编译完回读一次实际等级，与用户选的不一致就如实说明，
+ * 不靠猜也不靠去翻 /data/misc/profiles。
+ */
+public class DexOptManagerFragment extends SettingsPreferenceFragment {
+
+    private static final String TAG = "DexOptManager";
+
+    /** 用户可选的编译等级。顺序即界面顺序。 */
+    private static final String FILTER_VERIFY = "verify";
+    private static final String FILTER_SPEED_PROFILE = "speed-profile";
+    private static final String FILTER_SPEED = "speed";
+    private static final String[] FILTERS = {
+            FILTER_VERIFY, FILTER_SPEED_PROFILE, FILTER_SPEED};
+
+    private PackageManager mPm;
+    private IPackageManager mIPm;
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.FUELGAUGE_POWER_USAGE_MANAGE_BACKGROUND;
+    }
+
+    @Override
+    public void onCreate(Bundle icicle) {
+        super.onCreate(icicle);
+        mPm = getContext().getPackageManager();
+        mIPm = AppGlobals.getPackageManager();
+        addPreferencesFromResource(R.xml.dexopt_manager);
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        rebuild();
+    }
+
+    /** 返回 "<filter>|<reason>"，读不到返回 null。 */
+    private String queryStatus(String pkg) {
+        try {
+            return mIPm.getDexOptCompilerFilter(pkg);
+        } catch (RemoteException | SecurityException e) {
+            Log.w(TAG, "读取编译状态失败: " + pkg, e);
+            return null;
+        }
+    }
+
+    private static String filterOf(String status) {
+        if (TextUtils.isEmpty(status)) return "";
+        final int i = status.indexOf('|');
+        return i < 0 ? status : status.substring(0, i);
+    }
+
+    private static String reasonOf(String status) {
+        if (TextUtils.isEmpty(status)) return "";
+        final int i = status.indexOf('|');
+        return i < 0 ? "" : status.substring(i + 1);
+    }
+
+    /** 每次 rebuild 自增；后台查询回来时代数不对就丢弃，避免旧结果覆盖新结果。 */
+    private int mGeneration;
+
+    /**
+     * 查询放到后台线程，主线程只负责把结果摆上去。
+     *
+     * 2026-09-24 用户遇到「Settings isn't responding」：ANR 堆栈全停在主线程的
+     * getDexOptCompilerFilter —— 它要让 artd 逐个去看每个应用的 odex/vdex 文件，
+     * 装在 SD 卡（融卡）上的应用尤其慢，53 个应用串行查下来超过 5 秒。
+     */
+    private void rebuild() {
+        final int gen = ++mGeneration;
+        new Thread(() -> {
+            final List<ApplicationInfo> apps = new ArrayList<>();
+            for (ApplicationInfo ai : mPm.getInstalledApplications(0)) {
+                // 只列第三方应用：系统应用的 dexopt 由构建期 dexpreopt 决定，
+                // 运行时改它收益有限、风险不小（改坏了要重刷）。
+                if ((ai.flags & ApplicationInfo.FLAG_SYSTEM) != 0) continue;
+                apps.add(ai);
+            }
+            final List<CharSequence> labels = new ArrayList<>();
+            for (ApplicationInfo ai : apps) {
+                labels.add(mPm.getApplicationLabel(ai));
+            }
+            final Collator collator = Collator.getInstance();
+            final List<Integer> order = new ArrayList<>();
+            for (int i = 0; i < apps.size(); i++) order.add(i);
+            Collections.sort(order, (x, y) -> collator.compare(
+                    String.valueOf(labels.get(x)), String.valueOf(labels.get(y))));
+            final List<ApplicationInfo> sortedApps = new ArrayList<>();
+            final List<CharSequence> sortedLabels = new ArrayList<>();
+            final List<String> statuses = new ArrayList<>();
+            for (int i : order) {
+                sortedApps.add(apps.get(i));
+                sortedLabels.add(labels.get(i));
+                statuses.add(queryStatus(apps.get(i).packageName));
+            }
+            mHandler.post(() -> {
+                if (gen == mGeneration) populate(sortedApps, sortedLabels, statuses);
+            });
+        }, "dexopt-query").start();
+    }
+
+    private void populate(List<ApplicationInfo> apps, List<CharSequence> labels,
+            List<String> statuses) {
+        final PreferenceScreen screen = getPreferenceScreen();
+        if (screen == null || getContext() == null) return;
+        screen.removeAll();
+        final Context context = getPrefContext();
+
+        int optimized = 0;
+        for (int i = 0; i < apps.size(); i++) {
+            final ApplicationInfo ai = apps.get(i);
+            final String pkg = ai.packageName;
+            final String status = statuses.get(i);
+            final String filter = filterOf(status);
+            if (FILTER_SPEED_PROFILE.equals(filter) || FILTER_SPEED.equals(filter)) {
+                optimized++;
+            }
+
+            final Preference pref = new Preference(context);
+            pref.setKey(pkg);
+            pref.setTitle(labels.get(i));
+            pref.setSummary(TextUtils.isEmpty(filter)
+                    ? getString(R.string.dexopt_state_unknown)
+                    : getString(R.string.dexopt_state_fmt, filter, reasonOf(status)));
+            try {
+                pref.setIcon(mPm.getApplicationIcon(pkg));
+            } catch (PackageManager.NameNotFoundException ignored) {
+            }
+            pref.setOnPreferenceClickListener(p -> {
+                showFilterDialog(ai, filter);
+                return true;
+            });
+            screen.addPreference(pref);
+        }
+
+        final FooterPreference footer = new FooterPreference(context);
+        footer.setTitle(getString(R.string.dexopt_manager_footer, optimized, apps.size()));
+        footer.setSelectable(false);
+        screen.addPreference(footer);
+    }
+
+    private void showFilterDialog(ApplicationInfo ai, String current) {
+        final CharSequence[] items = {
+                getString(R.string.dexopt_filter_verify),
+                getString(R.string.dexopt_filter_speed_profile),
+                getString(R.string.dexopt_filter_speed),
+        };
+        int checked = -1;
+        for (int i = 0; i < FILTERS.length; i++) {
+            if (FILTERS[i].equals(current)) {
+                checked = i;
+                break;
+            }
+        }
+        final int[] picked = {checked};
+
+        // 不用 setSingleChoiceItems：它的列表项是固定行高的 CheckedTextView，选项文字
+        // 一折成两行，最后一项就压到「取消 / 编译」按钮上（2026-09-24 用户截图，英文系统
+        // 大字号下必现）。改成 ScrollView + RadioGroup，RadioButton 会随文字自动长高，
+        // 放不下时整块可滚动，不会再和按钮重叠。
+        final Context ctx = getContext();
+        final float dp = ctx.getResources().getDisplayMetrics().density;
+        final RadioGroup group = new RadioGroup(ctx);
+        final int padH = (int) (20 * dp);
+        group.setPadding(padH, (int) (8 * dp), padH, (int) (8 * dp));
+        for (int i = 0; i < items.length; i++) {
+            final RadioButton rb = new RadioButton(ctx);
+            rb.setId(View.generateViewId());
+            rb.setText(items[i]);
+            rb.setMinHeight((int) (48 * dp));
+            rb.setPadding((int) (8 * dp), (int) (6 * dp), 0, (int) (6 * dp));
+            final int which = i;
+            rb.setOnClickListener(v -> picked[0] = which);
+            group.addView(rb, new RadioGroup.LayoutParams(
+                    ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+            if (i == checked) {
+                group.check(rb.getId());
+            }
+        }
+        final ScrollView scroll = new ScrollView(ctx);
+        scroll.addView(group);
+
+        new AlertDialog.Builder(ctx)
+                .setTitle(mPm.getApplicationLabel(ai))
+                .setView(scroll)
+                .setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton(R.string.dexopt_start, (d, w) -> {
+                    if (picked[0] >= 0) {
+                        startCompile(ai, FILTERS[picked[0]]);
+                    }
+                })
+                .show();
+    }
+
+    private void startCompile(ApplicationInfo ai, String target) {
+        final String pkg = ai.packageName;
+        final CharSequence label = mPm.getApplicationLabel(ai);
+        final AtomicBoolean done = new AtomicBoolean(false);
+        final long t0 = SystemClock.elapsedRealtime();
+
+        final AlertDialog dialog = new AlertDialog.Builder(getContext())
+                .setTitle(R.string.dexopt_running_title)
+                .setMessage(getString(R.string.dexopt_running_fmt, label, target, 0))
+                .setCancelable(false)
+                .create();
+        dialog.show();
+
+        // 每秒刷新已用时间。没有细粒度进度可用，如实显示"已用 N 秒"。
+        final Runnable ticker = new Runnable() {
+            @Override
+            public void run() {
+                if (done.get() || !dialog.isShowing()) return;
+                final long sec = (SystemClock.elapsedRealtime() - t0) / 1000;
+                dialog.setMessage(getString(R.string.dexopt_running_fmt, label, target, sec));
+                mHandler.postDelayed(this, 1000);
+            }
+        };
+        mHandler.postDelayed(ticker, 1000);
+
+        new Thread(() -> {
+            boolean ok = false;
+            String err = null;
+            try {
+                // checkProfiles 参数在 A15 已被忽略；force=true 才能降级
+                //（speed → speed-profile 属降级，不加 force 会被静默拒绝还报成功）。
+                ok = mIPm.performDexOptMode(pkg, true /* checkProfiles */, target,
+                        true /* force */, true /* bootComplete */, null /* splitName */);
+            } catch (Exception e) {
+                Log.w(TAG, "编译失败: " + pkg, e);
+                err = String.valueOf(e.getMessage());
+            }
+            final boolean fOk = ok;
+            final String fErr = err;
+            final long sec = (SystemClock.elapsedRealtime() - t0) / 1000;
+            // 回读实际等级也是一次 artd 查询，同样不能放主线程。
+            final String actual = filterOf(queryStatus(pkg));
+            done.set(true);
+            mHandler.post(() -> {
+                if (dialog.isShowing()) dialog.dismiss();
+                if (getContext() == null) return;
+                showResult(label, target, fOk, fErr, sec, actual);
+                rebuild();
+            });
+        }, "dexopt-" + pkg).start();
+    }
+
+    private void showResult(CharSequence label, String target, boolean ok, String err,
+            long sec, String actual) {
+        final StringBuilder sb = new StringBuilder();
+        if (ok) {
+            sb.append(getString(R.string.dexopt_result_ok, sec, actual));
+            // speed-profile 无 profile 时会静默退回 verify，接口照样返回成功。
+            // 不猜、不去翻 /data/misc/profiles —— 直接回读实际等级来判断。
+            if (FILTER_SPEED_PROFILE.equals(target) && FILTER_VERIFY.equals(actual)) {
+                sb.append("\n\n").append(getString(R.string.dexopt_result_no_profile));
+            }
+        } else {
+            sb.append(getString(R.string.dexopt_result_fail, actual));
+            if (!TextUtils.isEmpty(err)) sb.append("\n\n").append(err);
+        }
+        new AlertDialog.Builder(getContext())
+                .setTitle(label)
+                .setMessage(sb.toString())
+                .setPositiveButton(android.R.string.ok, (DialogInterface d, int w) -> d.dismiss())
+                .show();
+    }
+}
