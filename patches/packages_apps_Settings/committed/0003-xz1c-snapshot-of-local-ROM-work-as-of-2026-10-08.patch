+    <string name="dexopt_result_fail">Failed. Current state: %1$s</string>
+    <string name="dexopt_result_no_profile">You chose speed-profile but the result is verify: this app has no usage profile yet, and ART silently falls back. Use the app for a while, then try again.</string>
+    <string name="dexopt_manager_footer">%1$d of %2$d apps are compiled (speed-profile or speed).\n\nOnly third-party apps are listed; system apps are decided at build time.\n\nMeasured on this device (WeChat, 195 MB apk): verify 5.8 MB / cold 1572 ms; speed-profile 44.6 MB / 1597 ms; speed 711 MB / 1798 ms. Full AOT is 16x larger and slower here, so speed-profile is usually the right choice.</string>
+    <!-- 【本项目】系统内置门禁卡 -->
+    <string name="nfc_access_cards_title">Access cards</string>
+    <string name="nfc_access_cards_summary">Built-in card emulation, no app or root needed</string>
+    <string name="nfc_access_card_default_name">Access card</string>
+    <string name="nfc_access_card_hint_on">Tap a card to use it. Works with the screen on or off — just hold the back of the phone to the reader. Long-press a card to edit it.</string>
+    <string name="nfc_access_card_hint_off">Emulation is off. Tap a card to turn it on.</string>
+    <string name="nfc_access_card_applied_toast">Card switched. NFC restarts, ready in about 2 seconds</string>
+    <string name="nfc_access_card_disabled_toast">Card emulation turned off</string>
+    <string name="nfc_access_card_disable">Turn off</string>
+    <string name="nfc_access_card_disable_confirm">Stop emulating this card?</string>
+    <string name="nfc_access_card_add">+ Add access card</string>
+    <string name="nfc_access_card_rename_edit">Edit</string>
+    <string name="nfc_access_card_change_color">Change color</string>
+    <string name="nfc_access_card_delete">Delete</string>
+    <string name="nfc_access_card_delete_confirm">Delete this card?</string>
+    <string name="nfc_access_card_name_hint">Name (e.g. Home, Office)</string>
+    <string name="nfc_access_card_uid_hint">Card number (UID), e.g. 04 A1 B2 C3</string>
+    <string name="nfc_access_card_uid_invalid">Enter 4, 7 or 10 bytes in hex</string>
+    <string name="nfc_access_card_read">Read from a physical card</string>
+    <string name="nfc_access_card_read_prompt">Hold the physical card against the back of the phone…</string>
+    <string name="nfc_access_card_read_ok">Card number read</string>
+    <string name="nfc_access_card_read_fail">Could not read a usable card number</string>
+    <string name="nfc_access_card_nfc_off">Turn on NFC first</string>
+    <string name="autostart_mech_boot">boot broadcast</string>
+    <string name="autostart_mech_account">account authenticator</string>
+    <string name="autostart_mech_sync">sync adapter</string>
+    <string name="autostart_has_real_accounts">This app has real accounts:\n\n%1$s\n\nIt registers an account authenticator, which is also how apps keep themselves alive. Blocking everything will stop these accounts from syncing.</string>
