@@ -28,6 +28,8 @@ import android.content.Context;
 import android.content.DialogInterface;
 import android.content.Intent;
 import android.net.ConnectivitySettingsManager;
+import android.net.Uri;
+import android.net.InetAddresses;
 import android.os.UserHandle;
 import android.os.UserManager;
 import android.provider.Settings;
@@ -75,8 +77,74 @@ public class PrivateDnsModeDialogPreference extends CustomDialogPreferenceCompat
     // Only used in Settings, update on additions to ConnectivitySettingsUtils
     private static final int PRIVATE_DNS_MODE_CLOUDFLARE = 4;
 
+    static final String ALIDNS_PROTOCOL_KEY = "xz1c_dns_protocol";
+    static final String ENDPOINT_KEY = "xz1c_dns_endpoint";
+    static final String ALIDNS_HOST = "dns.alidns.com";
+    private final Map<Integer, String> mEndpoints = new HashMap<>();
+    private static final int ALIDNS_DOT = 5;
+    private static final int ALIDNS_DOH = 6;
+    private static final int ALIDNS_DOH3 = 7;
+    private static final int ALIDNS_DOQ = 8;
+
+    static String aliProtocol(int mode) {
+        switch (mode) {
+            case ALIDNS_DOH: return "doh";
+            case ALIDNS_DOH3: return "doh3";
+            case ALIDNS_DOQ: return "doq";
+            default: return "dot";
+        }
+    }
+
+    static int aliLabel(String protocol) {
+        if ("doh".equals(protocol)) return R.string.private_dns_alidns_doh;
+        if ("doh3".equals(protocol)) return R.string.private_dns_alidns_doh3;
+        if ("doq".equals(protocol)) return R.string.private_dns_alidns_doq;
+        return R.string.private_dns_alidns_dot;
+    }
+
+    static Uri parseEndpoint(String input, String protocol) {
+        try {
+            input = input.trim();
+            final String scheme = "dot".equals(protocol) ? "tls"
+                    : "doq".equals(protocol) ? "quic" : "https";
+            if (!input.contains("://")) input = scheme + "://" + input;
+            // Android Uri tolerates malformed ports; validate syntax before saving.
+            final java.net.URI strictUri = java.net.URI.create(input);
+            if (strictUri.getHost() == null || strictUri.getRawAuthority().endsWith(":"))
+                return null;
+            Uri uri = Uri.parse(input);
+            final String host = uri.getHost();
+            if (!scheme.equals(uri.getScheme()) || host == null || host.isEmpty()
+                    || uri.getUserInfo() != null || uri.getFragment() != null
+                    || (!InternetDomainName.isValid(host) && !InetAddresses.isNumericAddress(host))
+                    || uri.getPort() == 0 || uri.getPort() > 65535) return null;
+            if ("https".equals(scheme)) {
+                if (uri.getPath() == null || uri.getPath().isEmpty())
+                    uri = uri.buildUpon().path("/dns-query").build();
+            } else if ((uri.getPath() != null && !uri.getPath().isEmpty()
+                    && !"/".equals(uri.getPath())) || uri.getQuery() != null) return null;
+            return uri;
+        } catch (IllegalArgumentException e) {
+            return null;
+        }
+    }
+
+    static boolean hasSelectedEndpoint(ContentResolver cr, String hostname) {
+        final String protocol = Settings.Global.getString(cr, ALIDNS_PROTOCOL_KEY);
+        if (!"dot".equals(protocol) && !"doh".equals(protocol)
+                && !"doh3".equals(protocol) && !"doq".equals(protocol)) return false;
+        final String endpoint = Settings.Global.getString(cr, ENDPOINT_KEY);
+        if (endpoint == null) return false;
+        final Uri uri = parseEndpoint(endpoint, protocol);
+        return uri != null && uri.getHost().equalsIgnoreCase(hostname);
+    }
+
     static {
         PRIVATE_DNS_MAP = new HashMap<>();
+        PRIVATE_DNS_MAP.put(ALIDNS_DOT, R.id.private_dns_alidns_dot);
+        PRIVATE_DNS_MAP.put(ALIDNS_DOH, R.id.private_dns_alidns_doh);
+        PRIVATE_DNS_MAP.put(ALIDNS_DOH3, R.id.private_dns_alidns_doh3);
+        PRIVATE_DNS_MAP.put(ALIDNS_DOQ, R.id.private_dns_alidns_doq);
         PRIVATE_DNS_MAP.put(PRIVATE_DNS_MODE_OFF, R.id.private_dns_mode_off);
         PRIVATE_DNS_MAP.put(PRIVATE_DNS_MODE_CLOUDFLARE, R.id.private_dns_mode_cloudflare);
         PRIVATE_DNS_MAP.put(PRIVATE_DNS_MODE_OPPORTUNISTIC, R.id.private_dns_mode_opportunistic);
@@ -153,19 +221,41 @@ public class PrivateDnsModeDialogPreference extends CustomDialogPreferenceCompat
                     ConnectivitySettingsManager.getPrivateDnsHostname(context);
             final String cloudflareHostname =
                     context.getString(R.string.private_dns_hostname_cloudflare);
-            if (privateDnsHostname.equals(cloudflareHostname)) {
+            if (hasSelectedEndpoint(contentResolver, privateDnsHostname)) {
+                final String protocol = Settings.Global.getString(contentResolver,
+                        ALIDNS_PROTOCOL_KEY);
+                mMode = "doh".equals(protocol) ? ALIDNS_DOH
+                        : "doh3".equals(protocol) ? ALIDNS_DOH3
+                        : "doq".equals(protocol) ? ALIDNS_DOQ : ALIDNS_DOT;
+            } else if (cloudflareHostname.equals(privateDnsHostname)) {
                 mMode = PRIVATE_DNS_MODE_CLOUDFLARE;
             }
         }
 
         mEditText = view.findViewById(R.id.private_dns_mode_provider_hostname);
         mEditText.addTextChangedListener(this);
-        mEditText.setText(getHostnameFromSettings(contentResolver));
+        final String storedEndpoint = Settings.Global.getString(contentResolver, ENDPOINT_KEY);
+        final String storedHostname = getHostnameFromSettings(contentResolver);
+        mEditText.setText(mMode >= ALIDNS_DOT && storedEndpoint != null ? storedEndpoint
+                : mMode == PRIVATE_DNS_MODE_PROVIDER_HOSTNAME && storedHostname != null
+                ? storedHostname : storedEndpoint != null && !storedEndpoint.isEmpty()
+                ? storedEndpoint : ALIDNS_HOST);
 
         mRadioGroup = view.findViewById(R.id.private_dns_radio_group);
         mRadioGroup.setOnCheckedChangeListener(this);
         mRadioGroup.check(PRIVATE_DNS_MAP.getOrDefault(mMode, R.id.private_dns_mode_opportunistic));
 
+        ((RadioButton) view.findViewById(R.id.private_dns_alidns_dot))
+                .setText(R.string.private_dns_alidns_dot);
+        ((RadioButton) view.findViewById(R.id.private_dns_alidns_doh))
+                .setText(R.string.private_dns_alidns_doh);
+        ((RadioButton) view.findViewById(R.id.private_dns_alidns_doh3))
+                .setText(R.string.private_dns_alidns_doh3);
+        ((RadioButton) view.findViewById(R.id.private_dns_alidns_doq))
+                .setText(R.string.private_dns_alidns_doq);
+        ((TextView) view.findViewById(R.id.private_dns_alidns_info))
+                .setText(R.string.private_dns_alidns_info);
+
         // Initial radio button text
         final RadioButton offRadioButton = view.findViewById(R.id.private_dns_mode_off);
         offRadioButton.setText(com.android.settingslib.R.string.private_dns_mode_off);
@@ -199,7 +289,17 @@ public class PrivateDnsModeDialogPreference extends CustomDialogPreferenceCompat
         if (which == DialogInterface.BUTTON_POSITIVE) {
             final Context context = getContext();
             int modeToSet = mMode;
-            if (mMode == PRIVATE_DNS_MODE_PROVIDER_HOSTNAME) {
+            if (mMode >= ALIDNS_DOT && mMode <= ALIDNS_DOQ) {
+                final String protocol = aliProtocol(mMode);
+                final Uri endpoint = parseEndpoint(mEditText.getText().toString(), protocol);
+                if (endpoint == null) return;
+                Settings.Global.putString(context.getContentResolver(), ENDPOINT_KEY,
+                        endpoint.toString());
+                ConnectivitySettingsManager.setPrivateDnsHostname(context, endpoint.getHost());
+                Settings.Global.putString(context.getContentResolver(), ALIDNS_PROTOCOL_KEY,
+                        aliProtocol(mMode));
+                modeToSet = PRIVATE_DNS_MODE_PROVIDER_HOSTNAME;
+            } else if (mMode == PRIVATE_DNS_MODE_PROVIDER_HOSTNAME) {
                 // Only clickable if hostname is valid, so we could save it safely
                 ConnectivitySettingsManager.setPrivateDnsHostname(context,
                         mEditText.getText().toString());
@@ -210,6 +310,9 @@ public class PrivateDnsModeDialogPreference extends CustomDialogPreferenceCompat
                 modeToSet = PRIVATE_DNS_MODE_PROVIDER_HOSTNAME;
             }
 
+            if (mMode < ALIDNS_DOT) {
+                Settings.Global.putString(context.getContentResolver(), ALIDNS_PROTOCOL_KEY, "");
+            }
             FeatureFactory.getFeatureFactory().getMetricsFeatureProvider().action(context,
                     SettingsEnums.ACTION_PRIVATE_DNS_MODE, modeToSet);
             ConnectivitySettingsManager.setPrivateDnsMode(context, modeToSet);
@@ -218,7 +321,19 @@ public class PrivateDnsModeDialogPreference extends CustomDialogPreferenceCompat
 
     @Override
     public void onCheckedChanged(RadioGroup group, int checkedId) {
-        if (checkedId == R.id.private_dns_mode_off) {
+        final int previousMode = mMode;
+        if (mEditText != null && previousMode >= ALIDNS_DOT) {
+            mEndpoints.put(previousMode, mEditText.getText().toString());
+        }
+        if (checkedId == R.id.private_dns_alidns_dot) {
+            mMode = ALIDNS_DOT;
+        } else if (checkedId == R.id.private_dns_alidns_doh) {
+            mMode = ALIDNS_DOH;
+        } else if (checkedId == R.id.private_dns_alidns_doh3) {
+            mMode = ALIDNS_DOH3;
+        } else if (checkedId == R.id.private_dns_alidns_doq) {
+            mMode = ALIDNS_DOQ;
+        } else if (checkedId == R.id.private_dns_mode_off) {
             mMode = PRIVATE_DNS_MODE_OFF;
         } else if (checkedId == R.id.private_dns_mode_cloudflare) {
             mMode = PRIVATE_DNS_MODE_CLOUDFLARE;
@@ -227,6 +342,28 @@ public class PrivateDnsModeDialogPreference extends CustomDialogPreferenceCompat
         } else if (checkedId == R.id.private_dns_mode_provider) {
             mMode = PRIVATE_DNS_MODE_PROVIDER_HOSTNAME;
         }
+        if (mEditText != null && mMode >= ALIDNS_DOT && previousMode != mMode) {
+            String text = mEndpoints.get(mMode);
+            if (text == null) {
+                text = mEditText.getText().toString();
+                final String oldProtocol = text.startsWith("tls://") ? "dot"
+                        : text.startsWith("quic://") ? "doq" : "doh";
+                final Uri old = parseEndpoint(text, oldProtocol);
+                if (old != null && text.contains("://")) {
+                    final String protocol = aliProtocol(mMode);
+                    final boolean https = "doh".equals(protocol) || "doh3".equals(protocol);
+                    final String scheme = https ? "https" : "dot".equals(protocol) ? "tls" : "quic";
+                    final boolean changedFamily = "https".equals(old.getScheme()) != https;
+                    text = old.buildUpon().scheme(scheme)
+                            .encodedAuthority(changedFamily && (old.getPort() == 443 || old.getPort() == 853)
+                                    ? old.getHost() : old.getEncodedAuthority())
+                            .path(https ? changedFamily ? "/dns-query" : old.getPath() : "")
+                            .encodedQuery(https && !changedFamily ? old.getEncodedQuery() : null)
+                            .build().toString();
+                }
+            }
+            mEditText.setText(text);
+        }
         updateDialogInfo();
     }
 
@@ -274,15 +411,20 @@ public class PrivateDnsModeDialogPreference extends CustomDialogPreferenceCompat
     }
 
     private void updateDialogInfo() {
-        final boolean modeProvider = PRIVATE_DNS_MODE_PROVIDER_HOSTNAME == mMode;
+        final boolean selectedProtocol = mMode >= ALIDNS_DOT && mMode <= ALIDNS_DOQ;
+        final boolean modeProvider = PRIVATE_DNS_MODE_PROVIDER_HOSTNAME == mMode || selectedProtocol;
+        if (mEditText != null && selectedProtocol) {
+            mEditText.setHint("doh".equals(aliProtocol(mMode)) || "doh3".equals(aliProtocol(mMode))
+                    ? "https://dns.alidns.com/dns-query" : "dns.alidns.com:853");
+        }
         if (mEditText != null) {
             mEditText.setEnabled(modeProvider);
         }
         final Button saveButton = getSaveButton();
         if (saveButton != null) {
-            saveButton.setEnabled(modeProvider
-                    ? InternetDomainName.isValid(mEditText.getText().toString())
-                    : true);
+            saveButton.setEnabled(selectedProtocol
+                    ? parseEndpoint(mEditText.getText().toString(), aliProtocol(mMode)) != null
+                    : modeProvider ? InternetDomainName.isValid(mEditText.getText().toString()) : true);
         }
     }
 }
