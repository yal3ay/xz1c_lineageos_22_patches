+// xz1c: HALs built against the Android 8/9 headers (e.g. Sony's msm8998 audio.primary) only
+// accept offload info whose version/size equal their own initializer; anything newer fails
+// adev_open_output_stream with "Unsupported Offload information", which breaks compress offload
+// and direct PCM (and with it Sony DSEE HX). Opt in with ro.vendor.audio.legacy_offload_info=true.
+// Only the vendor copy (loaded by the HAL service in front of the old HAL) may do this: the
+// system copy also converts HAL replies back for AudioFlinger, and Android 15's AIDL layer
+// rejects a 0.1 offload info there (every openOutput fails, AudioPolicyManager stays null).
+static bool useLegacyOffloadInfo() {
+#ifndef __ANDROID_VENDOR__
+    return false;
+#else
+    static const bool legacy = [] {
+        char value[PROP_VALUE_MAX] = {};
+        __system_property_get("ro.vendor.audio.legacy_offload_info", value);
+        return strcmp(value, "true") == 0 || strcmp(value, "1") == 0;
+    }();
+    return legacy;
+#endif
+}
+
 status_t HidlUtils::audioOffloadInfoToHal(const AudioOffloadInfo& offload,
                                           audio_offload_info_t* halOffload) {
     *halOffload = AUDIO_INFO_INITIALIZER;
+    if (useLegacyOffloadInfo()) {
+        // version 0.1 ended at .usage; the struct is 8-byte aligned (int64 duration_us)
+        halOffload->version = AUDIO_MAKE_OFFLOAD_INFO_VERSION(0, 1);
+        halOffload->size = (offsetof(audio_offload_info_t, encapsulation_mode) + 7) & ~7;
+    }
     halOffload->sample_rate = offload.sampleRateHz;
     halOffload->channel_mask = static_cast<audio_channel_mask_t>(offload.channelMask);
     halOffload->format = static_cast<audio_format_t>(offload.format);
