+// xz1c: the codec port (SLIM_0_RX: headphones and speaker) is configured by Sony's HAL on the
+// first write after standby. Read what it really was set to, off the write thread (opening the
+// mixer enumerates thousands of controls), and publish "rate/bits/uptime_ms" so the Hi-Fi
+// Audio app shows measured values. Re-read every 5 s while playing, and after any standby.
+namespace xz1c {
+std::atomic<int> gGeneration{0};
+std::mutex gLock;
+std::condition_variable gWake;
+bool gWanted = false;
+
+int rateOf(const char* name) {  // "KHZ_44P1" -> 44100, "KHZ_48" -> 48000
+    if (name == nullptr || strncmp(name, "KHZ_", 4) != 0) return 0;
+    const char* p = name + 4;
+    int whole = atoi(p);
+    const char* dot = strchr(p, 'P');
+    int frac = dot != nullptr ? atoi(dot + 1) : 0;
+    return whole * 1000 + frac * 100;
+}
+
+int bitsOf(const char* name) {  // "S16_LE" -> 16, "S24_3LE" -> 24
+    if (name == nullptr || name[0] != 'S') return 0;
+    return atoi(name + 1);
+}
+
+void worker() {
+    struct mixer* mixer = nullptr;
+    for (;;) {
+        {
+            std::unique_lock<std::mutex> l(gLock);
+            gWake.wait(l, [] { return gWanted; });
+            gWanted = false;
+        }
+        usleep(100 * 1000);  // let the HAL finish configuring the port
+        if (mixer == nullptr) mixer = mixer_open(0);
+        if (mixer == nullptr) continue;
+        struct mixer_ctl* rate = mixer_get_ctl_by_name(mixer, "SLIM_0_RX SampleRate");
+        struct mixer_ctl* format = mixer_get_ctl_by_name(mixer, "SLIM_0_RX Format");
+        if (rate == nullptr || format == nullptr) continue;
+        int hz = rateOf(mixer_ctl_get_enum_string(rate, mixer_ctl_get_value(rate, 0)));
+        int bits = bitsOf(mixer_ctl_get_enum_string(format, mixer_ctl_get_value(format, 0)));
+        if (hz <= 0 || bits <= 0) continue;
+        struct timespec now;
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        char value[PROPERTY_VALUE_MAX];
+        snprintf(value, sizeof(value), "%d/%d/%lld", hz, bits,
+                 (long long)now.tv_sec * 1000 + now.tv_nsec / 1000000);
+        property_set("vendor.xz1c.audio.chip", value);
+    }
+}
+
+void request() {
+    static std::once_flag started;
+    std::call_once(started, [] { std::thread(worker).detach(); });
+    {
+        std::lock_guard<std::mutex> l(gLock);
+        gWanted = true;
+    }
+    gWake.notify_one();
+}
