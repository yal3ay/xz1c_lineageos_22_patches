         if (ret && isProprietaryGetCapsSupported()) {
             mProprietaryCaps = NfcProprietaryCaps.createFromByteArray(getProprietaryCaps());
diff --git a/src/com/android/nfc/NfcService.java b/src/com/android/nfc/NfcService.java
index 5f3f10e3..22306e0a 100644
--- a/src/com/android/nfc/NfcService.java
+++ b/src/com/android/nfc/NfcService.java
@@ -1238,6 +1238,65 @@ public class NfcService implements DeviceHostListener, ForegroundUtils.Callback
                             R.array.tag_intent_blocked_app_list)));
         }
 
+        // 【本项目】系统内置门禁卡：设置里切换卡号（Settings.Global "nfc_emulated_uid"）后
+        // 让新卡号生效。卡号在 NFC 服务启动时下发（NativeNfcManager.applyEmulatedUidSetting），
+        // 而 RoutingOptionManager 也在启动时缓存默认 offhost 路由，开关模拟时单纯重开 NFC
+        // 不会刷新这个缓存 —— 所以结束本进程，由系统重新拉起（persistent，约 2 秒）。
+        // 2026-10-07：以前是直接 killProcess，HAL 还开着，回调打到已死的进程上，
+        // android.hardware.nfc@1.1-service 随即 SIGSEGV；两边同时重启后芯片里没有卡号，
+        // 门禁刷不开。现在先走正常关闭（TASK_DISABLE 会 deinitialize、关 HAL，
+        // 不改「NFC 开/关」的保存值），关完再结束进程，重启后照常打开并下发卡号。
+        mContext.getContentResolver().registerContentObserver(
+                Settings.Global.getUriFor("nfc_emulated_uid"),
+                false,
+                new ContentObserver(new Handler(Looper.getMainLooper())) {
+                    private boolean mRestarting = false;
+
+                    @Override
+                    public void onChange(boolean selfChange) {
+                        if (mRestarting) return;
+                        mRestarting = true;
+                        Log.i(TAG, "Emulated UID changed, shutting NFC down before restart");
+                        new Thread(() -> {
+                            try {
+                                new EnableDisableTask().execute(TASK_DISABLE)
+                                        .get(10, TimeUnit.SECONDS);
+                            } catch (Exception e) {
+                                Log.e(TAG, "NFC disable before restart failed", e);
+                            }
+                            Log.i(TAG, "Restarting NFC service for the new emulated UID");
+                            Process.killProcess(Process.myPid());
+                        }, "nfc-uid-restart").start();
+                    }
+                });
+
+        // 【本项目】开机后门禁卡号偶尔没写进 NFC 芯片（手动关开一次 NFC 即恢复）。
+        // NFC 不是 direct-boot 应用，进程在首次解锁后才起，错过 USER_UNLOCKED 广播；
+        // 所以在服务起来约 8 秒后，若设了门禁卡且 NFC 已开，就关开一次 NFC 重新下发卡号。
+        // 每个进程只做一次；NFC 还没开好就每 5 秒再看一次，最多 6 次。
+        final Handler reapplyHandler = new Handler(Looper.getMainLooper());
+        reapplyHandler.postDelayed(new Runnable() {
+            private int mTries = 0;
+
+            @Override
+            public void run() {
+                final String uid = Settings.Global.getString(
+                        mContext.getContentResolver(), "nfc_emulated_uid");
+                if (uid == null || uid.isEmpty()) return;
+                final boolean on;
+                synchronized (NfcService.this) {
+                    on = mState == NfcAdapter.STATE_ON;
+                }
+                if (!on) {
+                    if (++mTries < 6) reapplyHandler.postDelayed(this, 5000);
+                    return;
+                }
+                Log.i(TAG, "Access card set, restarting NFC once to re-apply the emulated UID");
+                new EnableDisableTask().execute(TASK_DISABLE);
+                new EnableDisableTask().execute(TASK_ENABLE);
+            }
+        }, 8000);
+
         Uri uri = Settings.Global.getUriFor(Constants.SETTINGS_SATELLITE_MODE_ENABLED);
         if (uri == null) {
             Log.e(TAG, "satellite mode key does not exist in Settings");
