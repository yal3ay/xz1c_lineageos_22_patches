 import android.sysprop.NfcProperties;
 import android.util.Log;
 
@@ -86,8 +87,39 @@ public class NativeNfcManager implements DeviceHost {
         initializeNativeStructure();
         mContext = context;
         mT4tNfceeMgr = new NativeT4tNfceeManager();
+        applyEmulatedUidSetting();
     }
 
+    /**
+     * 【本项目】系统内置门禁卡模拟：Settings.Global "nfc_emulated_uid" 存要模拟的卡号，
+     * 十六进制、4/7/10 字节（例如 "04A1B2C3"），为空或格式不对即不模拟。
+     *
+     * 构造时就下发一次：RoutingOptionManager 在 NFC 服务启动时读取默认 offhost 路由，
+     * 必须在那之前把覆盖值设好。每次 initialize() 前再下发一次，以便改了卡号后
+     * 重启 NFC 即生效。
+     */
+    static final String SETTING_EMULATED_UID = "nfc_emulated_uid";
+
+    private void applyEmulatedUidSetting() {
+        byte[] uid = null;
+        try {
+            final String hex = Settings.Global.getString(mContext.getContentResolver(),
+                    SETTING_EMULATED_UID);
+            if (hex != null) {
+                final String clean = hex.replaceAll("[^0-9A-Fa-f]", "");
+                if (clean.length() == 8 || clean.length() == 14 || clean.length() == 20) {
+                    uid = HexFormat.of().parseHex(clean);
+                }
+            }
+        } catch (RuntimeException e) {
+            Log.w(TAG, "Failed to read " + SETTING_EMULATED_UID, e);
+        }
+        Log.i(TAG, "emulated uid: " + (uid == null ? "off" : uid.length + " bytes"));
+        doSetEmulatedUid(uid);
+    }
+
+    private native void doSetEmulatedUid(byte[] uid);
+
     public native boolean initializeNativeStructure();
 
     private native boolean doDownload();
@@ -103,6 +135,7 @@ public class NativeNfcManager implements DeviceHost {
 
     @Override
