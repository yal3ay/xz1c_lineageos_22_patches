+/*******************************************************************************
+**
+** Function:        nfcManager_doSetEmulatedUid
+**
+** Description:     【本项目】设置 / 清除系统门禁卡模拟的卡号。必须在 doInitialize
+**                  之前调用；开启时把 A/B 类卡的默认路由改到主机（FeliCa 路由不动），
+**                  否则读卡器问到的是安全芯片而不是这个卡号。
+**
+*******************************************************************************/
+static void nfcManager_doSetEmulatedUid(JNIEnv* e, jobject, jbyteArray uid) {
+  gXz1cEmulatedUid.clear();
+  if (uid != nullptr) {
+    jsize len = e->GetArrayLength(uid);
+    if (len == 4 || len == 7 || len == 10) {
+      jbyte* b = e->GetByteArrayElements(uid, nullptr);
+      gXz1cEmulatedUid.assign((uint8_t*)b, (uint8_t*)b + len);
+      e->ReleaseByteArrayElements(uid, b, JNI_ABORT);
+    }
+  }
+  if (gXz1cEmulatedUid.empty()) {
+    NfcConfig::clearOverride(NAME_DEFAULT_OFFHOST_ROUTE);
+    NfcConfig::clearOverride(NAME_XZ1C_LA_SEL_INFO);
+  } else {
+    NfcConfig::setOverride(NAME_DEFAULT_OFFHOST_ROUTE, 0x00 /* host */);
+    // 4 字节卡号 + ATQA 0x0004 的门禁卡是 MIFARE Classic 1K，SAK 必须是 0x08。
+    if (gXz1cEmulatedUid.size() == 4) {
+      NfcConfig::setOverride(NAME_XZ1C_LA_SEL_INFO, 0x08);
+    } else {
+      NfcConfig::clearOverride(NAME_XZ1C_LA_SEL_INFO);
+    }
+  }
+  LOG(INFO) << StringPrintf("%s: emulation %s", __func__,
+                            gXz1cEmulatedUid.empty() ? "off" : "on");
 }
 
