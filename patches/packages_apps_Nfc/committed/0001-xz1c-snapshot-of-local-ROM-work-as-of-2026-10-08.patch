   // configure NFCC_CONFIG_CONTROL- NFCC allowed to manage RF configuration.
   nfcManager_configNfccConfigControl(true);
 
+  // 【本项目】系统内置门禁卡模拟：把卡号写进「作为 A 类卡被读时报出的 NFCID1」(0x33)。
+  // 与第三方卡模拟器在 libnfc-cxd22xx.conf 的 NFA_DM_START_UP_CFG 末尾追加
+  // 33:04:<UID> 是同一个参数，只是改为每次 NFC 启动时由系统下发，不需要 root / 模块。
+  if (!gXz1cEmulatedUid.empty()) {
