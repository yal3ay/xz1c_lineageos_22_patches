+    mXz1cHiresDirect = enabled;
+    PortHandleVector ports;
+    for (size_t i = 0; i < mOutputs.size(); ++i) {
+        const auto& desc = mOutputs[i];
+        const auto devices = desc->devices();
+        if (!xz1cIsDirectDevice(devices)) {
+            continue;
+        }
+        for (const auto& client : desc->clientsList(true /* activeOnly */)) {
+            const auto attr = client->attributes();
+            const auto config = client->config();
+            const bool media = (attr.usage == AUDIO_USAGE_MEDIA
+                    && (attr.content_type == AUDIO_CONTENT_TYPE_MUSIC
+                        || attr.content_type == AUDIO_CONTENT_TYPE_UNKNOWN
+                        || attr.content_type == AUDIO_CONTENT_TYPE_MOVIE))
+                    || (attr.usage == AUDIO_USAGE_UNKNOWN
+                        && attr.content_type == AUDIO_CONTENT_TYPE_MUSIC);
+            if (!media || !audio_is_linear_pcm(config.format)) continue;
+            if (enabled) {
+                const auto flags = client->flags();
+                if (((desc->mFlags & AUDIO_OUTPUT_FLAG_DIRECT) != 0) ||
+                        (flags != AUDIO_OUTPUT_FLAG_NONE && flags != AUDIO_OUTPUT_FLAG_DEEP_BUFFER)) {
+                    continue;
+                }
+                if (!(xz1cIsUsbAudio(devices)
+                      || config.sample_rate == 44100 || config.sample_rate == 48000
+                      || config.sample_rate == 88200
+                      || config.sample_rate == 96000 || config.sample_rate == 176400
+                      || config.sample_rate == 192000 || audio_bytes_per_sample(config.format) > 2)) {
+                    continue;
+                }
+            } else if (!((desc->mFlags & AUDIO_OUTPUT_FLAG_DIRECT) != 0) ||
+                    mXz1cAutoDirectSessions.count(client->session()) == 0) {
+                continue; // Do not tear down explicit direct or DSEE clients.
+            }
+            ports.push_back(client->portId());
+        }
+    }
+    if (!ports.empty()) {
+        ALOGI("xz1c: live AudioTrack direct=%d invalidate %zu tracks", enabled, ports.size());
+        mpClientInterface->invalidateTracks(ports);
+    }
+}
