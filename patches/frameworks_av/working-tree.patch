+// xz1c: system-wide DSEE HX (Hi-Fi Audio app). Applies only while music goes to wired
+// headphones: Sony's HAL runs DSEE nowhere else, and other routes keep compress offload.
+static bool xz1cIsLosslessAudio(const sp<AMessage>& format) {
+    AString mime;
+    return format != NULL && format->findString("mime", &mime)
+            && (!strcasecmp(mime.c_str(), MEDIA_MIMETYPE_AUDIO_FLAC)
+                || !strcasecmp(mime.c_str(), MEDIA_MIMETYPE_AUDIO_RAW)
+                || !strcasecmp(mime.c_str(), MEDIA_MIMETYPE_AUDIO_ALAC));
+}
+
+// xz1c: "MP3/128/44100/16/<session>" for the Hi-Fi Audio card ("Source: MP3 · 128 kbps").
+static void xz1cPublishSource(const sp<AMessage>& format, int session) {
+    AString mime;
+    if (format == NULL || !format->findString("mime", &mime)) return;
+    const char* m = mime.c_str();
+    const char* codec = !strcasecmp(m, MEDIA_MIMETYPE_AUDIO_MPEG) ? "MP3"
+            : !strcasecmp(m, MEDIA_MIMETYPE_AUDIO_AAC) ? "AAC"
+            : !strcasecmp(m, MEDIA_MIMETYPE_AUDIO_FLAC) ? "FLAC"
+            : !strcasecmp(m, MEDIA_MIMETYPE_AUDIO_ALAC) ? "ALAC"
+            : !strcasecmp(m, MEDIA_MIMETYPE_AUDIO_RAW) ? "PCM"
+            : !strcasecmp(m, MEDIA_MIMETYPE_AUDIO_VORBIS) ? "Vorbis"
+            : !strcasecmp(m, MEDIA_MIMETYPE_AUDIO_OPUS) ? "Opus"
+            : !strcasecmp(m, MEDIA_MIMETYPE_AUDIO_AC3) ? "AC3"
+            : !strcasecmp(m, MEDIA_MIMETYPE_AUDIO_EAC3) ? "EAC3"
+            : !strcasecmp(m, MEDIA_MIMETYPE_AUDIO_AMR_NB) ? "AMR"
+            : NULL;
+    if (codec == NULL) {
+        const char* slash = strchr(m, '/');
+        codec = slash != NULL ? slash + 1 : m;
+    }
+    int32_t bitrate = 0, rate = 0, bits = 0;
+    format->findInt32("bitrate", &bitrate);
+    format->findInt32("sample-rate", &rate);
+    format->findInt32("bits-per-sample", &bits);
+    property_set("sys.xz1c.audio.source", String8::format("%s/%d/%d/%d/%d", codec,
+            bitrate > 0 ? (bitrate + 500) / 1000 : 0, rate, bits, session).c_str());
+}
+
+static bool xz1cDseeGlobal() {
+    if (!property_get_bool("persist.sys.xz1c.dsee_global", false)) return false;
+    audio_attributes_t aa = AUDIO_ATTRIBUTES_INITIALIZER;
+    aa.usage = AUDIO_USAGE_MEDIA;
+    aa.content_type = AUDIO_CONTENT_TYPE_MUSIC;
+    AudioDeviceTypeAddrVector devices;
+    if (AudioSystem::getDevicesForAttributes(aa, &devices, false /* forVolume */) != OK) {
+        return false;
+    }
+    for (const auto& device : devices) {
+        if (device.mType == AUDIO_DEVICE_OUT_WIRED_HEADPHONE
+                || device.mType == AUDIO_DEVICE_OUT_WIRED_HEADSET) {
+            return true;
+        }
+    }
+    return false;
+}
