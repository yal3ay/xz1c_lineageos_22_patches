+// xz1c: float [-1, 1) -> int32, in place (same sample size). Lossless for 16/24-bit sources.
+static void xz1cFloatToI32(void *data, size_t bytes) {
+    float *f = (float *)data;
+    int32_t *i = (int32_t *)data;
+    for (size_t n = 0; n < bytes / sizeof(float); n++) {
+        float v = f[n];
+        if (!(v > -1.0f)) {  // also catches NaN
+            i[n] = INT32_MIN;
+        } else if (v >= 1.0f) {
+            i[n] = INT32_MAX;
+        } else {
+            i[n] = (int32_t)lrintf(v * 2147483648.0f);
+        }
+    }
+}
