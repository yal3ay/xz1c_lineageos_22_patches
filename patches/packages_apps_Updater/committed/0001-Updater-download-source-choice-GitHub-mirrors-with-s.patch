+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.lineageos.updater.misc;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.SystemClock;
+import android.util.Log;
+
+import androidx.preference.PreferenceManager;
+
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.concurrent.Callable;
+import java.util.concurrent.CancellationException;
+import java.util.concurrent.ExecutionException;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.TimeUnit;
+
+public final class Mirrors {
+
+    private static final String TAG = "Mirrors";
+
+    // 順序固定；index 存在 SharedPreferences
+    public static final String SOURCE_AUTO = "auto";
+    public static final String[] IDS      = {"auto", "github", "gh-proxy.com", "gh.llkk.cc", "ghfast.top"};
+    public static final String[] PREFIXES = {null,   "",       "https://gh-proxy.com/", "https://gh.llkk.cc/", "https://ghfast.top/"};
+
+    private static final String GITHUB_PREFIX = "https://github.com/";
+    private static final String GITHUB_RAW_PREFIX = "https://raw.githubusercontent.com/";
+
+    private static final int CONNECT_TIMEOUT_MS = 4000;
+    private static final int READ_TIMEOUT_MS = 6000;
+    private static final int PROBE_MAX_BYTES = 1048576;
+    private static final long PROBE_TIMEOUT_SECONDS = 12;
+
+    private Mirrors() {
+    }
+
+    public static boolean isGithubUrl(String url) {
+        if (url == null) {
+            return false;
+        }
+        return url.startsWith(GITHUB_PREFIX) || url.startsWith(GITHUB_RAW_PREFIX);
+    }
+
+    public static String apply(String url, int index) {
+        if (index < 1 || index >= PREFIXES.length || PREFIXES[index] == null) {
+            return url;
+        }
+        if (!isGithubUrl(url)) {
+            return url;
+        }
+        return PREFIXES[index] + url;
+    }
+
+    public static int getSelected(Context context) {
+        SharedPreferences preferences = PreferenceManager.getDefaultSharedPreferences(context);
+        int selected = preferences.getInt(Constants.PREF_DOWNLOAD_SOURCE, 0);
+        if (selected < 0 || selected >= IDS.length) {
+            return 0;
+        }
+        return selected;
+    }
+
+    /**
+     * background thread only
+     */
+    public static long probe(String url) {
+        HttpURLConnection connection = null;
+        try {
+            connection = (HttpURLConnection) new URL(url).openConnection();
+            connection.setConnectTimeout(CONNECT_TIMEOUT_MS);
+            connection.setReadTimeout(READ_TIMEOUT_MS);
+            connection.setInstanceFollowRedirects(true);
+            connection.setRequestProperty("Range", "bytes=0-1048575");
+            connection.connect();
+            int responseCode = connection.getResponseCode();
+            if (responseCode != HttpURLConnection.HTTP_OK &&
+                    responseCode != HttpURLConnection.HTTP_PARTIAL) {
+                Log.d(TAG, "Probe got HTTP " + responseCode + " for " + url);
+                return -1;
+            }
+            long start = SystemClock.elapsedRealtime();
+            long read = 0;
+            try (InputStream inputStream = connection.getInputStream()) {
+                byte[] buffer = new byte[8192];
+                int count;
+                while (read < PROBE_MAX_BYTES && (count = inputStream.read(buffer)) > 0) {
+                    read += count;
+                }
+            }
+            long elapsed = SystemClock.elapsedRealtime() - start;
+            if (read == 0 || elapsed <= 0) {
+                return -1;
+            }
+            return read * 1000 / elapsed;
+        } catch (Exception e) {
+            Log.d(TAG, "Probe failed for " + url, e);
+            return -1;
+        } finally {
+            if (connection != null) {
+                connection.disconnect();
+            }
+        }
+    }
+
+    /**
+     * background thread only
+     */
+    public static long[] probeAll(String url) {
+        long[] speeds = new long[IDS.length];
+        Arrays.fill(speeds, -1);
+        ExecutorService executor = Executors.newFixedThreadPool(4);
+        try {
+            List<Callable<Long>> tasks = new ArrayList<>();
+            for (int i = 1; i < IDS.length; i++) {
+                final int index = i;
+                tasks.add(() -> probe(apply(url, index)));
+            }
+            List<Future<Long>> results = executor.invokeAll(tasks, PROBE_TIMEOUT_SECONDS,
+                    TimeUnit.SECONDS);
+            for (int i = 0; i < results.size(); i++) {
+                try {
+                    speeds[i + 1] = results.get(i).get();
+                } catch (CancellationException | ExecutionException e) {
+                    speeds[i + 1] = -1;
+                }
+            }
+        } catch (InterruptedException e) {
+            Log.d(TAG, "Probe interrupted", e);
+            Thread.currentThread().interrupt();
+        } finally {
+            executor.shutdownNow();
+        }
+        return speeds;
+    }
+
+    /**
+     * background thread only
+     */
+    public static String choose(Context context, String url) {
+        if (!isGithubUrl(url)) {
+            return url;
+        }
+        int selected = getSelected(context);
+        if (selected != 0) {
+            return apply(url, selected);
+        }
+        long[] speeds = probeAll(url);
+        int bestIndex = -1;
+        long bestSpeed = 0;
+        for (int i = 1; i < speeds.length; i++) {
+            if (speeds[i] > bestSpeed) {
+                bestSpeed = speeds[i];
+                bestIndex = i;
+            }
+        }
+        if (bestIndex == -1) {
+            Log.d(TAG, "All mirrors failed, using the original url");
+            return url;
+        }
+        Log.d(TAG, "Selected " + IDS[bestIndex] + " at " + bestSpeed + " B/s");
+        return apply(url, bestIndex);
+    }
+
+    public static List<String> feedCandidates(Context context, String url) {
+        List<String> candidates = new ArrayList<>();
+        candidates.add(url);
+        if (!isGithubUrl(url)) {
+            return candidates;
+        }
+        int selected = getSelected(context);
+        if (selected != 0) {
+            candidates.set(0, apply(url, selected));
+        }
+        for (int i = 1; i < IDS.length; i++) {
+            String candidate = apply(url, i);
+            if (!candidates.contains(candidate)) {
+                candidates.add(candidate);
+            }
+        }
+        return candidates;
+    }
+}
