+package org.lineageos.updater;
+
+import android.content.SharedPreferences;
+import android.content.pm.PackageManager;
+import android.os.Handler;
+import android.os.Looper;
+import android.os.RecoverySystem;
+import android.text.format.Formatter;
+import android.util.Log;
+import android.view.View;
+import android.widget.LinearLayout;
+import android.widget.ProgressBar;
+import android.widget.TextView;
+
+import androidx.appcompat.app.AlertDialog;
+import androidx.appcompat.app.AppCompatActivity;
+import androidx.preference.PreferenceManager;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.lineageos.updater.misc.Utils;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.security.MessageDigest;
+import java.util.HexFormat;
+
+/**
+ * XZ1C: install the add-on packages (Google services, Sony services) from the Updater page.
+ *
+ * The packages are not part of the ROM. addons.json in the add-on repository lists each
+ * package's download URL, size and sha256. Downloaded zips are checked against that sha256
+ * and the ROM's OTA certificate, then installed through recovery exactly like an OTA.
+ * addon.d keeps them across later OTAs.
+ */
+public class AddonsManager {
+    private static final String TAG = "XZ1CAddons";
+    private static final String MANIFEST_URL =
+            "https://raw.githubusercontent.com/yaleax/xz1c-addons/main/addons.json";
+    private static final String PREF_PENDING = "xz1c_addons_pending_file";
+
+    private static final String ID_GAPPS = "gapps";
+    private static final String ID_SONY = "sony";
+    private static final String PKG_GAPPS = "com.google.android.gms";
+    private static final String PKG_SONY = "com.sonyericsson.album";
+
+    private final AppCompatActivity mActivity;
+    private final SharedPreferences mPrefs;
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private TextView mGapps, mSony;
+    private volatile boolean mBusy, mCancelled;
+
+    public AddonsManager(AppCompatActivity activity) {
+        mActivity = activity;
+        mPrefs = PreferenceManager.getDefaultSharedPreferences(activity);
+    }
+
+    public void bind(View row) {
+        if (row == null) return;
+        mGapps = row.findViewById(R.id.addon_gapps);
+        mSony = row.findViewById(R.id.addon_sony);
+        mGapps.setOnClickListener(v -> onAddonClicked(ID_GAPPS));
+        mSony.setOnClickListener(v -> onAddonClicked(ID_SONY));
+        // A package installed on the previous boot is no longer needed.
+        String pending = mPrefs.getString(PREF_PENDING, null);
+        if (pending != null) {
+            //noinspection ResultOfMethodCallIgnored
+            new File(pending).delete();
+            mPrefs.edit().remove(PREF_PENDING).apply();
+        }
+        refresh();
+    }
+
+    public void refresh() {
+        if (mGapps == null) return;
+        mGapps.setText(mActivity.getString(isInstalled(PKG_GAPPS)
+                ? R.string.addon_installed_fmt : R.string.addon_install_fmt,
+                mActivity.getString(R.string.addon_gapps)));
+        mSony.setText(mActivity.getString(isInstalled(PKG_SONY)
+                ? R.string.addon_installed_fmt : R.string.addon_install_fmt,
+                mActivity.getString(R.string.addon_sony)));
+    }
+
+    private boolean isInstalled(String pkg) {
+        try {
+            mActivity.getPackageManager().getPackageInfo(pkg, 0);
+            return true;
+        } catch (PackageManager.NameNotFoundException e) {
+            return false;
+        }
+    }
+
+    private String labelOf(String id) {
+        return mActivity.getString(ID_GAPPS.equals(id) ? R.string.addon_gapps : R.string.addon_sony);
+    }
+
+    private void onAddonClicked(String id) {
+        if (mBusy) return;
+        checkManifest(id);
+    }
+
+    // ------------------------------------------------------------------ flow
+
+    private static final class Addon {
+        String file, url, version, sha256;
+        long size;
+    }
+
+    /** Step 1: read addons.json (small), then confirm with version and size. */
+    private void checkManifest(String id) {
+        mBusy = true;
+        final AlertDialog checking = new AlertDialog.Builder(mActivity)
+                .setTitle(labelOf(id))
+                .setMessage(R.string.addon_checking)
+                .setCancelable(false)
+                .show();
+        new Thread(() -> {
+            try {
+                Addon addon = readManifest(id);
+                mHandler.post(() -> {
+                    checking.dismiss();
+                    mBusy = false;
+                    confirmDownload(id, addon);
+                });
+            } catch (Exception e) {
+                mHandler.post(() -> {
+                    checking.dismiss();
+                    mBusy = false;
+                    fail(id, e);
+                });
+            }
+        }, "xz1c-addons-manifest").start();
+    }
+
+    private void confirmDownload(String id, Addon addon) {
+        String size = Formatter.formatShortFileSize(mActivity, addon.size);
+        boolean installed = isInstalled(ID_GAPPS.equals(id) ? PKG_GAPPS : PKG_SONY);
+        new AlertDialog.Builder(mActivity)
+                .setTitle(labelOf(id))
+                .setMessage(mActivity.getString(installed ? R.string.addon_reinstall_message
+                        : R.string.addon_install_message, addon.version, size))
+                .setNegativeButton(android.R.string.cancel, null)
+                .setPositiveButton(R.string.addon_download, (d, w) -> download(id, addon))
+                .show();
+    }
+
+    /** Step 2: download with progress, check sha256 and the OTA signature. */
+    private void download(String id, Addon addon) {
+        mBusy = true;
+        mCancelled = false;
+        LinearLayout box = new LinearLayout(mActivity);
+        box.setOrientation(LinearLayout.VERTICAL);
+        box.setPadding(dp(24), dp(12), dp(24), 0);
+        final TextView status = new TextView(mActivity);
+        final ProgressBar bar = new ProgressBar(mActivity, null,
+                android.R.attr.progressBarStyleHorizontal);
+        bar.setMax(100);
+        box.addView(status);
+        box.addView(bar);
+        final AlertDialog dialog = new AlertDialog.Builder(mActivity)
+                .setTitle(labelOf(id))
+                .setView(box)
+                .setCancelable(false)
+                .setNegativeButton(android.R.string.cancel, (d, w) -> mCancelled = true)
+                .show();
+        status.setText(mActivity.getString(R.string.addon_downloading, 0));
+        new Thread(() -> {
+            File out = new File(Utils.getDownloadPath(mActivity), addon.file);
+            try {
+                downloadAsset(addon, out, pct -> mHandler.post(() -> {
+                    bar.setProgress(pct);
+                    status.setText(mActivity.getString(R.string.addon_downloading, pct));
+                }));
+                mHandler.post(() -> status.setText(R.string.addon_verifying));
+                RecoverySystem.verifyPackage(out, null, null);
+                mHandler.post(() -> {
+                    dialog.dismiss();
+                    mBusy = false;
+                    confirmInstall(id, out);
+                });
+            } catch (Exception e) {
+                //noinspection ResultOfMethodCallIgnored
+                out.delete();
+                mHandler.post(() -> {
+                    dialog.dismiss();
+                    mBusy = false;
+                    if (!mCancelled) fail(id, e);
+                });
+            }
+        }, "xz1c-addons-download").start();
+    }
+
+    /** Step 3: reboot into recovery, which installs the zip like an OTA and reboots back. */
+    private void confirmInstall(String id, File file) {
+        new AlertDialog.Builder(mActivity)
+                .setTitle(labelOf(id))
+                .setMessage(mActivity.getString(R.string.addon_ready_message, labelOf(id)))
+                .setNegativeButton(android.R.string.cancel, (d, w) -> {
+                    //noinspection ResultOfMethodCallIgnored
+                    file.delete();
+                })
+                .setPositiveButton(R.string.addon_restart_install, (d, w) -> {
+                    mPrefs.edit().putString(PREF_PENDING, file.getAbsolutePath()).apply();
+                    try {
+                        RecoverySystem.installPackage(mActivity, file);
+                    } catch (IOException e) {
+                        fail(id, e);
+                    }
+                })
+                .show();
+    }
+
+    private void fail(String id, Exception e) {
+        Log.e(TAG, "add-on " + id + " failed", e);
+        String message;
+        if (e instanceof HttpException) {
+            message = mActivity.getString(R.string.addon_unavailable, e.getMessage());
+        } else if (e instanceof ChecksumException) {
+            message = mActivity.getString(R.string.addon_checksum_failed);
+        } else {
+            message = mActivity.getString(R.string.addon_failed, String.valueOf(e.getMessage()));
+        }
+        new AlertDialog.Builder(mActivity)
+                .setTitle(labelOf(id))
+                .setMessage(message)
+                .setPositiveButton(android.R.string.ok, null)
+                .show();
+    }
+
+    // -------------------------------------------------------------- network
+
+    private static final class HttpException extends IOException {
+        final int code;
+        HttpException(int code) {
+            super("HTTP " + code);
+            this.code = code;
+        }
+    }
+
+    private static final class ChecksumException extends IOException {
+        ChecksumException() {
+            super("sha256 mismatch");
+        }
+    }
+
+    private interface Progress {
+        void update(int percent);
+    }
+
+    private Addon readManifest(String id) throws Exception {
+        JSONObject manifest = new JSONObject(getString(MANIFEST_URL));
+        JSONArray list = manifest.getJSONArray("addons");
+        for (int i = 0; i < list.length(); i++) {
+            JSONObject o = list.getJSONObject(i);
+            if (!id.equals(o.getString("id"))) continue;
+            Addon a = new Addon();
+            a.file = o.getString("file");
+            a.url = o.getString("url");
+            a.version = o.optString("version", "");
+            a.sha256 = o.getString("sha256").toLowerCase();
+            a.size = o.optLong("size", 0);
+            if (a.file.contains("/") || a.file.startsWith(".")) throw new IOException("bad name");
+            return a;
+        }
+        throw new IOException("not in addons.json: " + id);
+    }
+
+    private void downloadAsset(Addon addon, File out, Progress progress) throws Exception {
+        // GitHub release downloads redirect (https -> https) to their storage host.
+        HttpURLConnection conn = open(addon.url);
+        int code = conn.getResponseCode();
+        if (code != 200) {
+            conn.disconnect();
+            throw new HttpException(code);
+        }
+
+        long total = addon.size > 0 ? addon.size : conn.getContentLengthLong();
+        MessageDigest sha = MessageDigest.getInstance("SHA-256");
+        try (InputStream in = conn.getInputStream(); OutputStream os = new FileOutputStream(out)) {
+            byte[] buf = new byte[64 * 1024];
+            long done = 0;
+            int last = -1, n;
+            while ((n = in.read(buf)) > 0) {
+                if (mCancelled) throw new IOException("cancelled");
+                os.write(buf, 0, n);
+                sha.update(buf, 0, n);
+                done += n;
+                int pct = total > 0 ? (int) (done * 100 / total) : 0;
+                if (pct != last) {
+                    last = pct;
+                    progress.update(pct);
+                }
+            }
+        } finally {
+            conn.disconnect();
+        }
+        if (!HexFormat.of().formatHex(sha.digest()).equals(addon.sha256)) {
+            throw new ChecksumException();
+        }
+    }
+
+    private String getString(String url) throws IOException {
+        HttpURLConnection conn = open(url);
+        try {
+            int code = conn.getResponseCode();
+            if (code != 200) throw new HttpException(code);
+            try (InputStream in = conn.getInputStream()) {
+                ByteArrayOutputStream bos = new ByteArrayOutputStream();
+                byte[] buf = new byte[8192];
+                int n;
+                while ((n = in.read(buf)) > 0) bos.write(buf, 0, n);
+                return bos.toString("UTF-8");
+            }
+        } finally {
+            conn.disconnect();
+        }
+    }
+
+    private HttpURLConnection open(String url) throws IOException {
+        HttpURLConnection conn = (HttpURLConnection) new URL(url).openConnection();
+        conn.setConnectTimeout(20000);
+        conn.setReadTimeout(60000);
+        conn.setInstanceFollowRedirects(true);
+        return conn;
+    }
+
+    private int dp(int v) {
+        return (int) (v * mActivity.getResources().getDisplayMetrics().density + 0.5f);
+    }
+}
