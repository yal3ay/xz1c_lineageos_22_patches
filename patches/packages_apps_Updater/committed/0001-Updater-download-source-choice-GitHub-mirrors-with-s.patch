diff --git a/app/src/main/java/org/lineageos/updater/misc/Mirrors.java b/app/src/main/java/org/lineageos/updater/misc/Mirrors.java
new file mode 100644
index 0000000..c74446d
--- /dev/null
+++ b/app/src/main/java/org/lineageos/updater/misc/Mirrors.java
@@ -0,0 +1,204 @@
+/*
