+/*
+ * SPDX-FileCopyrightText: 2026 XZ1C project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.lineageparts.livedisplay;
+
+import android.os.Bundle;
+
+import androidx.preference.CheckBoxPreference;
+import androidx.preference.Preference;
+
+import org.lineageos.lineageparts.R;
+import org.lineageos.lineageparts.SettingsPreferenceFragment;
+
+/** XZ1C: Sony-style "Image quality settings" (Creator / Standard mode, white balance). */
+public class ImageQualitySettings extends SettingsPreferenceFragment
+        implements Preference.OnPreferenceClickListener {
+
+    private static final String KEY_CREATOR = "image_quality_creator_mode";
+    private static final String KEY_STANDARD = "image_quality_standard_mode";
+    private static final String KEY_WHITE_BALANCE = "image_quality_white_balance";
+
+    private ImageQuality mImageQuality;
+    private CheckBoxPreference mCreator;
+    private CheckBoxPreference mStandard;
+    private Preference mWhiteBalance;
+
+    @Override
+    public void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        addPreferencesFromResource(R.xml.image_quality_settings);
+
+        mImageQuality = new ImageQuality(requireContext());
+        mCreator = findPreference(KEY_CREATOR);
+        mStandard = findPreference(KEY_STANDARD);
+        mWhiteBalance = findPreference(KEY_WHITE_BALANCE);
+
+        mCreator.setOnPreferenceClickListener(this);
+        mStandard.setOnPreferenceClickListener(this);
+
+        final boolean hasModes = mImageQuality.getCreatorMode() != null
+                && mImageQuality.getStandardMode() != null;
+        mCreator.setEnabled(hasModes);
+        mStandard.setEnabled(hasModes);
+        mWhiteBalance.setVisible(mImageQuality.hasWhiteBalance());
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        updateState();
+    }
+
+    private void updateState() {
+        final boolean creator = mImageQuality.isCreatorMode();
+        mCreator.setChecked(creator);
+        mStandard.setChecked(!creator);
+        mWhiteBalance.setSummary(presetTitle(mImageQuality.getPreset()));
+    }
+
+    @Override
+    public boolean onPreferenceClick(Preference preference) {
+        mImageQuality.setCreatorMode(preference == mCreator);
+        updateState();
+        return true;
+    }
+
+    private int presetTitle(String preset) {
+        switch (preset) {
+            case ImageQuality.PRESET_WARM:
+                return R.string.white_balance_warm;
+            case ImageQuality.PRESET_COOL:
+                return R.string.white_balance_cool;
+            case ImageQuality.PRESET_CUSTOM:
+                return R.string.white_balance_custom;
+            default:
+                return R.string.white_balance_medium;
+        }
+    }
+}
