+
+/** XZ1C: Sony-style white balance page (warm / medium / cool / custom). */
+public class WhiteBalanceSettings extends SettingsPreferenceFragment
+        implements Preference.OnPreferenceClickListener, SeekBar.OnSeekBarChangeListener {
+
+    private static final String KEY_INFO = "white_balance_info";
+    private static final String KEY_WARM = "white_balance_warm";
+    private static final String KEY_MEDIUM = "white_balance_medium";
+    private static final String KEY_COOL = "white_balance_cool";
+    private static final String KEY_CUSTOM = "white_balance_custom";
+    private static final String KEY_CUSTOM_SLIDERS = "white_balance_custom_sliders";
+
+    private static final int TEMP_STEP = 100;
+
+    private ImageQuality mImageQuality;
+    private Preference mInfo;
+    private CheckBoxPreference mWarm;
+    private CheckBoxPreference mMedium;
+    private CheckBoxPreference mCool;
+    private CheckBoxPreference mCustom;
+    private LayoutPreference mSliders;
+
+    private SeekBar mTemperature;
+    private SeekBar mRed;
+    private SeekBar mGreen;
+    private TextView mTemperatureValue;
+    private TextView mRedValue;
+    private TextView mGreenValue;
+
+    @Override
+    public void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        addPreferencesFromResource(R.xml.white_balance_settings);
+
+        mImageQuality = new ImageQuality(requireContext());
+        mInfo = findPreference(KEY_INFO);
+        mWarm = findPreference(KEY_WARM);
+        mMedium = findPreference(KEY_MEDIUM);
+        mCool = findPreference(KEY_COOL);
+        mCustom = findPreference(KEY_CUSTOM);
+        mSliders = findPreference(KEY_CUSTOM_SLIDERS);
+
+        for (CheckBoxPreference p : new CheckBoxPreference[] { mWarm, mMedium, mCool, mCustom }) {
+            p.setOnPreferenceClickListener(this);
+        }
+
+        mTemperature = mSliders.findViewById(R.id.wb_temperature);
