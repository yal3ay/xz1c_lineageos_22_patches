@@ -0,0 +1,47 @@
+/*
+ * SPDX-FileCopyrightText: 2026 XZ1C project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.lineageparts.livedisplay;
+
+import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.Paint;
+import android.util.AttributeSet;
+import android.view.View;
+
+/** XZ1C: colour bars + grey steps test pattern for the white balance page (like Sony's). */
+public class ColorBarsView extends View {
+    private static final int[] BARS = {
+            Color.rgb(192, 192, 0), Color.rgb(0, 192, 192), Color.rgb(0, 192, 0),
+            Color.rgb(192, 0, 192), Color.rgb(192, 0, 0), Color.rgb(0, 0, 192),
+            Color.BLACK,
+    };
+    private static final int GREY_STEPS = 8;
+
+    private final Paint mPaint = new Paint();
+
+    public ColorBarsView(Context context, AttributeSet attrs) {
+        super(context, attrs);
+    }
+
+    @Override
+    protected void onDraw(Canvas canvas) {
+        final float w = getWidth();
+        final float h = getHeight();
+        final float barsH = h * 0.62f;
+        final float barW = w / BARS.length;
+        for (int i = 0; i < BARS.length; i++) {
+            mPaint.setColor(BARS[i]);
+            canvas.drawRect(i * barW, 0, (i + 1) * barW, barsH, mPaint);
+        }
+        final float stepW = w / GREY_STEPS;
+        for (int i = 0; i < GREY_STEPS; i++) {
+            final int v = Math.round(255f * i / (GREY_STEPS - 1));
+            mPaint.setColor(Color.rgb(v, v, v));
+            canvas.drawRect(i * stepW, barsH, (i + 1) * stepW, h, mPaint);
+        }
+    }
+}
diff --git a/src/org/lineageos/lineageparts/livedisplay/ImageQuality.java b/src/org/lineageos/lineageparts/livedisplay/ImageQuality.java
new file mode 100644
index 0000000..6e41f61
--- /dev/null
+++ b/src/org/lineageos/lineageparts/livedisplay/ImageQuality.java
@@ -0,0 +1,192 @@
+/*
+ * SPDX-FileCopyrightText: 2026 XZ1C project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.lineageparts.livedisplay;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+
+import lineageos.hardware.DisplayMode;
+import lineageos.hardware.LineageHardwareManager;
+import lineageos.hardware.LiveDisplayManager;
+
+import java.util.Locale;
+
+/**
+ * XZ1C: Sony-style "Image quality settings" on top of LiveDisplay.
+ *
+ * Gamut: Creator mode = the panel's sRGB QDCM mode (Sony's own factory calibration,
+ * BT.709 primaries, D65); Standard mode = the DCI-P3 mode (wider, more vivid, Sony's default).
+ *
+ * White balance is written as LiveDisplay's base colour adjustment (display_color_adjustment).
+ * LiveDisplay's own day/night temperature and outdoor mode keep working: they are applied as a
+ * separate "additional" adjustment on top of this one.
+ */
+public final class ImageQuality {
+    public static final String PRESET_WARM = "warm";
+    public static final String PRESET_MEDIUM = "medium";
+    public static final String PRESET_COOL = "cool";
+    public static final String PRESET_CUSTOM = "custom";
+
+    public static final int TEMP_MIN = 5000;
+    public static final int TEMP_MAX = 9300;
+    public static final int TEMP_D65 = 6500;
+    public static final int TINT_MAX = 100;
+    public static final int TINT_NEUTRAL = 50;
+
+    private static final int TEMP_WARM = 5500;
+    private static final int TEMP_COOL = 7500;
+
+    private static final String PREFS = "image_quality";
+    private static final String KEY_PRESET = "wb_preset";
+    private static final String KEY_TEMP = "wb_temperature";
+    private static final String KEY_RED = "wb_red";
+    private static final String KEY_GREEN = "wb_green";
+
+    private final LineageHardwareManager mHardware;
+    private final LiveDisplayManager mLiveDisplay;
+    private final SharedPreferences mPrefs;
+
+    public ImageQuality(Context context) {
+        mHardware = LineageHardwareManager.getInstance(context);
+        mLiveDisplay = LiveDisplayManager.getInstance(context);
+        mPrefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    // ------------------------------------------------------------------ gamut
+
+    public DisplayMode getCreatorMode() {
+        return findMode("srgb");
+    }
+
+    public DisplayMode getStandardMode() {
+        DisplayMode mode = findMode("dci");
+        return mode != null ? mode : findMode("p3");
+    }
+
+    private DisplayMode findMode(String token) {
+        if (!mHardware.isSupported(LineageHardwareManager.FEATURE_DISPLAY_MODES)) {
+            return null;
+        }
+        DisplayMode[] modes = mHardware.getDisplayModes();
+        if (modes == null) {
+            return null;
+        }
+        for (DisplayMode mode : modes) {
+            if (mode.name != null && mode.name.toLowerCase(Locale.ROOT).contains(token)) {
+                return mode;
+            }
+        }
+        return null;
+    }
+
+    public boolean isCreatorMode() {
+        DisplayMode creator = getCreatorMode();
+        DisplayMode cur = mHardware.getCurrentDisplayMode();
+        if (cur == null) {
+            cur = mHardware.getDefaultDisplayMode();
+        }
+        return creator != null && cur != null && cur.id == creator.id;
+    }
+
+    public boolean setCreatorMode(boolean creator) {
+        DisplayMode mode = creator ? getCreatorMode() : getStandardMode();
+        return mode != null && mHardware.setDisplayMode(mode, true);
+    }
+
+    // ---------------------------------------------------------- white balance
+
+    public boolean hasWhiteBalance() {
+        return mLiveDisplay.getConfig().hasFeature(LiveDisplayManager.FEATURE_COLOR_ADJUSTMENT);
+    }
+
+    public String getPreset() {
+        return mPrefs.getString(KEY_PRESET, PRESET_MEDIUM);
+    }
+
+    public int getCustomTemperature() {
+        return mPrefs.getInt(KEY_TEMP, TEMP_D65);
+    }
+
+    public int getCustomRed() {
+        return mPrefs.getInt(KEY_RED, TINT_NEUTRAL);
+    }
+
+    public int getCustomGreen() {
+        return mPrefs.getInt(KEY_GREEN, TINT_NEUTRAL);
+    }
+
+    public void setPreset(String preset) {
+        mPrefs.edit().putString(KEY_PRESET, preset).apply();
+        apply();
+    }
+
+    public void setCustom(int temperature, int red, int green) {
+        mPrefs.edit()
+                .putString(KEY_PRESET, PRESET_CUSTOM)
+                .putInt(KEY_TEMP, clamp(temperature, TEMP_MIN, TEMP_MAX))
+                .putInt(KEY_RED, clamp(red, 0, TINT_MAX))
+                .putInt(KEY_GREEN, clamp(green, 0, TINT_MAX))
+                .apply();
+        apply();
+    }
+
+    /** Writes the RGB gains for the stored white balance to LiveDisplay. */
+    public void apply() {
+        if (!hasWhiteBalance()) {
+            return;
+        }
+        final String preset = getPreset();
+        final float[] rgb;
+        switch (preset) {
+            case PRESET_WARM:
+                rgb = gains(TEMP_WARM, TINT_NEUTRAL, TINT_NEUTRAL);
+                break;
+            case PRESET_COOL:
+                rgb = gains(TEMP_COOL, TINT_NEUTRAL, TINT_NEUTRAL);
+                break;
+            case PRESET_CUSTOM:
+                rgb = gains(getCustomTemperature(), getCustomRed(), getCustomGreen());
+                break;
+            default:
+                rgb = new float[] { 1.0f, 1.0f, 1.0f };
+                break;
+        }
+        mLiveDisplay.setColorAdjustment(rgb);
+    }
+
+    /**
+     * RGB gains for a colour temperature, normalised so D65 (6500K) is neutral, plus Sony-style
+     * red / green fine tuning (50 = neutral, about +-20% at the ends). Never exceeds 1.0.
+     */
+    static float[] gains(int kelvin, int red, int green) {
+        final double[] ref = kelvinToRgb(TEMP_D65);
+        final double[] c = kelvinToRgb(kelvin);
+        final double[] v = { c[0] / ref[0], c[1] / ref[1], c[2] / ref[2] };
+        v[0] *= 1.0 + (red - TINT_NEUTRAL) / 250.0;
+        v[1] *= 1.0 + (green - TINT_NEUTRAL) / 250.0;
+        final double max = Math.max(v[0], Math.max(v[1], v[2]));
+        return new float[] { (float) (v[0] / max), (float) (v[1] / max), (float) (v[2] / max) };
+    }
+
+    /** Tanner Helland's black-body approximation, 0..1 per channel. */
+    private static double[] kelvinToRgb(int kelvin) {
+        final double t = kelvin / 100.0;
+        final double r = t <= 66 ? 255 : 329.698727446 * Math.pow(t - 60, -0.1332047592);
+        final double g = t <= 66 ? 99.4708025861 * Math.log(t) - 161.1195681661
+                : 288.1221695283 * Math.pow(t - 60, -0.0755148492);
+        final double b = t >= 66 ? 255
+                : (t <= 19 ? 0 : 138.5177312231 * Math.log(t - 10) - 305.0447927307);
+        return new double[] { unit(r), unit(g), unit(b) };
+    }
+
+    private static double unit(double v) {
+        return Math.max(1, Math.min(255, v)) / 255.0;
+    }
+
+    private static int clamp(int v, int min, int max) {
+        return Math.max(min, Math.min(max, v));
+    }
+}
