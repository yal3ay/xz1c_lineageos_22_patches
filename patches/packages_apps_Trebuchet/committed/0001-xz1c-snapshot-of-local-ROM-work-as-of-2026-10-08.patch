+    /**
+     * Whether this item is unavailable only because the storage volume holding it has not been
+     * mounted yet, rather than because the app is gone.
+     *
+     * <p>Apps on adoptable storage are unavailable for the first seconds after boot: the volume
+     * is mounted only once StorageManagerService reaches {@code PHASE_BOOT_COMPLETED}. Telling
+     * the user the app "isn\'t available" in that window is misleading — nothing is wrong and it
+     * will start working shortly.
+     *
+     * <p>The test is the same one {@code SdCardAvailableReceiver} uses: PackageManager still has
+     * a record of a package that is merely waiting for its volume, and none of one that has
+     * really been uninstalled.
+     */
+    private static boolean isAwaitingStorage(Context context, WorkspaceItemInfo shortcut) {
+        ComponentName cn = shortcut.getTargetComponent();
+        if (cn == null) {
+            return false;
+        }
+        try {
+            return context.getSystemService(LauncherApps.class)
+                    .getApplicationInfo(cn.getPackageName(),
+                            PackageManager.MATCH_UNINSTALLED_PACKAGES, shortcut.user) != null;
+        } catch (PackageManager.NameNotFoundException e) {
+            return false;
+        }
+    }
