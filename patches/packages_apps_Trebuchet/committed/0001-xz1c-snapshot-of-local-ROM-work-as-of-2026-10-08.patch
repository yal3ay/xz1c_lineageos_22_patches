@@ -49,6 +49,38 @@ public class SdCardAvailableReceiver extends BroadcastReceiver {
         mPackages = packages;
     }
 
+    /**
+     * Whether PackageManager still has any record of this package.
+     *
+     * <p>This replaces the original {@code ApplicationInfoWrapper.isOnSdCard()} check, which
+     * cannot answer the question for adoptable storage. That wrapper discards the
+     * ApplicationInfo unless {@code FLAG_INSTALLED} is set, and a package living on a private
+     * volume that has not been mounted yet does not have it — so {@code isOnSdCard()} returned
+     * false and the shortcut was deleted as though the app had been uninstalled.
+     *
+     * <p>Adopted volumes are only mounted once StorageManagerService reaches
+     * {@code PHASE_BOOT_COMPLETED} (see {@code resetIfBootedAndConnected()}), which is the same
+     * moment ACTION_BOOT_COMPLETED is broadcast. By the time this receiver runs the volume is
+     * therefore routinely still unmounted, making the loss reproducible on every boot rather
+     * than merely racy.
+     *
+     * <p>Asking whether PackageManager knows the package at all is both simpler and safer: one
+     * that is merely waiting for its volume is still known, while a genuinely uninstalled one is
+     * not. Real uninstalls arrive through the normal PACKAGE_REMOVED path and never reach this
+     * receiver, so erring towards "unavailable" costs at most a temporarily greyed-out icon,
+     * whereas erring the other way deletes the user's workspace layout for good.
+     */
+    private static boolean isKnownToPackageManager(
+            Context context, String packageName, UserHandle user) {
+        try {
+            return context.getSystemService(LauncherApps.class)
+                    .getApplicationInfo(packageName, PackageManager.MATCH_UNINSTALLED_PACKAGES,
+                            user) != null;
+        } catch (PackageManager.NameNotFoundException e) {
+            return false;
+        }
+    }
+
     @Override
     public void onReceive(Context context, Intent intent) {
         final LauncherApps launcherApps = context.getSystemService(LauncherApps.class);
@@ -59,7 +91,7 @@ public class SdCardAvailableReceiver extends BroadcastReceiver {
