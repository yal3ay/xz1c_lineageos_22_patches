+++ b/src/com/android/launcher3/model/WorkspaceItemProcessor.kt
@@ -175,17 +175,60 @@ class WorkspaceItemProcessor(
                     "Activity not enabled for id=${c.id}, component=$cn, user=${c.user}." +
                         " Will attempt to find fallback Activity for targetPkg=$targetPkg.",
                 )
-                intent = pmHelper.getAppLaunchIntent(targetPkg, c.user)
-                if (intent != null) {
+                val fallbackIntent = pmHelper.getAppLaunchIntent(targetPkg, c.user)
+                if (fallbackIntent != null) {
+                    intent = fallbackIntent
                     c.restoreFlag = 0
                     c.updater().put(Favorites.INTENT, intent.toUri(0)).commit()
                 } else {
-                    c.markDeleted(
-                        "No Activities found for id=${c.id}, targetPkg=$targetPkg, component=$cn." +
-                            " Unable to create launch Intent.",
-                        RestoreError.APP_NO_LAUNCH_INTENT,
-                    )
-                    return
+                    // 包是「已启用」的（validTarget 为 true 才会进到这里），却解析不出
+                    // 任何可启动的 Activity。这通常不是「被卸载了」，而是应用在往/从
+                    // 融卡（adoptable storage）搬家时的中间态：PackageManager 已报告
+                    // 包可用，但组件索引尚未就绪。
+                    //
+                    // 实测（2026-09-20，本机）：把「闲鱼」移到融卡后桌面图标被删除，
+                    // Launcher 的 FileLog 记录为
+                    //   WorkspaceItemProcessor: Activity not enabled for id=23 ...
+                    //   LoaderCursor: No Activities found ... Unable to create launch Intent.
+                    // 数据库里该条 favorites 记录被直接删掉，重启也回不来。
+                    //
+                    // 注意：下方处理 !validTarget 的 when 块本来就有 SD 卡保护
+                    // （isOnSdCard / !isSdCardReady 时保留图标），但因为这里
+                    // validTarget == true，执行流根本到不了那里，于是走了删除。
+                    // 这里补上同样的保护，保持两条路径行为一致。
+                    //
+                    // 真正的卸载不受影响：那会走 onPackageRemoved -> OP_REMOVE，
+                    // 由 PackageUpdatedTask 正常清理。
+                    when {
+                        appInfoWrapper.isOnSdCard() -> {
+                            FileLog.d(
+                                TAG,
+                                "No launch intent yet for id=${c.id}, targetPkg=$targetPkg on" +
+                                    " sdcard/adopted storage. Keeping icon as unavailable" +
+                                    " instead of deleting.",
+                            )
+                            disabledState =
+                                disabledState or WorkspaceItemInfo.FLAG_DISABLED_NOT_AVAILABLE
+                            allowMissingTarget = true
+                        }
+                        !isSdCardReady -> {
+                            FileLog.d(
+                                TAG,
+                                "No launch intent yet for id=${c.id}, targetPkg=$targetPkg and" +
+                                    " sdcard is not ready. Will check later, keeping icon.",
+                            )
+                            pendingPackages.add(PackageUserKey(targetPkg, c.user))
+                            allowMissingTarget = true
+                        }
+                        else -> {
+                            c.markDeleted(
+                                "No Activities found for id=${c.id}, targetPkg=$targetPkg," +
+                                    " component=$cn. Unable to create launch Intent.",
+                                RestoreError.APP_NO_LAUNCH_INTENT,
+                            )
+                            return
+                        }
+                    }
                 }
             }
         }
