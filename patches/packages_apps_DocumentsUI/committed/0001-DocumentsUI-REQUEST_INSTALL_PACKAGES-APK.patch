 AndroidManifest.xml | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/AndroidManifest.xml b/AndroidManifest.xml
index 222e6e976..aec985eb1 100644
--- a/AndroidManifest.xml
+++ b/AndroidManifest.xml
@@ -21,6 +21,11 @@
 
     <uses-sdk android:minSdkVersion="29"/>
 
+    <!-- 允许从「文件」里点开 APK 触发安装。AOSP 的 DocumentsUI 不声明这个权限，
+         结果点 APK 后 PackageInstaller 的 InstallStart 会静默退出，只显示安装失败
+         （2026-09-10 实测复现）。声明后还需在
+         设置 → 应用 → 特殊应用权限 → 安装未知应用 里给「文件」打开。 -->
+    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
     <uses-permission android:name="android.permission.MANAGE_DOCUMENTS" />
     <uses-permission android:name="android.permission.REMOVE_TASKS" />
     <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
