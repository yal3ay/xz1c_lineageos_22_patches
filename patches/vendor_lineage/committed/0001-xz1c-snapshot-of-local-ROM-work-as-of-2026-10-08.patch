diff --git a/release/aconfig/bp1a/com.android.settingslib.flags/Android.bp b/release/aconfig/bp1a/com.android.settingslib.flags/Android.bp
new file mode 100644
index 00000000..6ef80df7
--- /dev/null
+++ b/release/aconfig/bp1a/com.android.settingslib.flags/Android.bp
@@ -0,0 +1,31 @@
+//
+// Copyright (C) 2026 The LineageOS Project
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// 启用 Android 15 中已合入但默认关闭的新版状态栏系统图标
+// （AOSP 声明见 frameworks/base/packages/SettingsLib/aconfig/settingslib.aconfig，
+//  未赋值即 DISABLED）。A16 / LineageOS 23 默认使用这一套。
+//
+// 影响范围（图形与代码路径均已在树内，无需移植任何资源）：
+//   WiFi   SettingsLib 的 ic_wifi_0..4（圆头弧线 + 中心水滴点）
+//          取代 framework-res 的 ic_wifi_signal_0..4（实心扇形）
+//          见 SystemUI/src/.../statusbar/connectivity/WifiIcons.java
+//   电池   BatteryLayersDrawable（unified battery）取代
+//          AccessorizedBatteryDrawable，见 BatteryMeterView.java:150
+//   信号   mobile_signal 图标高度改用 status_bar_mobile_signal_size_updated
+//
+// ⚠️ 配套改动：unified battery 的低电量配色原本把阈值写死为 20，
+//    且没有「橙色预警」档。已在 BatteryMeterView.getCurrentColorProfile()
+//    接上本项目可配置的 persist.debug.battery_tint_{low,warn}_pct，
+//    详见该方法注释。若回退本 flag，那段改动保持兼容、无需一并回退。
+//
+// 回退：删除本目录，并从 ../Android.bp 的 aconfig_value_set 中移除对应条目。
+
+aconfig_values {
+    name: "aconfig-values-bp1a-com.android.settingslib.flags-all",
+    package: "com.android.settingslib.flags",
+    srcs: [
+        "*_flag_values.textproto",
+    ],
+}
diff --git a/release/aconfig/bp1a/com.android.settingslib.flags/new_status_bar_icons_flag_values.textproto b/release/aconfig/bp1a/com.android.settingslib.flags/new_status_bar_icons_flag_values.textproto
