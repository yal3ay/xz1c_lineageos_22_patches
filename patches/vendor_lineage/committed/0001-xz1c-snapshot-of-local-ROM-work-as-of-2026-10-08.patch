+  state: ENABLED
+  permission: READ_ONLY
+}
diff --git a/release/aconfig/bp1a/com.android.systemui/Android.bp b/release/aconfig/bp1a/com.android.systemui/Android.bp
new file mode 100644
index 00000000..63d0d714
--- /dev/null
+++ b/release/aconfig/bp1a/com.android.systemui/Android.bp
@@ -0,0 +1,21 @@
+//
+// Copyright (C) 2026 The LineageOS Project
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+// 启用 Android 15 中已合入但默认关闭的新版 Quick Settings（Compose 实现），
+// 它带来可拖拽调整大小的磁贴（qs/panels 下的 ResizingState / IconTiles /
+// InfiniteGridLayout 等）。A16 默认开启，A15 仅以 flag 关闭。
+//
+// qs_ui_refactor_compose_fragment 依赖 qs_ui_refactor（见 systemui.aconfig 描述），
+// 故两者一并启用。
+//
+// 回退：删除本目录，并从 ../Android.bp 的 aconfig_value_set 中移除对应条目。
+
+aconfig_values {
+    name: "aconfig-values-bp1a-com.android.systemui-all",
+    package: "com.android.systemui",
+    srcs: [
+        "*_flag_values.textproto",
+    ],
+}
diff --git a/release/aconfig/bp1a/com.android.systemui/qs_ui_refactor_compose_fragment_flag_values.textproto b/release/aconfig/bp1a/com.android.systemui/qs_ui_refactor_compose_fragment_flag_values.textproto
