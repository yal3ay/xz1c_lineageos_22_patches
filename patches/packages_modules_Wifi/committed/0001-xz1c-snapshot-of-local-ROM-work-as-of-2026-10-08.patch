+    /**
+     * An AIDL v2 vendor HAL may leave cached scan data unimplemented. Once that
+     * is known, subsequent requests must not call into the HAL again.
+     */
+    @Test
+    public void testGetCachedScanDataUnsupportedIsRemembered() throws Exception {
+        when(WifiHalAidlImpl.isServiceVersionAtLeast(2)).thenReturn(true);
+        when(mIWifiStaIfaceMock.getCachedScanData()).thenThrow(
+                new ServiceSpecificException(WifiStatusCode.ERROR_NOT_SUPPORTED));
+
+        assertNull(mDut.getCachedScanData());
+        assertNull(mDut.getCachedScanData());
+
+        verify(mIWifiStaIfaceMock, times(1)).getCachedScanData();
+    }
