diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/pipeline/mobile/ui/view/ModernStatusBarMobileView.kt b/packages/SystemUI/src/com/android/systemui/statusbar/pipeline/mobile/ui/view/ModernStatusBarMobileView.kt
index e6bec1926..f5c20ebd7 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/pipeline/mobile/ui/view/ModernStatusBarMobileView.kt
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/pipeline/mobile/ui/view/ModernStatusBarMobileView.kt
@@ -16,10 +16,14 @@
 
 package com.android.systemui.statusbar.pipeline.mobile.ui.view
 
+import android.content.BroadcastReceiver
 import android.content.Context
+import android.content.Intent
+import android.content.IntentFilter
 import android.database.ContentObserver
 import android.os.Handler
 import android.os.Looper
+import android.telephony.CarrierConfigManager
 import android.telephony.SubscriptionManager
 import android.telephony.ims.ImsMmTelManager
 import android.util.AttributeSet
@@ -64,6 +68,23 @@ class ModernStatusBarMobileView(
             }
         }
 
+    // carrier config 加载完之前 isAdvancedCallingSettingEnabled() 会返回 false，
+    // 所以必须等这个广播再读一次，否则开机那次读到的 false 会一直留着。
+    private val volteConfigReceiver =
+        object : BroadcastReceiver() {
+            override fun onReceive(context: Context?, intent: Intent?) {
+                refreshVolte()
+            }
+        }
+
+    // 换卡 / 默认语音卡变化时也要重读
+    private val volteSubsListener =
+        object : SubscriptionManager.OnSubscriptionsChangedListener() {
+            override fun onSubscriptionsChanged() {
+                refreshVolte()
+            }
+        }
+
     private fun refreshVolte() {
         val sub = subId
         volteBgExecutor.execute {
@@ -77,6 +98,7 @@ class ModernStatusBarMobileView(
                     Log.w(TAG, "读取 4G 高清通话开关失败 subId=$sub", e)
                     false
                 }
+            Log.d(TAG, "4G 高清通话开关 subId=$sub enabled=$enabled")
             post {
                 findViewById<ImageView>(R.id.mobile_volte)?.visibility =
                     if (enabled) View.VISIBLE else View.GONE
@@ -91,11 +113,27 @@ class ModernStatusBarMobileView(
             /* notifyForDescendants = */ true,
             volteObserver,
         )
+        context.registerReceiver(
+            volteConfigReceiver,
+            IntentFilter(CarrierConfigManager.ACTION_CARRIER_CONFIG_CHANGED),
+            Context.RECEIVER_NOT_EXPORTED,
+        )
+        context
+            .getSystemService(SubscriptionManager::class.java)
+            ?.addOnSubscriptionsChangedListener(volteBgExecutor, volteSubsListener)
         refreshVolte()
     }
 
     override fun onDetachedFromWindow() {
         context.contentResolver.unregisterContentObserver(volteObserver)
+        try {
+            context.unregisterReceiver(volteConfigReceiver)
+        } catch (e: IllegalArgumentException) {
+            // 没注册上过，忽略
+        }
+        context
+            .getSystemService(SubscriptionManager::class.java)
+            ?.removeOnSubscriptionsChangedListener(volteSubsListener)
         super.onDetachedFromWindow()
     }
 
