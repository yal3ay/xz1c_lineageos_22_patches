+<?xml version="1.0" encoding="utf-8"?>
+<!-- 「插着电源但没在进电」指示器（典型：充电控制到达上限后停充）。放在电池右侧、
+     原本闪电的位置：闪电 = 正在充，插头 = 接着电源但没在充。
+     参照 macOS：接电源未充电时电池旁显示插头而非闪电。
+     图形为 Material Icons「power」(Apache-2.0)，viewport 裁到图形本身(12x18)。
+
+     2026-09-23：尺寸由 8x12dp 缩到 6x9dp（老板要求「小一点」）。
+     图形与 viewport 均未改动，只动 width/height —— 12:18 与 6:9 比例相同，不会变形。 -->
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="6dp"
+    android:height="9dp"
+    android:viewportWidth="12"
+    android:viewportHeight="18">
+    <group android:translateX="-6" android:translateY="-3">
+        <path
+            android:fillColor="#FF000000"
+            android:pathData="M16,7V3h-2v4h-4V3H8v4h-0.01C6.9,7 6,7.9 6,8.99v5.49L9.5,18v3h5v-3l3.5,-3.51V9c0,-1.1 -0.9,-2 -2,-2z"/>
+    </group>
+</vector>
