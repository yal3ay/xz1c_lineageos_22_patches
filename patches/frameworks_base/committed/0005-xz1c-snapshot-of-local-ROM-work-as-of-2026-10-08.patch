diff --git a/packages/SystemUI/src/com/android/systemui/battery/ChargingControlState.java b/packages/SystemUI/src/com/android/systemui/battery/ChargingControlState.java
new file mode 100644
index 000000000..9e1cd4bfa
--- /dev/null
+++ b/packages/SystemUI/src/com/android/systemui/battery/ChargingControlState.java
@@ -0,0 +1,50 @@
+/*
+ * 判断 LineageOS「充电控制」（上限模式）是否会拦住刚开始的这次充电。
+ *
+ * 为什么需要：充电控制在「拔线」时会把充电开关复位为允许（resetInternalState →
+ * setChargingEnabled(true)），所以每次插线的头一两秒硬件真的在充，系统如实上报
+ * status=CHARGING，要等充电控制重新判断后才关掉。SystemUI 如果照单全收，就会在
+ * 「电量早已超过上限、根本不会充」的情况下播插线动画、把电池画成绿色 + 闪电。
+ *
+ * 只用于插线后的短暂窗口：窗口之后一律以真实状态为准 —— 否则用户点了通知里的
+ * 「本次充满」，电量 ≥ 上限也在真充，这里若一直判为拦截就会显示错误。
+ */
+package com.android.systemui.battery;
+
+import android.content.ContentResolver;
+import android.content.Context;
+import android.os.UserHandle;
+
+import lineageos.health.HealthInterface;
+import lineageos.providers.LineageSettings;
+
+public final class ChargingControlState {
+
+    /** 插线后多长时间内用本判断覆盖系统上报的「正在充电」。 */
+    public static final long PLUG_IN_WINDOW_MS = 5000L;
+
+    private ChargingControlState() {}
+
+    /** 充电控制开着、为上限模式、且电量已达上限 → 这次插线必然会被拦住。 */
+    public static boolean willHoldCharging(Context context, int level) {
+        try {
+            final ContentResolver cr = context.getContentResolver();
+            if (LineageSettings.System.getIntForUser(cr,
+                    LineageSettings.System.CHARGING_CONTROL_ENABLED, 0,
+                    UserHandle.USER_CURRENT) == 0) {
+                return false;
+            }
+            if (LineageSettings.System.getIntForUser(cr,
+                    LineageSettings.System.CHARGING_CONTROL_MODE, 0,
+                    UserHandle.USER_CURRENT) != HealthInterface.MODE_LIMIT) {
+                return false;
+            }
+            final int limit = LineageSettings.System.getIntForUser(cr,
+                    LineageSettings.System.CHARGING_CONTROL_LIMIT, 100,
+                    UserHandle.USER_CURRENT);
+            return level >= limit;
+        } catch (Exception e) {
+            return false;   // 判断不了就不干预，按系统真实状态显示
+        }
+    }
+}
