diff --git a/core/java/android/app/ActivityManagerInternal.java b/core/java/android/app/ActivityManagerInternal.java
index abdfb5353..dd9376947 100644
--- a/core/java/android/app/ActivityManagerInternal.java
+++ b/core/java/android/app/ActivityManagerInternal.java
@@ -343,6 +343,15 @@ public abstract class ActivityManagerInternal {
     /** Kill the process immediately. */
     public abstract void killProcess(String processName, int uid, String reason);
 
+    /**
+     * 强制停止应用，并把它置为「停止状态」(PackageManager 的 FLAG_STOPPED)。
+     *
+     * 与 {@link #killProcess} 的区别是本功能的关键：killProcess 只杀进程，应用随时会被
+     * 广播、bindService 或 ContentProvider 访问重新拉起；forceStopPackage 之后应用必须
+     * 由用户手动启动才能再次运行。「划掉最近任务即彻底退出」依赖的正是后者。
+     */
+    public abstract void forceStopPackage(String packageName, int userId, String reason);
+
     /**
      * Returns {@code true} if {@code uid} is running an activity from {@code packageName}.
      */
diff --git a/core/java/android/content/pm/IPackageManager.aidl b/core/java/android/content/pm/IPackageManager.aidl
index 3e389b9e6..f80b99924 100644
--- a/core/java/android/content/pm/IPackageManager.aidl
+++ b/core/java/android/content/pm/IPackageManager.aidl
@@ -605,6 +605,17 @@ interface IPackageManager {
     boolean performDexOptSecondary(String packageName,
             String targetCompilerFilter, boolean force);
 
+    /**
+     * 查询某个包主 dex 在主 ABI 上当前的编译等级（"verify" / "speed-profile" / "speed" …）
+     * 与编译原因。返回 "<filter>|<reason>"，查不到返回 null。
+     *
+     * 【本项目】给设置里的「应用预编译」页面读状态用。触发编译本来就能走
+     * performDexOptMode（uid=system 可过权限检查），但状态只有 system_server
+     * 内部的 ArtManagerLocal 拿得到，所以补这一个。
+     * 权限检查与 performDexOptMode 一致：isSystemOrRootOrShell。
+     */
+    String getDexOptCompilerFilter(String packageName);
+
     @EnforcePermission("MOUNT_UNMOUNT_FILESYSTEMS")
     int getMoveStatus(int moveId);
 
