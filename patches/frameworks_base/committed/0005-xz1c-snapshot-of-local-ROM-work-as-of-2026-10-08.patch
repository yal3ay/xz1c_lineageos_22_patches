+     * 这里只做必须持 mGlobalLock 的判定，其余放到异步的
+     * {@link #maybeForceStopAfterTaskRemoved} 里，避免锁顺序颠倒。
+     */
+    private String getSwipeAwayForceStopTarget(@NonNull Task task) {
+        if (!mSwipeAwayForceStop) {
+            return null;
+        }
+        final Intent baseIntent = task.getBaseIntent();
+        if (baseIntent == null || baseIntent.getComponent() == null) {
+            return null;
+        }
+        final String pkg = baseIntent.getComponent().getPackageName();
+        if (pkg == null) {
+            return null;
+        }
+        // 同一应用还有别的任务开着，说明只是关掉其中一个窗口，不代表要退出整个应用。
+        final int removedTaskId = task.mTaskId;
+        final boolean[] hasOtherTask = new boolean[1];
+        mRootWindowContainer.forAllLeafTasks((Consumer<Task>) t -> {
+            if (hasOtherTask[0] || t.mTaskId == removedTaskId) {
+                return;
+            }
+            final Intent bi = t.getBaseIntent();
+            if (bi != null && bi.getComponent() != null
+                    && pkg.equals(bi.getComponent().getPackageName())) {
+                hasOtherTask[0] = true;
+            }
+        }, true /* traverseTopToBottom */);
+        return hasOtherTask[0] ? null : pkg;
+    }
+
+    /**
+     * 「划掉最近任务即彻底退出」的收尾。
+     *
+     * AOSP 在移除任务时只是 kill 进程，应用随时会被广播 / bindService /
+     * ContentProvider 访问重新拉起 —— 这正是「滑掉了还在后台」的根源。
+     * forceStopPackage 会把应用置为 FLAG_STOPPED，之后必须用户手动点开才能运行。
+     *
+     * 豁免规则刻意复用系统已有概念，不另造一套名单：
+     *   1. 电池设置里标为「无限制」(在电源豁免名单里) —— 微信一类靠它保留后台通知
+     *   2. 仍有前台服务在跑 —— 正在放音乐 / 导航 / 录音
+     *   3. 系统应用与 persistent 应用 —— 强停会出事
+     *   4. 当前输入法、当前桌面
+     *   5. 该应用还有别的任务没关（在 getSwipeAwayForceStopTarget 里已判过）
+     */
+    private void maybeForceStopAfterTaskRemoved(String pkg, int userId) {
+        if (isExemptFromForceStop(pkg, userId)) {
+            return;
+        }
+        try {
+            mAmInternal.forceStopPackage(pkg, userId, "swipe-away-force-stop");
+        } catch (Exception e) {
+            Slog.w(TAG, "force stop after task removed failed: " + pkg, e);
+        }
+    }
+
+    /**
+     * 返回 true 表示这个应用**不该**被强制停止。「划掉即退出」和「后台超时清理」
+     * 两个触发点共用这一套判定，避免两边规则走偏。
+     *
+     * 豁免规则刻意复用系统已有概念，不另造一套名单：
+     *   1. 电池设置里标为「无限制」(在电源豁免名单里) —— 微信一类靠它保留后台通知
+     *   2. 仍有前台服务在跑 —— 正在放音乐 / 导航 / 录音
+     *   3. 系统应用与 persistent 应用 —— 强停会出事
+     *   4. 当前输入法、当前桌面
+     *
+     * 判定过程中出任何异常一律当作豁免：判不了就别动它，宁可少杀不可错杀。
+     */
+    private boolean isExemptFromForceStop(String pkg, int userId) {
+        try {
+            final PackageManagerInternal pmInternal;
+            synchronized (mGlobalLock) {
+                pmInternal = getPackageManagerInternalLocked();
+            }
+            final ApplicationInfo ai = pmInternal.getApplicationInfo(
+                    pkg, 0 /* flags */, Process.SYSTEM_UID, userId);
+            if (ai == null) {
+                return true;
+            }
+            if ((ai.flags & (ApplicationInfo.FLAG_SYSTEM | ApplicationInfo.FLAG_PERSISTENT)) != 0) {
+                return true;
+            }
+            final PowerExemptionManager pem =
+                    mContext.getSystemService(PowerExemptionManager.class);
+            if (pem != null && pem.isAllowListed(pkg, false /* includingIdle */)) {
+                return true;
+            }
+            if (mAmInternal.getUidProcessState(ai.uid)
+                    <= ActivityManager.PROCESS_STATE_FOREGROUND_SERVICE) {
+                return true;
+            }
+            final String ime = Settings.Secure.getStringForUser(mContext.getContentResolver(),
+                    Settings.Secure.DEFAULT_INPUT_METHOD, userId);
+            if (ime != null) {
+                final ComponentName imeCn = ComponentName.unflattenFromString(ime);
+                if (imeCn != null && pkg.equals(imeCn.getPackageName())) {
+                    return true;
+                }
+            }
+            final ComponentName home = pmInternal.getDefaultHomeActivity(userId);
+            if (home != null && pkg.equals(home.getPackageName())) {
+                return true;
+            }
+            return false;
+        } catch (Exception e) {
+            Slog.w(TAG, "force-stop exemption check failed: " + pkg, e);
+            return true;
+        }
+    }
+
+    private void updateBgForceStopTimeout() {
+        int min = 0;
+        try {
+            min = LineageSettings.System.getIntForUser(mContext.getContentResolver(),
+                    LineageSettings.System.BG_FORCE_STOP_TIMEOUT, 0, UserHandle.USER_CURRENT);
+        } catch (Exception e) {
+            Slog.w(TAG, "read BG_FORCE_STOP_TIMEOUT failed", e);
+        }
+        mBgForceStopTimeoutMin = min;
+        int mode = 0;
+        boolean trim = false;
+        try {
+            mode = LineageSettings.System.getIntForUser(mContext.getContentResolver(),
+                    LineageSettings.System.BG_FORCE_STOP_MODE, 0, UserHandle.USER_CURRENT);
+            trim = LineageSettings.System.getIntForUser(mContext.getContentResolver(),
+                    LineageSettings.System.BG_TRIM_CACHED_PROCS, 0, UserHandle.USER_CURRENT) != 0;
+        } catch (Exception e) {
+            Slog.w(TAG, "read bg force stop mode failed", e);
+        }
+        mBgForceStopMode = mode;
+        mBgTrimCachedProcs = trim;
+        // 计时表只在后台线程碰，重排也放到那条线程上，避免和巡检竞争。
+        mBgSweepHandler.removeCallbacks(mBgSweepRunnable);
+        mBgSweepHandler.post(() -> {
+            mBgSince.clear();
+            if (mBgForceStopTimeoutMin > 0) {
+                mBgSweepHandler.postDelayed(mBgSweepRunnable, BG_SWEEP_INTERVAL_MS);
+            }
+        });
+    }
+
+    /**
+     * 每分钟巡检一次：应用进入后台超过设定时长、且不在豁免范围内，就强制停止。
+     *
+     * 只靠「划掉最近任务」管不到按 Home 键离开或直接切走的应用，这条补上那部分，
+     * 效果对齐第三方后台管控工具。判定标准是进程重要度：比「可感知」
+     * (IMPORTANCE_PERCEPTIBLE) 更重要的一律不碰 —— 前台、前台服务、正在播放的
+     * 都在这条线以上。
+     */
+    private void sweepBackgroundApps() {
+        final int timeoutMin = mBgForceStopTimeoutMin;
+        if (timeoutMin <= 0) {
+            return;
+        }
+        final boolean killOnly = mBgForceStopMode == 1;
+        final boolean trimCached = mBgTrimCachedProcs;
+        final long now = SystemClock.elapsedRealtime();
+        final long limitMs = timeoutMin * 60_000L;
+        try {
+            final List<ActivityManager.RunningAppProcessInfo> procs =
+                    ActivityManager.getService().getRunningAppProcesses();
+            if (procs == null) {
+                return;
+            }
+            final ArraySet<String> seen = new ArraySet<>();
+            for (ActivityManager.RunningAppProcessInfo p : procs) {
+                if (p.pkgList == null || p.processName == null) {
+                    continue;
+                }
+                final int userId = UserHandle.getUserId(p.uid);
+                final String key = userId + "/" + p.processName;
+                seen.add(key);
+
+                // 比「可感知」更重要的一律不碰：前台、前台服务、正在播放的都在这条线以上。
+                if (p.importance
+                        <= ActivityManager.RunningAppProcessInfo.IMPORTANCE_PERCEPTIBLE) {
+                    mBgSince.remove(key);
+                    continue;
+                }
+                final Long since = mBgSince.get(key);
+                if (since == null) {
+                    mBgSince.put(key, now);
+                    continue;
+                }
+                if (now - since < limitMs) {
+                    continue;
+                }
+                final long bgMin = (now - since) / 60_000L;
+
+                // 一个进程可能同时属于多个包（共享 uid），取第一个不豁免的作为处理对象。
+                String victimPkg = null;
+                for (String pkg : p.pkgList) {
+                    if (!isExemptFromForceStop(pkg, userId)) {
+                        victimPkg = pkg;
+                        break;
+                    }
+                }
+
+                if (victimPkg == null) {
+                    // 整个进程都属于豁免应用（例如微信设了「无限制」）。
+                    // 默认不动它；但若开了闲置进程清理，且这个进程已经是 CACHED
+                    // （纯缓存、没在做事，典型如微信小程序 :appbrand），就单独杀掉它。
+                    // 跑着服务的进程（如 :push）重要度高于 CACHED，不会被选中，
+                    // 所以推送不受影响。杀进程不置停止标志，应用要用时会自己拉回来。
+                    if (trimCached && p.importance
+                            >= ActivityManager.RunningAppProcessInfo.IMPORTANCE_CACHED) {
+                        mBgSince.remove(key);
+                        Slog.i(TAG, "bg trim cached proc: " + p.processName + " u" + userId
+                                + " after " + bgMin + "min");
+                        mAmInternal.killProcess(p.processName, p.uid, "bg-trim-cached-proc");
+                    } else {
+                        // 豁免的重新计时，免得每分钟都把它判一遍
+                        mBgSince.put(key, now);
+                    }
+                    continue;
+                }
+
+                mBgSince.remove(key);
+                if (killOnly) {
+                    // 只杀进程、不置停止标志：应用不再占内存，但 FCM 推送到达时
+                    // 系统仍能把它唤醒。即时通讯类应用适合这一档。
+                    Slog.i(TAG, "bg timeout kill proc: " + p.processName + " u" + userId
+                            + " after " + bgMin + "min");
+                    mAmInternal.killProcess(p.processName, p.uid, "bg-timeout-kill-proc");
+                } else {
+                    Slog.i(TAG, "bg timeout force stop: " + victimPkg + " u" + userId
+                            + " after " + bgMin + "min");
+                    mAmInternal.forceStopPackage(victimPkg, userId, "bg-timeout-force-stop");
+                }
+            }
+            // 已经不在运行的，清掉计时，免得表无限增长
+            for (int i = mBgSince.size() - 1; i >= 0; i--) {
+                if (!seen.contains(mBgSince.keyAt(i))) {
+                    mBgSince.removeAt(i);
+                }
+            }
+        } catch (Exception e) {
+            Slog.w(TAG, "background sweep failed", e);
+        }
     }
 
