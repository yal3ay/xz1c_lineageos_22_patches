+/**
+ * 充电控制快捷开关。
+ *
+ * 【它控制什么】LineageHealth 的充电控制总开关（{@code HealthInterface#setEnabled}），
+ * 和「设置 → 电池 → 充电控制」里那个开关是同一个。关掉即恢复正常充满。
+ *
+ * 【副标题显示什么】开启时显示当前模式与阈值，例如「限制 · 80%」。
+ * 这一条很重要：只显示"开/关"的话，用户看不出到底限到多少，
+ * 而这正是他最需要确认的信息（本机实测遇到过"电量 96% 却显示未充电"，
+ * 原因就是上限设成了 80%，光看开关状态根本查不出来）。
+ *
+ * 【可用性】{@code isChargingControlSupported()} 为 false 时磁贴不出现 ——
+ * 不是所有设备的 HAL 都支持限充，列出来点了没反应更糟。
+ */
+public class ChargingControlTile extends QSTileImpl<BooleanState> {
+
+    public static final String TILE_SPEC = "charging_control";
+
+    private final Icon mIcon = ResourceIcon.get(R.drawable.ic_charging_control);
+
+    /** 长按直接进入 LineageOS 充电控制设置。 */
+    private static final Intent BATTERY_SETTINGS =
+            new Intent("org.lineageos.lineageparts.CHARGING_CONTROL_SETTINGS")
+                    .setPackage("org.lineageos.lineageparts");
+
+    private final HealthInterface mHealth;
+
+    @Inject
+    public ChargingControlTile(
+            QSHost host,
+            QsEventLogger uiEventLogger,
+            @Background Looper backgroundLooper,
+            @Main Handler mainHandler,
+            FalsingManager falsingManager,
+            MetricsLogger metricsLogger,
+            StatusBarStateController statusBarStateController,
+            ActivityStarter activityStarter,
+            QSLogger qsLogger
+    ) {
+        super(host, uiEventLogger, backgroundLooper, mainHandler, falsingManager, metricsLogger,
+                statusBarStateController, activityStarter, qsLogger);
+        mHealth = HealthInterface.getInstance(mContext);
+    }
+
+    @Override
+    public BooleanState newTileState() {
+        return new BooleanState();
+    }
+
+    @Override
+    public boolean isAvailable() {
+        try {
+            return mHealth != null && mHealth.isChargingControlSupported();
+        } catch (Exception e) {
+            // 服务没起来时宁可不显示，也不要显示一个点了没反应的磁贴。
+            return false;
+        }
+    }
+
+    @Override
+    protected void handleClick(@Nullable Expandable expandable) {
+        try {
+            final boolean enabled = mHealth.getEnabled();
+            if (!mHealth.setEnabled(!enabled)) {
+                Log.w(TAG, "充电控制服务拒绝切换状态");
+            }
+        } catch (Exception e) {
+            Log.w(TAG, "切换充电控制失败", e);
+        }
+        refreshState();
+    }
+
+    @Override
+    public Intent getLongClickIntent() {
+        return BATTERY_SETTINGS;
+    }
+
+    @Override
+    protected void handleUpdateState(BooleanState state, Object arg) {
+        boolean enabled = false;
+        int mode = HealthInterface.MODE_NONE;
+        int limit = 0;
+        try {
+            enabled = mHealth.getEnabled();
+            mode = mHealth.getMode();
+            limit = mHealth.getLimit();
+        } catch (Exception e) {
+            Log.w(TAG, "读取充电控制状态失败", e);
+        }
+
+        state.value = enabled;
+        state.icon = mIcon;
+        state.label = getTileLabel();
+        if (enabled) {
+            state.state = Tile.STATE_ACTIVE;
+            state.secondaryLabel = describeMode(mode, limit);
+            state.contentDescription = mContext.getString(
+                    R.string.accessibility_quick_settings_charging_control_on);
+        } else {
+            state.state = Tile.STATE_INACTIVE;
+            state.secondaryLabel = null;
+            state.contentDescription = mContext.getString(
+                    R.string.accessibility_quick_settings_charging_control_off);
+        }
+    }
+
+    /** 副标题：模式 + 阈值。LIMIT 模式才有阈值可说，其余模式只说模式名。 */
+    private String describeMode(int mode, int limit) {
+        switch (mode) {
+            case HealthInterface.MODE_LIMIT:
+                return mContext.getString(
+                        R.string.quick_settings_charging_control_limit, limit);
+            case HealthInterface.MODE_AUTO:
+                return mContext.getString(R.string.quick_settings_charging_control_auto);
+            case HealthInterface.MODE_MANUAL:
+                return mContext.getString(R.string.quick_settings_charging_control_manual);
+            default:
+                return null;
+        }
+    }
+
+    @Override
+    public CharSequence getTileLabel() {
+        return mContext.getString(R.string.quick_settings_charging_control);
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return VIEW_UNKNOWN;
+    }
+}
