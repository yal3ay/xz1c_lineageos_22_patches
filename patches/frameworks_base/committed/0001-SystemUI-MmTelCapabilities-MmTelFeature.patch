+
+    // ==================== 4G 高清通话（VoLTE）状态图标 ====================
+    //
+    // 数据源用 IMS 注册回调，而不是「设置里的 VoLTE 开关」——
+    // 开关只表示用户意愿，注册成功才代表真的能打高清通话。
+    // 只在 TRANSPORT_TYPE_WWAN 上显示；走 WLAN 注册的是 VoWiFi，不属于 4G 高清通话。
+
+    // 用 MmTel「语音能力」而不是「IMS 注册状态」作为判据：
+    //   * 注册状态在关掉 4G 高清通话开关后依然为 true（IMS 仍为短信等业务保持注册），
+    //     所以图标不会消失 —— 2026-09-10 实测到的问题。
+    //   * 语音能力（CAPABILITY_TYPE_VOICE）同时反映用户开关与注册结果，
+    //     即「此刻能不能打高清通话」，正是图标该表达的含义。
+    private final ImsMmTelManager.CapabilityCallback mVolteCapabilityCallback =
+            new ImsMmTelManager.CapabilityCallback() {
+                @Override
+                public void onCapabilitiesStatusChanged(MmTelFeature.MmTelCapabilities capabilities) {
+                    setVolteAvailable(capabilities != null
+                            && capabilities.isCapable(MmTelFeature.MmTelCapabilities.CAPABILITY_TYPE_VOICE));
+                }
+            };
+
+    private void registerVolteListeners() {
+        SubscriptionManager sm = mContext.getSystemService(SubscriptionManager.class);
+        if (sm != null) {
+            // 换卡/默认语音卡变化时要重新挂回调
+            sm.addOnSubscriptionsChangedListener(mUiBgExecutor,
+                    new SubscriptionManager.OnSubscriptionsChangedListener() {
+                        @Override
+                        public void onSubscriptionsChanged() {
+                            updateVolteSubscription();
+                        }
+                    });
+        }
+        mUiBgExecutor.execute(this::updateVolteSubscription);
+    }
+
+    private void updateVolteSubscription() {
+        final int subId = SubscriptionManager.getDefaultVoiceSubscriptionId();
+        if (subId == mVolteSubId && mVolteImsManager != null) {
+            return;
+        }
+        if (mVolteImsManager != null) {
+            try {
+                mVolteImsManager.unregisterMmTelCapabilityCallback(mVolteCapabilityCallback);
+            } catch (Exception e) {
+                Log.w(TAG, "unregisterMmTelCapabilityCallback failed", e);
+            }
+            mVolteImsManager = null;
+        }
+        mVolteSubId = subId;
+        setVolteAvailable(false);
+        if (!SubscriptionManager.isValidSubscriptionId(subId)) {
+            return;
+        }
+        try {
+            ImsMmTelManager manager = ImsMmTelManager.createForSubscriptionId(subId);
+            manager.registerMmTelCapabilityCallback(mUiBgExecutor, mVolteCapabilityCallback);
+            mVolteImsManager = manager;
+        } catch (ImsException | IllegalArgumentException | UnsupportedOperationException e) {
+            // 机器不支持 IMS 或此刻拿不到，图标保持隐藏即可
+            Log.w(TAG, "registerMmTelCapabilityCallback failed for subId=" + subId, e);
+            mVolteImsManager = null;
+        }
+    }
+
+    private void setVolteAvailable(boolean available) {
+        if (mVolteAvailable == available) {
+            return;
+        }
+        mVolteAvailable = available;
+        mMainExecutor.execute(() -> mIconController.setIconVisibility(mSlotVolte, available));
+    }
+
 }
