+package com.android.systemui.qs.tiles;
+
+import static com.android.internal.logging.MetricsLogger.VIEW_UNKNOWN;
+
+import android.content.Intent;
+import android.os.Handler;
+import android.os.Looper;
+import android.provider.Settings;
+import android.service.quicksettings.Tile;
+import android.telephony.SubscriptionManager;
+import android.telephony.ims.ImsMmTelManager;
+
+import androidx.annotation.Nullable;
+
+import com.android.internal.logging.MetricsLogger;
+import com.android.systemui.animation.Expandable;
+import com.android.systemui.dagger.qualifiers.Background;
+import com.android.systemui.dagger.qualifiers.Main;
+import com.android.systemui.plugins.ActivityStarter;
+import com.android.systemui.plugins.FalsingManager;
+import com.android.systemui.plugins.qs.QSTile.BooleanState;
+import com.android.systemui.plugins.statusbar.StatusBarStateController;
+import com.android.systemui.qs.QSHost;
+import com.android.systemui.qs.QsEventLogger;
+import com.android.systemui.qs.logging.QSLogger;
+import com.android.systemui.qs.tileimpl.QSTileImpl;
+import com.android.systemui.res.R;
+
+import javax.inject.Inject;
+
+/**
+ * 快捷设置磁贴：4G 高清通话（VoLTE）开关。
+ *
+ * 走的是框架的 ImsMmTelManager.setAdvancedCallingSettingEnabled()，
+ * 也就是设置里「4G 高清通话」那个开关背后的同一个接口 ——
+ * 只改 Android 侧的用户偏好，【不会去动 modem 配置、不碰 EFS】。
+ * （Sony 那套 CustomizationSelector 的自动切换会清空 EFS，已在本 ROM 里禁用。）
+ */
+public class VolteTile extends QSTileImpl<BooleanState> {
+
+    public static final String TILE_SPEC = "volte";
+
+    private final Icon mIcon = ResourceIcon.get(R.drawable.ic_qs_volte);
+
+    @Inject
+    public VolteTile(
+            QSHost host,
+            QsEventLogger uiEventLogger,
+            @Background Looper backgroundLooper,
+            @Main Handler mainHandler,
+            FalsingManager falsingManager,
+            MetricsLogger metricsLogger,
+            StatusBarStateController statusBarStateController,
+            ActivityStarter activityStarter,
+            QSLogger qsLogger
+    ) {
+        super(host, uiEventLogger, backgroundLooper, mainHandler, falsingManager, metricsLogger,
+                statusBarStateController, activityStarter, qsLogger);
+    }
+
+    @Override
+    public BooleanState newTileState() {
+        return new BooleanState();
+    }
+
+    @Override
+    public void handleSetListening(boolean listening) {
+    }
+
+    /** 取默认语音卡的 ImsMmTelManager，拿不到就返回 null（磁贴显示为不可用）。 */
+    @Nullable
+    private ImsMmTelManager getMmTelManager() {
+        int subId = SubscriptionManager.getDefaultVoiceSubscriptionId();
+        if (!SubscriptionManager.isValidSubscriptionId(subId)) {
+            return null;
+        }
+        try {
+            return ImsMmTelManager.createForSubscriptionId(subId);
+        } catch (Exception e) {
+            return null;
+        }
+    }
+
+    @Override
+    protected void handleClick(@Nullable Expandable expandable) {
+        ImsMmTelManager manager = getMmTelManager();
+        if (manager == null) {
+            return;
+        }
+        try {
+            boolean current = manager.isAdvancedCallingSettingEnabled();
+            manager.setAdvancedCallingSettingEnabled(!current);
+        } catch (Exception e) {
+            // IMS 不可用时这两个调用都会抛，忽略即可，状态刷新会显示为不可用
+        }
+        refreshState();
+    }
+
+    @Override
+    public Intent getLongClickIntent() {
+        // 长按进「移动网络」设置页，那里有同一个开关
+        return new Intent(Settings.ACTION_NETWORK_OPERATOR_SETTINGS);
+    }
+
+    @Override
+    public CharSequence getTileLabel() {
+        return mContext.getString(R.string.quick_settings_volte_label);
+    }
+
+    @Override
+    protected void handleUpdateState(BooleanState state, Object arg) {
+        state.label = getTileLabel();
+        state.icon = mIcon;
+
+        ImsMmTelManager manager = getMmTelManager();
+        if (manager == null) {
+            state.value = false;
+            state.state = Tile.STATE_UNAVAILABLE;
+            state.secondaryLabel = mContext.getString(R.string.quick_settings_volte_unavailable);
+            state.contentDescription = state.label;
+            return;
+        }
+
+        boolean enabled;
+        try {
+            enabled = manager.isAdvancedCallingSettingEnabled();
+        } catch (Exception e) {
+            state.value = false;
+            state.state = Tile.STATE_UNAVAILABLE;
+            state.secondaryLabel = mContext.getString(R.string.quick_settings_volte_unavailable);
+            state.contentDescription = state.label;
+            return;
+        }
+
+        state.value = enabled;
+        state.state = enabled ? Tile.STATE_ACTIVE : Tile.STATE_INACTIVE;
+        state.secondaryLabel = null;
+        state.contentDescription = state.label;
+    }
+
+    @Override
+    public int getMetricsCategory() {
+        return VIEW_UNKNOWN;
+    }
+}
