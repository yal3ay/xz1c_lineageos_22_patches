+    private static CharSequence format(String[] f, long age, ContentResolver cr) {
+        Locale l = Locale.getDefault();
+        // labels follow the system language (user, 2026-10-11)
+        boolean zh = "zh".equals(l.getLanguage());
+        boolean t = traditional(l);
+        StringBuilder sb = new StringBuilder();
+        int icon = 0;
+        try {
+            icon = (int) Double.parseDouble(f[0]);
+        } catch (NumberFormatException ignored) {
+        }
+        String e = emoji(icon);
+        // condition as an icon only, no weather text (user, 2026-10-11)
+        if (!e.isEmpty()) sb.append(e).append(' ');
+        // feels-like temperature when System Manager provides it, else the measured one
+        String feels = f.length > 7 && enabled(cr, SETTING_FEELS) ? f[7] : "";
+        if (!feels.isEmpty()) {
+            sb.append(zh ? (t ? "體感" : "体感") : "Feel ")
+                    .append(Math.round(Double.parseDouble(feels))).append('°');
+        } else if (!f[2].isEmpty()) {
+            sb.append(Math.round(Double.parseDouble(f[2]))).append('°');
+        }
+        if (!f[3].isEmpty() && enabled(cr, SETTING_HUMIDITY)) {
+            // humidity: droplet + value only, no label (keeps the line short)
+            sb.append(" · \uD83D\uDCA7").append(Math.round(Double.parseDouble(f[3]))).append('%');
+        }
+        if (f.length > 8 && !f[8].isEmpty() && enabled(cr, SETTING_WIND)) {
+            // wind speed (user, 2026-10-11): m/s with one decimal in Chinese, km/h otherwise;
+            // System Manager stores km/h
+            double kmh = Double.parseDouble(f[8]);
+            // windsock icon by strength (user, 2026-10-15)
+            sb.append(" · ").append((char) (WX_WIND + windLevel(kmh)));
+            if (zh) {
+                sb.append(String.format(Locale.ROOT, "%.1f", kmh / 3.6)).append("m/s");
+            } else {
+                sb.append(Math.round(kmh)).append("km/h");
+            }
+        }
+        if (f.length > 9 && !f[9].isEmpty() && enabled(cr, SETTING_UV)) {
+            // sun icon coloured by WHO UV band instead of "UV" letters (user, 2026-10-15)
+            long uv = Math.round(Double.parseDouble(f[9]));
+            sb.append(" · ").append((char) (WX_UV + uvLevel(uv))).append(uv);
+        }
+        if (!f[4].isEmpty() && enabled(cr, SETTING_AQI)) {
+            // AQI: leaf icon coloured by band, value stays white (user, 2026-10-15)
+            sb.append(" · ");
+            int lv = aqiLevel(f[4]);
+            if (lv >= 0) sb.append((char) (WX_AQI + lv));
+            sb.append(f[4]);
+        }
+        if (age > STALE_MS) {
+            long hours = age / 3600000L;
+            sb.append(" · ").append(zh ? hours + (t ? " 小時前" : " 小时前") : hours + "h ago");
+        }
+        return sb.toString().trim();
+    }
