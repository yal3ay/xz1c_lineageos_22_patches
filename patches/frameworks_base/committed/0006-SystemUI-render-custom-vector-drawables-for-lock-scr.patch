+    /** 0 calm, 1 breeze, 2 strong, 3 gale (km/h; 3.3 / 8 / 14 m/s). */
+    private static int windLevel(double kmh) {
+        if (kmh < 12) return 0;
+        if (kmh < 29) return 1;
+        if (kmh < 50) return 2;
+        return 3;
+    }
+
+    /** WHO UV bands: low, moderate, high, very high, extreme. */
+    private static int uvLevel(long uv) {
+        if (uv <= 2) return 0;
+        if (uv <= 5) return 1;
+        if (uv <= 7) return 2;
+        if (uv <= 10) return 3;
+        return 4;
+    }
+
+    /** AQI band 0..5 (China HJ 633 / US EPA share the bands; EU EAQI by level name), -1 unknown. */
+    private static int aqiLevel(String value) {
+        int eu = eaqiLevel(value);
+        if (eu >= 0) return eu;
+        int aqi;
+        try {
+            aqi = (int) Math.round(Double.parseDouble(value));
+        } catch (NumberFormatException e) {
+            return -1;
+        }
+        if (aqi <= 50) return 0;    // good
+        if (aqi <= 100) return 1;   // moderate
+        if (aqi <= 150) return 2;   // unhealthy for sensitive groups
+        if (aqi <= 200) return 3;   // unhealthy
+        if (aqi <= 300) return 4;   // very unhealthy
+        return 5;                   // hazardous
+    }
+
+    // EU EAQI: Xperia Weather writes the level name (en / zh-Hans / zh-Hant) instead of an index.
+    private static final String[][] EAQI_NAMES = {
+        { "good", "好" }, { "fair", "尚可" }, { "moderate", "中等" },
+        { "poor", "差" }, { "very poor", "很差" }, { "extremely poor", "极差", "極差" },
+    };
+
+    /** 0..5 for an EU EAQI level name, -1 for anything else (numbers, US/China levels). */
+    private static int eaqiLevel(String value) {
+        String v = value.trim().toLowerCase(Locale.ROOT);
+        for (int i = 0; i < EAQI_NAMES.length; i++) {
+            for (String name : EAQI_NAMES[i]) {
+                if (v.equals(name)) return i;
+            }
+        }
+        return -1;
+    }
