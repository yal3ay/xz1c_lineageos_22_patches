+    /** ChineseCalendar.YEAR is the year in the 60-year cycle, 1 = 甲子. */
+    private static String ganZhi(int cycleYear) {
+        int i = ((cycleYear - 1) % 60 + 60) % 60;
+        return "" + STEMS.charAt(i % 10) + BRANCHES.charAt(i % 12);
+    }
+
+    private static String dayName(int d) {
+        if (d == 10) return "初十";
+        if (d == 20) return "二十";
+        if (d == 30) return "三十";
+        if (d < 10) return "初" + DIGITS[d];
+        if (d < 20) return "十" + DIGITS[d - 10];
+        if (d < 30) return "廿" + DIGITS[d - 20];
+        return "三十";
+    }
+
+    private static String solarTerm(Calendar c, boolean t) {
+        int year = c.get(Calendar.YEAR);
+        if (year < 2001 || year > 2099) return null;
+        int month = c.get(Calendar.MONTH); // 0-based; terms 2m and 2m+1 fall in this month
+        int y = year % 100;
+        for (int i = month * 2; i <= month * 2 + 1; i++) {
+            int leapYears = i < 4 ? (y - 1) / 4 : y / 4;
+            int day = (int) Math.floor(y * 0.2422 + TERM_C[i]) - leapYears;
+            if (day == c.get(Calendar.DAY_OF_MONTH)) return (t ? TERMS_T : TERMS_S)[i];
+        }
+        return null;
+    }
+
+    private static String festival(int month, int day, boolean leap, boolean eve, boolean t) {
+        if (eve) return t ? "除夕" : "除夕";
+        if (leap) return null;
+        switch (month * 100 + day) {
+            case 101: return t ? "春節" : "春节";
+            case 115: return "元宵";
+            case 505: return t ? "端午" : "端午";
+            case 707: return "七夕";
+            case 715: return "中元";
+            case 815: return "中秋";
+            case 909: return t ? "重陽" : "重阳";
+            case 1208: return t ? "臘八" : "腊八";
+            default: return null;
+        }
+    }
