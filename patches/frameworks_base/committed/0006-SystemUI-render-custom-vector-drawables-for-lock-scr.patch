+    private static String emoji(int icon) {
+        // AccuWeather icon codes
+        if (icon == 1 || icon == 2) return "☀️";
+        if (icon >= 3 && icon <= 5) return "🌤️";
+        if (icon >= 6 && icon <= 8) return "☁️";
+        if (icon == 11) return "☁️"; // 🌫️ looks like a blank tile at this size
+        if (icon >= 12 && icon <= 14) return "🌦️";
+        if (icon >= 15 && icon <= 17) return "⛈️";
+        if (icon == 18 || icon == 26) return "🌧️";
+        if ((icon >= 19 && icon <= 25) || icon == 29) return "❄️";
+        if (icon == 30) return "🌡️";
+        if (icon == 31) return "🥶";
+        if (icon == 32) return "💨";
+        if (icon == 33 || icon == 34) return "🌙";
+        if (icon >= 35 && icon <= 38) return "☁️";
+        if (icon >= 39 && icon <= 42) return "🌧️";
+        if (icon >= 43 && icon <= 44) return "❄️";
+        return "";
+    }
