+    /** " · 丙午八月廿九 · 寒露", or "" when turned off. */
+    static String lunarSuffix(ContentResolver cr, Date now) {
+        if (!enabled(cr, SETTING_LUNAR)) return "";
+        try {
+            boolean t = traditional(Locale.getDefault());
+            ChineseCalendar cc = new ChineseCalendar(now);
+            int month = cc.get(ChineseCalendar.MONTH) + 1;
+            int day = cc.get(ChineseCalendar.DAY_OF_MONTH);
+            boolean leap = cc.get(ChineseCalendar.IS_LEAP_MONTH) == 1;
+            ChineseCalendar next = new ChineseCalendar(new Date(now.getTime() + 86400000L));
+            boolean eve = next.get(ChineseCalendar.MONTH) == 0
+                    && next.get(ChineseCalendar.DAY_OF_MONTH) == 1
+                    && next.get(ChineseCalendar.IS_LEAP_MONTH) == 0;
+            StringBuilder sb = new StringBuilder(" · ");
+            // no "农历" prefix, but the sexagenary year first (user, 2026-10-11): 丙午九月初二
+            sb.append(ganZhi(cc.get(ChineseCalendar.YEAR)))
+                    .append(leap ? (t ? "閏" : "闰") : "")
+                    .append((t ? MONTHS_T : MONTHS_S)[month - 1]).append("月").append(dayName(day));
+            Calendar g = Calendar.getInstance();
+            g.setTime(now);
