+            if (c >= '\uE120' && c <= '\uE125') return 9 + c - '\uE120';
+            return -1;
+        }
+
+        static CharSequence xz1cWeatherIcons(Context context, CharSequence text,
+                float textSize) {
+            if (text == null || context == null) return text;
+            android.text.SpannableStringBuilder out = null;
+            int size = Math.round(textSize * 1.15f);
+            for (int i = 0; i < text.length(); i++) {
+                int idx = xz1cIconIndex(text.charAt(i));
+                if (idx < 0) continue;
+                Drawable d = context.getDrawable(XZ1C_WX_ICONS[idx]);
+                if (d == null) continue;
+                d.setBounds(0, 0, size, size);
+                if (out == null) out = new android.text.SpannableStringBuilder(text);
+                out.setSpan(new android.text.style.ImageSpan(d,
+                                android.text.style.DynamicDrawableSpan.ALIGN_CENTER),
+                        i, i + 1, android.text.Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+            }
+            return out != null ? out : text;
+        }
