 package com.android.systemui.statusbar.pipeline.mobile.ui.view
 
 import android.content.Context
+import android.database.ContentObserver
+import android.os.Handler
+import android.os.Looper
+import android.telephony.SubscriptionManager
+import android.telephony.ims.ImsMmTelManager
 import android.util.AttributeSet
+import android.util.Log
+import android.view.View
 import android.view.LayoutInflater
 import android.widget.ImageView
+import java.util.concurrent.Executors
 import com.android.settingslib.flags.Flags.newStatusBarIcons
 import com.android.systemui.res.R
 import com.android.systemui.statusbar.StatusBarIconView.getVisibleStateString
@@ -35,6 +43,62 @@ class ModernStatusBarMobileView(
 
     var subId: Int = -1
 
+    // ==================== 4G 高清通话（VoLTE）指示 ====================
+    //
+    // 在 4G 右边显示 LTE 字样，连起来读就是「4G LTE」（AOSP 自带的
+    // ic_4g_lte_mobiledata 就是这个组合），显隐跟随「设置 → 4G 高清通话」开关。
+    //
+    // 判据用开关本身（isAdvancedCallingSettingEnabled），不是 IMS 注册状态：
+    // 关掉开关后 IMS 还要为短信等业务保持注册，注册状态依然是 true，字样不会消失。
+    //
+    // 为什么在 view 里自己监听、不走 view model：Android 15 的新 mobile 管线
+    // （MobileIconInteractor / MobileIconViewModel）里没有任何 IMS/VoLTE 数据流，
+    // 硬塞要一路改到 repository 层。开关变化通过
+    // SubscriptionManager.ADVANCED_CALLING_ENABLED_CONTENT_URI 观察 ——
+    // 这就是 setAdvancedCallingSettingEnabled() 真正写入的那张表，所以是即时的。
+
+    private val volteObserver =
+        object : ContentObserver(Handler(Looper.getMainLooper())) {
+            override fun onChange(selfChange: Boolean) {
+                refreshVolte()
+            }
+        }
+
+    private fun refreshVolte() {
+        val sub = subId
+        volteBgExecutor.execute {
+            val enabled =
+                try {
+                    SubscriptionManager.isValidSubscriptionId(sub) &&
+                        ImsMmTelManager.createForSubscriptionId(sub)
+                            .isAdvancedCallingSettingEnabled
+                } catch (e: RuntimeException) {
+                    // 机器不支持 IMS 或此刻取不到 —— 不显示即可
+                    Log.w(TAG, "读取 4G 高清通话开关失败 subId=$sub", e)
+                    false
+                }
+            post {
+                findViewById<ImageView>(R.id.mobile_volte)?.visibility =
+                    if (enabled) View.VISIBLE else View.GONE
+            }
+        }
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        context.contentResolver.registerContentObserver(
+            SubscriptionManager.ADVANCED_CALLING_ENABLED_CONTENT_URI,
+            /* notifyForDescendants = */ true,
+            volteObserver,
+        )
+        refreshVolte()
+    }
+
+    override fun onDetachedFromWindow() {
+        context.contentResolver.unregisterContentObserver(volteObserver)
+        super.onDetachedFromWindow()
+    }
+
     override fun toString(): String {
         return "ModernStatusBarMobileView(" +
             "slot='$slot', " +
@@ -46,6 +110,12 @@ class ModernStatusBarMobileView(
 
     companion object {
 
+        private const val TAG = "ModernStatusBarMobileView"
+
+        // 状态栏、锁屏、QS 头部会各自持有一个实例，读开关是 binder 调用，
+        // 共用一条后台线程，别每个 view 各起一条。
+        private val volteBgExecutor = Executors.newSingleThreadExecutor()
+
         /**
